        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/creators.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-RBNvo1WzZ4oRRq0W9+hknpT7T8If536DEMBg9hyq/4o=' 'sha256-ZtYn4xeqVJlR3lphpJdRVfrETZ7doQ8QRih8s1iFaaA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/consolidate-sweep", "schedule": "0 * * * *" },
    { "path": "/api/replica-erasure-sweep", "schedule": "*/10 * * * *" },
    { "path": "/api/replica-liveness-sweep", "schedule": "*/5 * * * *" },
    { "path": "/api/replica-identity-sweep", "schedule": "*/5 * * * *" },
    { "path": "/api/replica-face-session-sweep", "schedule": "*/5 * * * *" },
    { "path": "/api/replica-voice-identity-sweep", "schedule": "*/5 * * * *" },
    { "path": "/api/replica-model-build-sweep", "schedule": "*/5 * * * *" },
    { "path": "/api/channel-ingest-sweep", "schedule": "0 */6 * * *" },
    { "path": "/api/drift-watch-sweep", "schedule": "0 */6 * * *" },
    { "path": "/api/checkins-sweep", "schedule": "*/15 * * * *" },
    { "path": "/api/pulse-sweep", "schedule": "0 3 * * 1" },
    { "path": "/api/renewals-sweep", "schedule": "0 0 * * *" }
  ],
  "functions": {
    "api/room-card.js": {
      "excludeFiles": "node_modules/@napi-rs/canvas-linux-x64-musl/**"
    }
  }
}
