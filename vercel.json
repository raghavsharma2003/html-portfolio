        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-/QFwWOhJSa2tr/PjLLGMbQxjh3nmfbFi3c/J+zIVHQQ=' 'sha256-luCC5t2kaE3aN+MepxvMyEgcOnWw2gZdx99yHA6NqPs=' 'sha256-WKQqS2/DkpA42+8bSVWtw+Cs3iovFy+Kv6FDc5W0xn0='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
