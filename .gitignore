# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
api/_config.js

# agent working files belong in the session scratchpad, never in the repo
scratchpad/

# Vercel CLI link state (project/org ids, local only). The deploy target lives
# in the CLI's own config, not in the repo — committing it would pin every
# clone to one project.
.vercel/

# WS-CANDGEN smoke/run artifacts (evals/candidate/) — transcripts + manifests
# are regenerated data, not evidence like evals/archives/, and may carry
# Azure usage/cost numbers not meant for the repo.
evals/candidate/out/

# Browser-battery screenshot output. These batteries write a few hundred
# megapixels of PNG into whatever directory they are run from
# (evals/world-thread-browser.mjs, evals/gameplay-browser.mjs, and the
# --observe runs of both). The frames are EVIDENCE FOR ONE RUN, regenerated by
# the next one — unlike evals/archives/, which is kept on purpose — so they
# must never reach a commit by way of `git add -A`.
*-shots/
