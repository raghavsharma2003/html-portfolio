# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
__pycache__/
*.py[cod]

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
api/_config.js

# agent working files belong in the session scratchpad, never in the repo
scratchpad/

# Vercel CLI link state (project/org ids, local only). The deploy target lives
# in the CLI's own config, not in the repo — committing it would pin every
# clone to one project.
.vercel/

# WS-CANDGEN smoke/run artifacts (evals/candidate/) — transcripts + manifests
# are regenerated data, not evidence like evals/archives/, and may carry
# Azure usage/cost numbers not meant for the repo.
evals/candidate/out/

# Browser-battery screenshot output. These batteries write a few hundred
# megapixels of PNG into whatever directory they are run from
# (evals/world-thread-browser.mjs, evals/gameplay-browser.mjs, and the
# --observe runs of both). The frames are EVIDENCE FOR ONE RUN, regenerated by
# the next one — unlike evals/archives/, which is kept on purpose — so they
# must never reach a commit by way of `git add -A`.
*-shots/
evals/feltmem/out/
.vercel

# WS-SOUND's build directory. evals/sound.mjs re-bundles src/sound/ from the
# REAL source on every run (same discipline as evals/run.mjs: a frozen bundle
# passes forever while the source rots), writes its node stubs beside it, and
# writes a deliberately BROKEN copy for the in-call negative control. All of it
# is regenerated per run, and the broken copy in particular must never reach a
# commit — it is a build of this layer with the echo gate cut out.
evals/.sound/

# key pool + RCA labels (secrets — never commit)
api/keyring.json
api/google-keys.env

# Claude Code agent worktrees (harness-managed, never source)
.claude/worktrees/

# earbench (WS-V) run artifacts: stimulus WAVs, the listener-facing trial list,
# answer sheets, reports — and, crucially, THE ANSWER KEY, which carries the
# per-run blinding secret and the arm of every clip. Nothing in here belongs in
# a commit: the audio is a person's consented voice and a clone of it, and a
# committed key would unblind every future run of the same stimuli. The
# instrument is in the repo; its output is not.
earbench-out/
vyakti-local.env
api/_config.env
