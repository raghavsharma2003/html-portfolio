  ],
  "rollout": [
    {
      "stage": 0,
      "name": "truth_baseline",
      "writes_live_state": false,
      "exit_gate": "deployment call contract, signed remote GPU status, and current end-to-end canary are measured"
    },
    {
      "stage": 1,
      "name": "observation_shadow",
      "writes_live_state": false,
      "exit_gate": "speaker, transcript, expression, and event observations are calibrated on consented Hindi, Hinglish, and Indian English calls"
    },
    {
      "stage": 2,
      "name": "owner_visible_candidates",
      "writes_live_state": false,
      "exit_gate": "candidate precision and citation precision pass; accept, reject, defer, undo, and erase are complete"
    },
    {
      "stage": 3,
      "name": "approved_relational_memory",
      "writes_live_state": true,
      "exit_gate": "LongMemEval-style update, abstention, temporal, and dyad-isolation gates pass with rollback"
    },
    {
      "stage": 4,
      "name": "expression_aware_response",
      "writes_live_state": true,
      "exit_gate": "blinded human response-appropriateness improves without more certain inner-state claims or persona drift"
    },
    {
      "stage": 5,
      "name": "approved_voice_selection",
      "writes_live_state": true,
      "exit_gate": "exact-text blind voice pack improves owner likeness or naturalness without Hindi/Hinglish intelligibility regression"
    },
    {
      "stage": 6,
      "name": "bounded_full_duplex_trial",
      "writes_live_state": false,
      "exit_gate": "full-duplex beats cascade on interruption and naturalness while preserving persona, memory, protection, and Hindi quality"
    }
  ],
  "reversal_conditions": [
    {
      "decision": "no_hot_path_gradient_updates",
      "reverse_if": "a versioned per-owner adapter can train inside the latency budget and passes catastrophic-forgetting, owner-approval, provenance, rollback, and spend gates against candidate-only learning"
    },
    {
      "decision": "expression_is_ephemeral_observation",
      "reverse_if": "validated longitudinal, culture-specific evidence establishes a lawful durable construct that improves outcomes without inferring private internal state"
    },
    {
      "decision": "cascade_before_full_duplex",
