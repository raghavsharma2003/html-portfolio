{
  "$schema": "vyakti/continuous-human-clone-frontier/v1",
  "as_of": "2026-08-29",
  "claim_boundary": "This is a preregistered architecture and evaluation contract. It is not evidence that the production call, memory, expression, or voice systems pass these gates.",
  "scope": [
    "continuous_call_learning",
    "relational_memory",
    "stable_persona",
    "expression_observation",
    "controllable_cloned_voice",
    "runtime_status_truth"
  ],
  "hot_path": {
    "allowed_writes": [
      "immutable_call_event",
      "speaker_attributed_turn",
      "ephemeral_expression_observation",
      "derived_candidate"
    ],
    "forbidden_mutations": [
      "published_persona",
      "standing_relationship_state",
      "approved_fact",
      "active_voice_artifact",
      "model_weights"
    ],
    "warm_targets_ms": {
      "call_control_ready_p95": 2000,
      "final_turn_transcript_p95": 1500,
      "memory_evidence_p95": 350,
      "first_audio_after_turn_p95": 1500
    },
    "targets_are": "proposed_unmeasured"
  },
  "stages": [
    {
      "id": "capture",
      "phase": "hot",
      "order": 1,
      "inputs": ["consented_microphone_stream"],
      "outputs": ["immutable_call_event"],
      "write_policy": "append_only",
      "can_mutate_live_persona": false,
      "required_receipts": ["owner_user_id", "replica_id", "session_id", "participant_consent_scope", "source_sha256", "captured_at", "retention_policy"]
    },
    {
      "id": "perceive",
      "phase": "hot",
      "order": 2,
      "inputs": ["immutable_call_event"],
      "outputs": ["speaker_attributed_turn", "ephemeral_expression_observation"],
      "write_policy": "derived_append_only",
      "can_mutate_live_persona": false,
      "required_receipts": ["source_event_id", "model_commitment", "speaker_confidence", "transcript_confidence", "observed_at"]
    },
    {
      "id": "retrieve",
      "phase": "hot",
      "order": 3,
      "inputs": ["speaker_attributed_turn"],
      "outputs": ["source_cited_context_bundle"],
      "write_policy": "read_only",
      "can_mutate_live_persona": false,
      "required_receipts": ["owner_scope", "dyad_scope", "retrieval_query_sha256", "evidence_ids", "retriever_commitment"]
    },
    {
      "id": "respond",
      "phase": "hot",
      "order": 4,
      "inputs": ["speaker_attributed_turn", "ephemeral_expression_observation", "source_cited_context_bundle", "published_persona"],
      "outputs": ["protected_clone_turn"],
      "write_policy": "generation_ledger_only",
      "can_mutate_live_persona": false,
      "required_receipts": ["persona_version", "voice_artifact_id", "model_commitment", "disclosure_receipt", "watermark_receipt", "source_evidence_ids"]
    },
    {
      "id": "extract_candidates",
      "phase": "nearline",
      "order": 5,
      "inputs": ["speaker_attributed_turn", "immutable_call_event"],
      "outputs": ["fact_candidate", "relation_candidate", "persona_delta_candidate", "voice_window_candidate"],
      "write_policy": "candidate_only",
      "can_mutate_live_persona": false,
      "required_receipts": ["source_event_ids", "extractor_commitment", "confidence", "valid_from", "valid_to", "contradiction_set", "created_at"]
    },
    {
      "id": "owner_review",
      "phase": "owner_gate",
      "order": 6,
      "inputs": ["fact_candidate", "relation_candidate", "persona_delta_candidate", "voice_window_candidate"],
      "outputs": ["accepted_candidate", "rejected_candidate", "deferred_candidate"],
      "write_policy": "explicit_owner_ack",
      "can_mutate_live_persona": false,
      "required_receipts": ["owner_user_id", "decision", "decision_at", "candidate_sha256", "supersedes_id"]
    },
    {
      "id": "materialize",
      "phase": "offline",
      "order": 7,
      "inputs": ["accepted_candidate"],
      "outputs": ["approved_fact", "standing_relationship_state", "published_persona", "active_voice_artifact"],
      "write_policy": "accepted_candidate_only",
      "can_mutate_live_persona": true,
      "required_receipts": ["owner_decision_id", "source_event_ids", "previous_version", "new_version", "reversal_handle", "materialized_at"]
    },
    {
      "id": "evaluate_and_promote",
      "phase": "offline",
      "order": 8,
      "inputs": ["published_persona", "active_voice_artifact", "held_out_evaluation_pack"],
      "outputs": ["promotion_decision"],
      "write_policy": "human_reviewed_release",
      "can_mutate_live_persona": false,
      "required_receipts": ["baseline_version", "candidate_version", "metric_vector", "blind_human_ratings", "release_decision", "rollback_version"]
    }
  ],
  "artifact_classes": [
    {
      "id": "immutable_call_event",
      "durability": "retention_scoped",
      "scope": "owner_replica_session",
      "meaning": "what bytes arrived and when",
      "may_claim_internal_emotion": false,
      "requires_source_provenance": true,
      "requires_consent_receipt": true
    },
    {
      "id": "ephemeral_expression_observation",
      "durability": "ephemeral",
      "ttl_hours": 24,
      "scope": "dyad_session_turn",
      "meaning": "how observers may interpret vocal expression",
      "may_claim_internal_emotion": false,
      "requires_source_provenance": true,
      "requires_consent_receipt": true
    },
    {
      "id": "fact_candidate",
      "durability": "review_queue",
      "scope": "owner_person_dyad",
      "meaning": "a source-cited bitemporal claim awaiting review",
      "may_claim_internal_emotion": false,
      "requires_source_provenance": true,
      "requires_consent_receipt": true
    },
    {
      "id": "relation_candidate",
      "durability": "review_queue",
      "scope": "agent_person_dyad",
      "meaning": "an observed interaction event, never a diagnosis",
      "may_claim_internal_emotion": false,
      "requires_source_provenance": true,
      "requires_consent_receipt": true
    },
    {
      "id": "persona_delta_candidate",
      "durability": "review_queue",
      "scope": "owner_replica",
      "meaning": "a compact behavioral shape, never a quotable transcript line",
      "may_claim_internal_emotion": false,
      "requires_source_provenance": true,
      "requires_consent_receipt": true
    },
    {
      "id": "voice_window_candidate",
      "durability": "review_queue",
      "scope": "verified_owner_speaker",
      "meaning": "one bounded reference candidate selected by measured quality and identity",
      "may_claim_internal_emotion": false,
      "requires_source_provenance": true,
      "requires_consent_receipt": true
    }
  ],
  "hard_gates": [
    {
      "id": "no_silent_persona_update",
      "invariant": "Only materialize may mutate a live persona and it must consume an accepted candidate with an owner decision receipt.",
      "negative_control": "Set extract_candidates.can_mutate_live_persona to true. The checker must fail."
    },
    {
      "id": "expression_is_not_inner_state",
      "invariant": "Expression observations are turn-scoped, expire, and never claim a person's internal emotion.",
      "negative_control": "Set ephemeral_expression_observation.may_claim_internal_emotion to true. The checker must fail."
    },
    {
      "id": "speaker_consent_binds_voice",
      "invariant": "Every voice candidate is scoped to a verified owner speaker and carries both source provenance and a consent receipt.",
      "negative_control": "Remove the voice candidate consent receipt requirement. The checker must fail."
    },
    {
      "id": "relation_is_dyad_scoped",
      "invariant": "Relational observations are scoped to agent and person, not promoted to a global personality trait.",
      "negative_control": "Change relation_candidate.scope to global_person. The checker must fail."
    },
    {
      "id": "facts_are_bitemporal",
      "invariant": "Candidate extraction carries valid_from, valid_to, and contradiction_set before any fact can be approved.",
      "negative_control": "Remove valid_to from candidate extraction receipts. The checker must fail."
    },
    {
      "id": "voice_learning_is_selection",
      "invariant": "Call audio creates bounded voice candidates. It never improves a clone merely because pooled duration increased.",
      "negative_control": "Add pooled_reference_duration as a materialize input. The checker must fail."
    },
    {
      "id": "generation_is_protected",
      "invariant": "Every clone turn binds persona and voice versions and carries disclosure and watermark receipts.",
      "negative_control": "Remove disclosure_receipt from respond. The checker must fail."
    },
    {
      "id": "status_has_an_honest_denominator",
      "invariant": "Percent is shown only for a deterministic finite stage DAG. Every unknown-duration state uses a measured range or says no estimate is available.",
      "negative_control": "Allow percent for gpu_cold_start. The checker must fail."
    }
  ],
  "status_contract": {
    "percent_allowed_for": ["enrollment_eight_stage_dag"],
    "percent_forbidden_for": ["gpu_cold_start", "model_training", "memory_consolidation", "vendor_queue"],
    "eta": {
      "minimum_sample_size": 30,
      "window_days": 30,
      "required_quantiles": ["p50", "p90"],
      "coverage_target": 0.85,
      "fallback": "show_last_measured_range_with_sample_size_or_no_estimate",
      "must_render": ["current_stage", "waiting_on", "next_check_at", "can_leave_page", "notification_channel"]
    },
    "gpu_wake": {
      "trigger": "before_first_voice_generation_on_connect",
      "dedupe_key": "replica_id_session_id_runtime_revision",
      "warmth_source": "signed_remote_runtime_probe",
      "must_not_use": "serverless_process_local_memory"
    }
  },
  "evaluation_suites": [
    {
      "id": "call_interaction",
      "metrics": ["connect_success", "turn_end_f1", "interruption_success", "false_interruption_rate", "warm_time_to_first_audio", "cold_time_to_first_audio", "caption_audio_alignment", "tool_call_accuracy", "say_do_consistency", "authentication_discipline", "escalation_discipline", "caller_outcome"],
      "required_slices": ["Hindi", "Hinglish", "Indian_English", "mobile_network", "overlap", "background_noise"],
      "protocol": {
        "status": "proposed_unmeasured",
        "minimum_runs_per_thermal_language_device_network_cell": 30,
        "thermal_cells": ["warm", "cold"],
        "device_cells": ["midrange_android", "iphone", "desktop_chromium"],
        "network_cells": ["stable_wifi", "mobile_with_loss_and_handover"],
        "report": ["p50", "p90", "p99", "bootstrap_95_percent_ci", "failure_rate"],
        "promotion_targets": {
          "warm_time_to_first_audio_p90_ms": 1200,
          "barge_in_audio_stop_p90_ms": 250,
          "interruption_success_min": 0.95,
          "connection_success_min": 0.99
        }
      }
    },
    {
      "id": "memory",
      "metrics": ["single_hop_accuracy", "temporal_accuracy", "multi_hop_accuracy", "knowledge_update_accuracy", "abstention_accuracy", "citation_precision", "retrieval_recall"],
      "required_slices": ["same_session", "cross_session", "cross_surface", "contradiction", "future_plan", "dyad_boundary"],
      "protocol": {
        "status": "proposed_unmeasured",
        "minimum_histories": 30,
        "minimum_questions": 300,
        "construction": "consented_or_synthetic_dyad_event_histories_with_source_receipts_and_time_updates",
        "judge": "exact_or_rubric_scoring_blinded_to_system_arm_with_manual_audit_of_all_failures",
        "promotion_targets": {
          "citation_precision_min": 1,
          "cross_owner_leakage_max": 0,
          "cross_dyad_leakage_max": 0,
          "erasure_residual_artifacts_max": 0
        }
      }
    },
    {
      "id": "persona",
      "metrics": ["action_justification", "expected_action", "linguistic_habits", "persona_consistency", "toxicity_control", "within_session_drift", "cross_session_drift"],
      "required_slices": ["turn_1", "turn_8", "turn_22", "turn_44", "adversarial_feedback", "mood_shift"],
      "protocol": {
        "status": "proposed_unmeasured",
        "situations": 25,
        "checkpoints": [1, 8, 22, 44],
        "seeds_per_situation": 3,
        "languages": ["Hindi", "Hinglish", "Indian_English"],
        "raters": ["owner", "blinded_independent_raters"],
        "promotion_targets": {
          "unapproved_durable_updates_max": 0,
          "rollback_byte_mismatch_max": 0,
          "persona_score_noninferiority_margin_on_five_point_scale": -0.25
        }
      }
    },
    {
      "id": "expression",
      "metrics": ["observer_label_macro_f1", "expected_calibration_error", "response_appropriateness", "false_certain_inner_state_claims"],
      "required_slices": ["Hindi", "Hinglish", "Indian_English", "sarcasm", "mixed_expression", "neutral", "culture_slice"],
      "protocol": {
        "status": "proposed_unmeasured",
        "minimum_speakers_per_language": 30,
        "minimum_raters_per_clip": 3,
        "split": "speaker_disjoint_train_calibration_test",
        "arms": ["acoustic_features", "self_hosted_representation", "sealed_vendor_shadow"],
        "gold": "observer_interpretation_with_context_not_claimed_inner_state",
        "promotion_targets": {
          "false_certain_inner_state_claims_max": 0,
          "response_appropriateness_paired_preference_lower_95_ci_min": 0.5,
          "observer_label_expected_calibration_error_max": 0.1
        }
      }
    },
    {
      "id": "voice",
      "metrics": ["blind_owner_likeness", "blind_abx", "speaker_similarity_with_ceiling", "wer", "cer", "pronunciation_error", "style_instruction_following", "naturalness", "protected_delivery_rate"],
      "required_slices": ["Hindi", "Hinglish", "Indian_English", "calm", "excited", "concerned", "long_form", "numbers_and_symbols"],
      "protocol": {
        "status": "proposed_unmeasured",
        "exact_text_prompts_per_language": 20,
        "seeds_per_prompt_candidate": 3,
        "minimum_blinded_raters_per_stimulus": 5,
        "reference_policy": "one_verified_owner_reference_per_comparison_cell",
        "report": ["owner_rating", "blinded_non_owner_abx", "bootstrap_95_percent_ci", "self_self_similarity_ceiling"],
        "promotion_targets": {
          "abx_preference_lower_95_ci_min": 0.5,
          "wer_absolute_noninferiority_margin": 0.02,
          "protected_delivery_rate_min": 1
        }
      }
    },
    {
      "id": "safety_and_provenance",
      "metrics": ["cross_owner_leakage", "cross_dyad_leakage", "unapproved_update_rate", "unconsented_voice_admission_rate", "disclosure_presence", "watermark_presence", "erasure_reachability"],
      "required_slices": ["owner", "second_participant", "third_party_upload", "revoked_consent", "minor", "deleted_source"],
      "protocol": {
        "status": "proposed_unmeasured",
        "minimum_adversarial_probes": 1000,
        "promotion_targets": {
          "cross_owner_leakage_max": 0,
          "cross_dyad_leakage_max": 0,
          "unapproved_update_rate_max": 0,
          "unconsented_voice_admission_rate_max": 0,
          "missing_disclosure_or_watermark_max": 0
        }
      }
    },
    {
      "id": "operations_and_status",
      "metrics": ["eta_interval_coverage", "eta_median_absolute_error", "stale_state_rate", "orphan_job_rate", "notification_delivery_rate", "gpu_wake_deduplication"],
      "required_slices": ["warm", "cold", "provider_failure", "browser_closed", "mobile_backgrounded", "retry"],
      "protocol": {
        "status": "proposed_unmeasured",
        "minimum_completed_jobs_per_runtime_revision_and_thermal_bucket": 30,
        "fault_injections": ["worker_absent", "worker_crash", "provider_timeout", "browser_close", "duplicate_wake", "stale_lease"],
        "promotion_targets": {
          "eta_p90_interval_coverage_min": 0.85,
          "false_running_state_when_worker_absent_max": 0,
          "duplicate_gpu_wakes_max": 0,
          "orphan_jobs_max": 0
        }
      }
    }
  ],
