<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WS-NOTIFY. POST_NOTIFICATIONS is already declared below and stays: it
         is the Android 13+ runtime permission, requested at the first moment a
         notification would have helped (src/notify/NotifySheet.tsx), never at
         launch.

         SCHEDULE_EXACT_ALARM IS REMOVED, and that is a decision rather than a
         cleanup. @capacitor/local-notifications declares it in its own manifest
         and the merger would pull it into this APK automatically. We do not
         want it:

           * nothing in this app schedules an exact alarm. The one scheduled
             notification is her story, and src/notify/local.ts's `postAt`
             passes `isExactNotification: false` explicitly — a story that lands
             inside the OS's own batching window is a story that landed.
           * the plugin's exact path, on API 31+, OPENS THE SYSTEM "Alarms &
             reminders" SETTINGS SCREEN the first time it is used. An app that
             answers "she posted a story" with a settings screen is worse than
             an app with no story notification.
           * Play treats SCHEDULE_EXACT_ALARM as a declared-use permission for
             alarm-clock and calendar apps. Shipping one we do not use is a
             policy review we would lose and should.

         Removing it here rather than in the plugin means an upgrade of the
         plugin cannot quietly reintroduce it. If a future feature genuinely
         needs a to-the-second alarm, delete this line WITH the argument for
         why, not because the build complained. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- usesCleartextTraffic is stated rather than inherited. It is already the
         platform default at this targetSdk, but OTA means the app now downloads
         code it will execute, and the line that decides whether that download
         can be plaintext is not one to leave to a default a future library or
         targetSdk bump could move. Nothing here speaks http: the WebView's
         https://localhost origin is served by Capacitor's own local server. -->
    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".BubbleService" android:exported="false" />

        <service
            android:name=".WatchCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
