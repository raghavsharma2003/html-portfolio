+  // `evals/teacher-sheet-publication/mounted.mjs` is.
+  const FIXED_SHAPE = [
+    "const pending = [];",
+    "server = createServer((req, res) => { pending.push(() => res.end('{}')); });",
+    "await page.waitForFunction(() => document.querySelector('button').disabled === true);",
+    "await awaitPending(1);",
+  ].join("\n");
+  const cleanFixed = stripComments(FIXED_SHAPE);
+  const sameTickFixed = findSameTickAsserts(cleanFixed, (id) => identifierIsPushedOrIncremented(cleanFixed, id));
+  ok("NEGATIVE CONTROL (already fixed): a same-tick assert interposed with awaitPending() is not flagged",
+    sameTickFixed.length === 0);
+
+  // A helper function whose OWN body already does a real round-trip-proving
