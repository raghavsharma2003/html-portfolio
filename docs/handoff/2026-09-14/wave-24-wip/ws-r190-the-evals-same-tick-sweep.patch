diff --git a/evals/lib/bounded-wait.mjs b/evals/lib/bounded-wait.mjs
index 5a9a8f2..6292508 100644
--- a/evals/lib/bounded-wait.mjs
+++ b/evals/lib/bounded-wait.mjs
@@ -111,6 +111,39 @@ export function loadCeilingResult(ceiling = DEFAULT_LOAD_CEILING, opts = {}) {
  * own separate `node` process holding the identical port at the same
  * instant, which no in-process lane can ever prevent.
  */
+/**
+ * WS-R190. The shared fix for the same-tick race: a browser-side wait
+ * (`page.waitForFunction`/`.waitFor`/`.click`) proves only what the PAGE
+ * rendered, never whether the request it dispatched has yet reached a
+ * Node-side fake server/fetch handler — the exact race that cost
+ * `teacher-sheet-publication-ui`, `candidate-activation-ui` and
+ * `feedback-dataset-ui` a run each this wave (context/rejected.md
+ * #teacher-sheet-publication-ui-asserted-the-fake-servers-pending-count-on-the-tick-the-button-disabled).
+ * `awaitPending` in `evals/teacher-sheet-publication/mounted.mjs` was the
+ * first fix, written by hand for that one suite's own `pending` array;
+ * `awaitCount` here is the same fix generalised so no suite ever needs its
+ * own copy again (`evals/same-tick-scan/run.mjs`'s own law: "never a
+ * per-suite copy").
+ *
+ * `getCount()` is polled (never a single read) until it reaches at least
+ * `n` or the bound (`boundedWaitMs(base, opts)`, so it scales with load
+ * exactly like every other barrier in this file) elapses, then the LAST
+ * read value is returned — never `n` itself — so a caller's own
+ * `assert.equal(await awaitCount(...), n)` fails by name, with the real
+ * (too-low) count, when the count genuinely never arrives, rather than the
+ * bound silently laundering a real miss into a false pass.
+ */
+export async function awaitCount(getCount, n, base = 5000, opts = {}) {
+  const deadline = Date.now() + boundedWaitMs(base, opts);
+  const { intervalMs = 20 } = opts;
+  let value = getCount();
+  while (value < n && Date.now() < deadline) {
+    await new Promise((resolve) => setTimeout(resolve, intervalMs));
+    value = getCount();
+  }
+  return value;
+}
