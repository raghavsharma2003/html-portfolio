+    totalBarriers += barriers.length;
+  }
+}
+console.log(`  swept ${BROWSER_SUITE_FILES.length} browser suite files: ${totalSameTick} same-tick finding(s), ${totalBarriers} unscaled fixed-barrier finding(s)`);
