+// WS-R190. THE EVALS' SAME-TICK SWEEP — the scanner.
+//
+//   node evals/same-tick-scan/run.mjs
+//   node evals/run.mjs same-tick-scan
+//
+// Three suites lost a run each this wave to the identical shape
+// (context/rejected.md#teacher-sheet-publication-ui-asserted-the-fake-servers-pending-count-on-the-tick-the-button-disabled:
+// candidate-activation-ui, feedback-dataset-ui, teacher-sheet-publication-ui)
+// and the personal rehearsal lost two runs to a fixed 20s first-render
+// barrier under load (ws-common.md's wave-twenty-three lesson). Both are the
+// same root cause — a barrier or assertion tuned on a QUIET machine meeting a
+// machine that is not quiet — and both have one known fix already
+// (`evals/lib/bounded-wait.mjs`, WS-R181). This file is the scanner that
+// makes writing either shape again impossible to land unnoticed: it reads
+// every browser suite through the shared comment-stripping tokenizer
+// (`evals/lib/source-scan.mjs`, WS-R134 — so a comment describing either
+// trap, this file's own header included, can never trip or hide from it) and
+// fails BY NAME on either shape.
+//
+// LAW 2 SHAPE ("same-tick assert"): a browser-side wait
+// (`page.waitForFunction(`, `.waitFor(`, `.click(`) followed, before any
+// bounded Node-side wait, by an `assert.*(` on a bare identifier that is
+// itself filled asynchronously by a fake HTTP server or fetch handler in
+// THIS file — proved by grepping the file for that identifier's own
+// `.push(` (an array a handler appends to) or `++`/`+= 1` (a scalar counter
+// a handler increments). The browser wait proves what the PAGE rendered; it
+// proves nothing about whether the REQUEST that render was reacting to has
+// yet reached the Node-side handler that fills the identifier — the exact
+// race `teacher-sheet-publication-ui` lost once under pool contention
+// (`awaitPending` in `evals/teacher-sheet-publication/mounted.mjs` is the
+// fixed shape this scanner treats as SAFE: a bounded poll of the same
+// predicate, from `evals/lib/bounded-wait.mjs`, interposed before the
+// assert).
+//
+// LAW 3 SHAPE ("fixed barrier"): a `timeout: <N>` of 10 seconds or more
+// written as a literal number, in `evals/rehearsal/*.mjs` or a
+// `*/mounted.mjs` suite — the exact class `evals/rehearsal/personal.mjs`'s
+// 20s post-sign-in wait was, before this workstream scaled it with
+// `boundedWaitMs`. A literal already wrapped in `boundedWaitMs(...)` is safe
+// by construction (the wrapper call is what this scanner looks for) and is
+// not re-flagged.
+//
+// NEGATIVE CONTROL: a synthetic offending file, one instance of each shape,
+// must be caught. POSITIVE CONTROL: the fixed
+// `evals/teacher-sheet-publication/mounted.mjs` (the suite this whole
+// workstream is named for) reports zero same-tick findings, and every
+// `evals/rehearsal/*.mjs` first-render/navigation barrier this workstream
+// scaled is confirmed wrapped.
+//
+// Offline, deterministic, $0, no network, no database, no model call, no GPU.
+import { readFileSync, readdirSync, statSync } from "node:fs";
+import { dirname, join, relative, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { stripComments } from "../lib/source-scan.mjs";
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const REPO = resolve(HERE, "..", "..");
+const EVALS = join(REPO, "evals");
+
+let pass = 0;
+let fail = 0;
+const ok = (name, cond, extra = "") => {
+  if (cond) pass++;
+  else fail++;
+  console.log(`${cond ? "  ok  " : "FAIL  "}${name}${extra ? `   ${extra}` : ""}`);
+};
+
+// ═════════════════════════════════════════════════════════════════════════
+// The two pure detectors. Both operate on COMMENT-STRIPPED source only.
+// ═════════════════════════════════════════════════════════════════════════
+
+// `page.waitForFunction(` and `.click(` are the two triggers every real
+// incident in this codebase actually used (teacher-sheet-publication-ui and
+// feedback-dataset-ui on a `page.waitForFunction(() => ...disabled === true)`
+// client-optimistic DOM read; candidate-activation-ui on a bare `.click()`
+// with nothing but a synchronous `isDisabled()` DOM read before the assert —
+// context/rejected.md#teacher-sheet-publication-ui-asserted-the-fake-servers-pending-count-on-the-tick-the-button-disabled).
+// A LOCATOR `.waitFor(` (`region().getByText(...).waitFor()` and its kin) is
+// deliberately NOT a trigger: this codebase's own idiom for "prove the round
+// trip finished" is waiting for text/role content that only renders once
+// React has processed a resolved fetch — reaching that state is therefore
+// already proof the Node-side handler ran, which is exactly why every real
+// suite in this tree (teacher-sheet-publication-ui's own already-fixed file
+// included, this scanner's positive control below) freely asserts a
+// push()-fed counter right after one. Treating it as a trigger anyway was
+// this scanner's own first draft, and it flagged 17 already-safe sites in
+// the ONE file everyone agrees is already fixed — the false-positive rate
+// the positive control below exists to catch.
+const TRIGGER_RE = /(?:page\.waitForFunction\(|\.click\()/g;
+// Interposing ANY of these before the assert marks the pairing SAFE — each
+// either genuinely blocks on the Node-visible request/response
+// (waitForResponse/waitForLoadState), is this workstream's/WS-R181's own
+// bounded poller (awaitPending/awaitCount/boundedWaitMs), or is a locator
+// `.waitFor(` proving a server-confirmed render per the paragraph above.
+const SAFE_INTERPOSED_RE = /\b(?:awaitPending|awaitCount|boundedWaitMs)\s*\(|\.waitForResponse\(|\.waitForLoadState\(|\.waitFor\(/g;
+// The identifier immediately inside `assert.<method>(`, an optional leading
+// `await` skipped — whatever it is chained with after (`.length`,
+// `.filter(...)`, `.at(-1)`, a bare `,`) is deliberately NOT required here;
+// `fedByPushOrIncrement` below is what actually decides whether this
+// identifier is a counter worth caring about, so broadening the capture
+// costs nothing but catches the real shapes a stricter `IDENT.length`-only
+// pattern misses (`calls.filter(item => item.body.op === 'x').length`,
+// `calls.at(-1).body`, none of which have `.length` immediately after the
+// bare identifier).
+const ASSERT_RE = /assert\.\w+\(\s*(?:await\s+)?([A-Za-z_$][\w$]*)\b/g;
+// An assert of the exact shape `assert.deepEqual(IDENT, [])` (an EMPTY-array
+// check, whitespace-insensitive) — this codebase's own end-of-suite idiom
+// for "nothing unexpected happened at all" (`network`/`pageErrors`/`errors`/
+// `external`/`unexpected`/`surprises`/`issues`/`blocked`, each asserted `[]`
+// once, after every other await in the suite has already settled). Proving
+// an array is EMPTY needs no NEW event to have landed — unlike law 2's real
+// race (proving a counter already reflects an event that JUST happened), an
+// absence that has not manifested by the time every other awaited step in
+// the suite already finished isn't waiting on anything further, so this
+// shape is categorically not the same-tick race and is excluded rather than
+// mis-flagged as one (found empirically: every real occurrence of this
+// shape in the tree today is an end-of-suite diagnostic-array check).
+// Also generalised to `assert.equal(<expr>.length, 0)` — the identical
+// "prove nothing new happened" idiom spelled with a length-vs-zero compare
+// instead of a deepEqual-vs-`[]` one (this tree's own
+// `evals/personality-flow28/mounted.mjs`: `assert.equal(requests.slice(before)
+// .filter(r => r.token === 'synthetic-initial').length, 0)` — proving a
+// STALE token produced no further request, not that an expected one already
+// landed). Both shapes need no NEW event to have manifested by the time
+// every other awaited step in the statement has already settled.
+const EMPTY_OR_ZERO_ASSERT_RE = /assert\.\w+\([^,]*,\s*(?:\[\s*\]|0)\s*[,)]/;
+function assertsEmptyArray(cleanSrc, assertIndex) {
+  EMPTY_OR_ZERO_ASSERT_RE.lastIndex = 0;
+  const m = EMPTY_OR_ZERO_ASSERT_RE.exec(cleanSrc.slice(assertIndex, assertIndex + 160));
+  return Boolean(m && m.index === 0);
+}
+// Bookkeeping arrays/counters every suite in this style keeps for its own
+// pass/fail tally, console log or per-iteration RESULT record (pushed by the
+// suite's OWN synchronous code, never by a fake server/fetch handler
+// responding to a request) — asserting on these is not the race this
+// scanner exists for.
+const BOOKKEEPING_IDENTS = new Set(["checks", "errors", "cases", "logs", "warnings", "pass", "fail", "failed", "rows", "results"]);
+
+/** True when the trigger at `index` sits inside a `Promise.all([ ... ])` (or
+ *  `await Promise.all([ ... ])`) array literal that ALSO contains a real
+ *  network wait (`.waitForResponse(`/`.waitForLoadState(`) somewhere in the
+ *  same array — the idiom this codebase uses to pair a click with the
+ *  response it causes (`Promise.all([page.waitForResponse(...),
+ *  locator.click()])`), which genuinely blocks the enclosing `await` on the
+ *  Node-visible response even though the `.click(` token itself sits AFTER
+ *  `.waitForResponse(` in source order. Found by walking backward from
+ *  `index` for the nearest `Promise.all([`, then forward with bracket
+ *  counting for its matching `]`; a trigger with no enclosing `Promise.all([`
+ *  within reach is not reclassified. */
+function isInsideSafePromiseAll(cleanSrc, index) {
+  const opener = cleanSrc.lastIndexOf("Promise.all([", index);
+  if (opener === -1) return false;
+  const arrayStart = opener + "Promise.all(".length; // at the "["
+  let depth = 0;
+  let j = arrayStart;
+  for (; j < cleanSrc.length; j++) {
+    if (cleanSrc[j] === "[") depth++;
+    else if (cleanSrc[j] === "]") {
+      depth--;
+      if (depth === 0) break;
+    }
+  }
+  const arrayEnd = j; // index of the matching "]", or src.length if unterminated
+  if (index < arrayStart || index > arrayEnd) return false; // the trigger is not actually inside THIS array
+  const body = cleanSrc.slice(arrayStart, arrayEnd);
+  return /\.waitForResponse\(|\.waitForLoadState\(/.test(body);
+}
+
+// A local async helper's own definition, any shape this codebase writes:
+// `async function NAME(...) { ... }`, `const NAME = async (...) => { ... }`,
+// or `const NAME = async bareParam => { ... }` (a single unparenthesized
+// arrow parameter, this tree's own `action-focus/run.mjs#done` shape).
+const HELPER_DEF_RE = /(?:async\s+function\s+([A-Za-z_$][\w$]*)\s*\([^)]*\)\s*\{|(?:const|let)\s+([A-Za-z_$][\w$]*)\s*=\s*async\s*(?:\([^)]*\)|[A-Za-z_$][\w$]*)\s*=>\s*\{)/g;
+
+/** The matching `}` for the `{` at `openBrace`, by depth counting — good
+ *  enough for this repo's real function bodies (no template-literal `${`
+ *  interpolation confusion, since `cleanSrc` is comment-stripped source and
+ *  a template literal's own braces still balance). */
+function matchingBrace(cleanSrc, openBrace) {
+  let depth = 0;
+  for (let j = openBrace; j < cleanSrc.length; j++) {
+    if (cleanSrc[j] === "{") depth++;
+    else if (cleanSrc[j] === "}") {
+      depth--;
+      if (depth === 0) return j;
+    }
+  }
+  return cleanSrc.length;
+}
+
+/** `[index, ...]` — the start of every CALL SITE (`NAME(`) of a locally
+ *  defined async helper whose OWN body directly contains a real network wait
+ *  or a bounded poller — the same "safe" shapes `SAFE_INTERPOSED_RE` already
+ *  recognizes at a call site, just one level of indirection down. This is
+ *  what keeps this scanner from blaming `.click()` for an assert that
+ *  actually follows `await ask(page)`, when `ask()`'s own body already does
+ *  `await page.getByText(...).waitFor()` before returning — a real shape in
+ *  this tree (`evals/publication-continuity-mounted.mjs`'s own `ask`), not
+ *  merely a hypothetical. Only ONE level of indirection is resolved (a safe
+ *  helper calling ANOTHER helper that is itself safe is not chased further);
+ *  every real occurrence in this tree today needs only one level. */
+function safeHelperCallSites(cleanSrc) {
+  const safeNames = new Set();
+  HELPER_DEF_RE.lastIndex = 0;
+  for (const m of cleanSrc.matchAll(HELPER_DEF_RE)) {
+    const name = m[1] || m[2];
+    const openBrace = m.index + m[0].length - 1;
+    const closeBrace = matchingBrace(cleanSrc, openBrace);
+    const body = cleanSrc.slice(openBrace, closeBrace);
+    if (SAFE_INTERPOSED_RE.test(body)) safeNames.add(name);
+    SAFE_INTERPOSED_RE.lastIndex = 0;
+  }
+  if (safeNames.size === 0) return [];
+  const callRe = new RegExp(`\\b(?:${[...safeNames].map((n) => n.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})\\s*\\(`, "g");
+  const sites = [];
+  for (const m of cleanSrc.matchAll(callRe)) sites.push(m.index);
+  return sites;
+}
+
+// Every local function/arrow BODY's own `[start, end)` brace span (any
+// shape: `function NAME(...) { }`, `const NAME = (...) => { }`, `const NAME
+// = async (...) => { }`, `const NAME = bareParam => { }`), sync or async.
+// Used only to SCOPE the nearest-preceding-op search below — never to decide
+// safety on its own — because a helper's OWN definition sits at some
+// arbitrary point in the file, textually "after" whatever trigger happened
+// to precede it, even though the helper is only ever REACHED later, at its
+// own call site. Without this, an assert written inside a helper's
+// definition (`const reset = () => { assert.equal(held.length, 0); ... }`,
+// this tree's own `evals/personality-flow28/mounted.mjs#reset`) gets blamed
+// for a completely unrelated trigger that merely happens to sit earlier in
+// the file, when the real question — was `reset()`'s OWN call site properly
+// guarded — is a different, well-covered concern (every real call site is
+// itself scanned when its surrounding statement is walked).
+const ANY_FUNC_BODY_RE = /(?:function\s+[A-Za-z_$][\w$]*\s*\([^)]*\)\s*\{|(?:const|let)\s+[A-Za-z_$][\w$]*\s*=\s*(?:async\s*)?(?:\([^)]*\)|[A-Za-z_$][\w$]*)\s*=>\s*\{)/g;
+function functionBodyRanges(cleanSrc) {
+  const ranges = [];
+  ANY_FUNC_BODY_RE.lastIndex = 0;
+  for (const m of cleanSrc.matchAll(ANY_FUNC_BODY_RE)) {
+    const openBrace = m.index + m[0].length - 1;
+    const closeBrace = matchingBrace(cleanSrc, openBrace);
+    ranges.push([openBrace, closeBrace]);
+  }
+  return ranges;
+}
+/** The SMALLEST (innermost) range in `ranges` that contains `index`, or
+ *  `null` if `index` sits at top level, outside every function body. */
+function innermostRange(ranges, index) {
+  let best = null;
+  for (const r of ranges) {
+    if (index >= r[0] && index < r[1] && (!best || r[1] - r[0] < best[1] - best[0])) best = r;
+  }
+  return best;
+}
+
+/** `[{ identifier, index }]` — one entry per same-tick pairing found.
+ *  `cleanSrc` must already be comment-stripped by the caller.
+ *  `fedByPushOrIncrement` decides whether a captured identifier is plausibly
+ *  a fake-server/fetch-filled counter (callers pass the real per-file check,
+ *  tests pass a stub).
+ *
+ *  Algorithm: walk every assert in source order and look at the NEAREST
+ *  preceding operation of either kind (trigger or safe-interposed) —
+ *  whichever gates that particular assert, not merely whichever trigger
+ *  happens to sit within some fixed character budget of it. This is what
+ *  makes the scanner agree with a file where a click is followed by a LATER,
+ *  unrelated, already-safe wait before the assert that actually matters: the
+ *  nearest op to the assert is the safe one, so the earlier click is
+ *  correctly not blamed for it. The search is further SCOPED to the assert's
+ *  own innermost function body (see `functionBodyRanges` above): an op
+ *  outside that scope never gates an assert inside it, and vice versa. */
+export function findSameTickAsserts(cleanSrc, fedByPushOrIncrement) {
+  const ops = [];
+  for (const m of cleanSrc.matchAll(TRIGGER_RE)) ops.push({ index: m.index, safe: isInsideSafePromiseAll(cleanSrc, m.index) });
+  for (const m of cleanSrc.matchAll(SAFE_INTERPOSED_RE)) ops.push({ index: m.index, safe: true });
+  for (const index of safeHelperCallSites(cleanSrc)) ops.push({ index, safe: true });
+  ops.sort((a, b) => a.index - b.index);
+  const ranges = functionBodyRanges(cleanSrc);
+
+  const hits = [];
+  for (const assertMatch of cleanSrc.matchAll(ASSERT_RE)) {
+    const scope = innermostRange(ranges, assertMatch.index);
+    let nearest = null;
+    for (const op of ops) {
+      if (op.index >= assertMatch.index) break;
+      if (scope && (op.index < scope[0] || op.index >= scope[1])) continue; // outside the assert's own scope
+      nearest = op;
+    }
+    if (!nearest || nearest.safe) continue; // no gating op in scope, or the nearest one is safe
+    const identifier = assertMatch[1];
+    if (BOOKKEEPING_IDENTS.has(identifier)) continue;
+    if (assertsEmptyArray(cleanSrc, assertMatch.index)) continue;
+    if (!fedByPushOrIncrement(identifier)) continue;
+    hits.push({ identifier, index: assertMatch.index });
+  }
+  return hits;
+}
+
+/** Whether `identifier` is written to by a `.push(` call or an increment
+ *  (`++`/`+= 1`) anywhere in this (comment-stripped) file — the file-level
+ *  proof that it is a counter a handler fills, not a DOM/page-side read. */
+export function identifierIsPushedOrIncremented(cleanSrc, identifier) {
+  const escaped = identifier.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+  const pushRe = new RegExp(`\\b${escaped}\\s*\\.push\\s*\\(`);
+  const incRe = new RegExp(`\\b${escaped}\\s*(?:\\+\\+|\\+=\\s*1\\b)`);
+  return pushRe.test(cleanSrc) || incRe.test(cleanSrc);
+}
+
+// A literal ms value of 10 seconds or more, as `timeout: <N>` (Playwright's
+// own option shape). `boundedWaitMs(` immediately as the value is exempted —
+// that IS the fix. Values under 10 000 are left alone: a short click/network
+// timeout is not the "first render or navigation" barrier class this
+// workstream targets, and flagging every short wait would bury the two real
+// barrier classes in noise.
+const FIXED_TIMEOUT_RE = /timeout\s*:\s*(boundedWaitMs\([^)]*\)|\d[\d_]*)/g;
+
+/** `[{ ms, index }]` — one entry per literal (non-`boundedWaitMs`) timeout
+ *  of 10 000ms or more found in `cleanSrc`. */
+export function findFixedBarriers(cleanSrc) {
+  const hits = [];
+  for (const m of cleanSrc.matchAll(FIXED_TIMEOUT_RE)) {
+    const raw = m[1];
+    if (raw.startsWith("boundedWaitMs")) continue;
+    const ms = Number(raw.replace(/_/g, ""));
+    if (Number.isFinite(ms) && ms >= 10_000) hits.push({ ms, index: m.index });
+  }
+  return hits;
+}
+
+// ═════════════════════════════════════════════════════════════════════════
+// §1 — NEGATIVE CONTROL: a synthetic offending file, one instance of each
+// shape, must be caught by both detectors.
+// ═════════════════════════════════════════════════════════════════════════
+console.log("── §1: negative control — a synthetic offending file is caught ──");
+{
+  const OFFENDING = [
