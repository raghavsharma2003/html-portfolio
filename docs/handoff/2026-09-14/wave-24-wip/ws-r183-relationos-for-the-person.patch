+    const hits = scanSource(rel, src, { rules: "full", codename: true, roomsVocab: true });
+    ok(`copy gate: ${rel} carries zero offences`, hits.length === 0, hits.length ? JSON.stringify(hits.slice(0, 3)) : "");
+  }
+
+  // `copy.ts`/`hiCopy.ts` are ~2000-line shared registries with many
+  // sections this workstream did not write — scanning the WHOLE file with
+  // `roomsVocab: true` forced on would flag PRE-EXISTING, already-approved
+  // content outside this workstream's own block (the real
+  // `scripts/check-copy.mjs` never applies the rooms-vocabulary rule to
+  // these two paths at all — `ROOM_VOCAB_PATH.test("src/studio/copy.ts")`
+  // is false, `copy-room-scope.mjs`'s own header). So this suite scans only
+  // the TWO OBJECT LITERALS this workstream actually added, sliced out by
+  // their own start/end markers, never the surrounding file — a targeted,
+  // honest bar rather than a false positive on someone else's copy.
+  function sliceBlock(src, startMarker, endMarker) {
+    const start = src.indexOf(startMarker);
+    if (start === -1) return null;
+    const end = src.indexOf(endMarker, start);
+    if (end === -1) return null;
+    return src.slice(start, end + endMarker.length);
+  }
+  {
+    const src = readFileSync(join(STUDIO_DIR, "copy.ts"), "utf8");
+    const block = sliceBlock(src, "const EN_RELATIONS_STUDIO: RelationsStudioCopy = {", "\n};");
+    ok("copy.ts: EN_RELATIONS_STUDIO block was found (not vacuous)", Boolean(block), block ? "" : "block not found");
+    if (block) {
+      const hits = scanSource("src/studio/copy.ts", block, { rules: "full", codename: true, roomsVocab: true });
+      ok("copy gate: EN_RELATIONS_STUDIO carries zero offences", hits.length === 0, hits.length ? JSON.stringify(hits.slice(0, 3)) : "");
+    }
+  }
+  {
+    const src = readFileSync(join(STUDIO_DIR, "hiCopy.ts"), "utf8");
+    const block = sliceBlock(src, "const HI_RELATIONS_STUDIO: RelationsStudioCopy = {", "\n};");
+    ok("hiCopy.ts: HI_RELATIONS_STUDIO block was found (not vacuous)", Boolean(block), block ? "" : "block not found");
+    if (block) {
+      const hits = scanSource("src/studio/hiCopy.ts", block, { rules: "full", codename: true, roomsVocab: true });
+      ok("copy gate: HI_RELATIONS_STUDIO carries zero offences", hits.length === 0, hits.length ? JSON.stringify(hits.slice(0, 3)) : "");
+    }
+  }
+  {
+    const bad = 'const relationsStudioBad = { pauseAction: "pause your clone" };';
+    const hits = scanSource("src/studio/relationsStudioCopy.ts", bad, { rules: "full", codename: true, roomsVocab: true });
+    ok('NEGATIVE CONTROL: a string with "clone" fails scripts/check-copy.mjs', hits.length > 0);
+  }
+}
+
+// ═════════════════════════════════════════════════════════════════════════
+console.log("\n── §6: honest below the floor — the component's own source ──");
+// ═════════════════════════════════════════════════════════════════════════
+{
+  const src = readFileSync(join(STUDIO_DIR, "RelationsStudio.tsx"), "utf8");
+  ok("mounts inside DeployStudio.tsx (checked from that file, not this one)", true);
+  ok("RelationsStudio.tsx never renders people_this_week.n or people_this_month.n WITHOUT a below_floor guard on the same expression",
+    /below_floor \? c\.fewerThanFive : relations\.people_this_week\.n/.test(src) &&
+    /below_floor \? c\.fewerThanFive : relations\.people_this_month\.n/.test(src));
+  ok("stage buckets under the floor are rendered by iterating the SERVER's own array (never a fixed 0..4 list padded with zeros)",
+    /relations\.stage_counts\.find/.test(src));
+
+  const deploySrc = readFileSync(join(STUDIO_DIR, "DeployStudio.tsx"), "utf8");
+  ok("DeployStudio.tsx imports the real RelationsStudio, not a copy", /import RelationsStudio from ["']\.\/RelationsStudio["']/.test(deploySrc));
+  ok("DeployStudio.tsx mounts <RelationsStudio", /<RelationsStudio\b/.test(deploySrc));
+}
+
+// ═════════════════════════════════════════════════════════════════════════
+console.log("\n── §7: roomPublishApi.ts — the client wrapper, real ops, no reinvention ──");
+// ═════════════════════════════════════════════════════════════════════════
+{
+  const src = readFileSync(join(REPO, "src/creatorStudio/roomPublishApi.ts"), "utf8");
+  ok('readOwnedRoomRelations calls op:"relations"', /op:\s*"relations"/.test(src));
+  ok('setOwnedRoomQuietHoursDefault calls op:"set_quiet_hours_default"', /op:\s*"set_quiet_hours_default"/.test(src));
+  ok("both reuse the shared call()/replicaRequest plumbing (no second fetch helper introduced)", !/new XMLHttpRequest|fetch\(["']\/api\/room-publish/.test(src));
+}
+
+console.log(`\nrelations-studio: ${pass} passed, ${fail} failed`);
+if (fail) process.exit(1);
