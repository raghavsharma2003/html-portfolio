+console.log("\n── §5: the copy gate, on the real files this workstream wrote ──");
+// ═════════════════════════════════════════════════════════════════════════
+{
+  const REAL_FILES = [
+    ["src/studio/RelationsStudio.tsx", join(STUDIO_DIR, "RelationsStudio.tsx")],
+    ["src/studio/relations-studio.css", join(STUDIO_DIR, "relations-studio.css")],
+  ];
+  for (const [rel, abs] of REAL_FILES) {
