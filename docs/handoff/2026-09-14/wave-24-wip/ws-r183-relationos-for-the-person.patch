diff --git a/src/studio/RelationsStudio.tsx b/src/studio/RelationsStudio.tsx
new file mode 100644
index 0000000..5356175
--- /dev/null
+++ b/src/studio/RelationsStudio.tsx
@@ -0,0 +1,331 @@
+// RelationsStudio.tsx — WS-R183, "RelationOS for the person".
+//
+// RelationOS is "how it treats each person". The follower already sees "How
+// we are" in the Room (WS-R154, `src/room/AccountPage.tsx`); the creator's
+// ops board already sees floored stage counts (WS-R154/167,
+// `src/creatorStudio/RoomStudio.tsx`'s own `relstate_stage_counts` card).
+// Until this workstream, the PERSON who built their own AI saw neither: no
+// screen under `src/studio/` read a relationship count at all. This screen
+// is that gap closed — mounted behind Deploy (`DeployStudio.tsx`'s own
+// Share tab, this workstream's brief law 4), reading the SAME kind of
+// counts a creator already reads, through the SAME owner door
+// (`api/room-publish.js`) the personal studio already calls for Deploy.
+//
+// COUNT-SHAPED, ALWAYS. Every number this screen shows either comes off
+// `api/_room-publish.js#ownerRoomRelations` (itself entirely count-shaped —
+// that function's own header states which counts are floored at n>=5 and
+// which are not, and why) or off `api/_checkins.js#listDesigns`/
+// `pauseDesign` (a design's own title/prompt shape — the OWNER'S OWN words
+// for their own check-in, never a follower's). No person id, name or
+// message ever reaches this component.
+//
+// HONEST BELOW THE FLOOR: `fewerThanFive` renders in WORDS, never a number
+// under five and never a bar of zero height pretending to be data — the
+// workstream brief's own law 4, `evals/relations-studio/run.mjs`'s own
+// negative control on this exact rendering rule.
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useStudioLocale } from "./localeContext";
+import {
+  pauseOwnedRoom,
+  resumeOwnedRoom,
+  readOwnedRoomRelations,
+  setOwnedRoomQuietHoursDefault,
+  RoomPublishApiError,
+  type RoomRelations,
+} from "../creatorStudio/roomPublishApi";
+import {
+  listCheckinDesigns,
+  setCheckinDesignState,
+  CheckinsApiError,
+  type CheckinDesign,
+} from "../creatorStudio/checkinsApi";
+import "./relations-studio.css";
+
+const STAGE_KEYS = ["new", "warming", "settled", "close", "deep"] as const;
+
+function isAuthError(cause: unknown): boolean {
+  if (cause instanceof RoomPublishApiError && cause.status === 401) return true;
+  if (cause instanceof CheckinsApiError && cause.status === 401) return true;
+  return false;
+}
+
+export default function RelationsStudio({
+  token,
+  replicaId,
+  onAuthError,
+}: {
+  token: string;
+  replicaId: string;
+  onAuthError: (cause: unknown) => void;
+}) {
+  const { t } = useStudioLocale();
+  const c = t.relationsStudio;
+  const auth = useRef(onAuthError);
+  auth.current = onAuthError;
+
+  const [relations, setRelations] = useState<RoomRelations | null>(null);
+  const [loaded, setLoaded] = useState(false);
+  const [loadError, setLoadError] = useState(false);
+
+  const [designs, setDesigns] = useState<CheckinDesign[] | null>(null);
+  const [designsLoaded, setDesignsLoaded] = useState(false);
+  const [designBusy, setDesignBusy] = useState<string | null>(null);
+
+  const [pauseBusy, setPauseBusy] = useState(false);
+
+  const [tz, setTz] = useState("");
+  const [from, setFrom] = useState("");
+  const [to, setTo] = useState("");
+  const [quietBusy, setQuietBusy] = useState(false);
+  const [quietNotice, setQuietNotice] = useState("");
+  const [quietError, setQuietError] = useState(false);
+
+  const load = useCallback(async () => {
+    try {
+      const next = await readOwnedRoomRelations(token, replicaId);
+      setRelations(next);
+      setLoadError(false);
+      if (next) {
+        setTz(next.quiet_hours_default.timezone ?? "");
+        setFrom(next.quiet_hours_default.quiet_from ?? "");
+        setTo(next.quiet_hours_default.quiet_to ?? "");
+      }
+    } catch (cause) {
+      if (isAuthError(cause)) return auth.current(cause);
+      setLoadError(true);
+    } finally {
+      setLoaded(true);
+    }
+  }, [token, replicaId]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  useEffect(() => {
+    let alive = true;
+    listCheckinDesigns(token, replicaId)
+      .then((rows) => {
+        if (alive) setDesigns(rows);
+      })
+      .catch((cause) => {
+        if (!alive) return;
+        if (isAuthError(cause)) return auth.current(cause);
+        setDesigns([]);
+      })
+      .finally(() => {
+        if (alive) setDesignsLoaded(true);
+      });
+    return () => { alive = false; };
+  }, [token, replicaId]);
+
+  const togglePause = useCallback(async () => {
+    if (!relations) return;
+    setPauseBusy(true);
+    try {
+      const next = relations.paused ? await resumeOwnedRoom(token, replicaId) : await pauseOwnedRoom(token, replicaId);
+      setRelations({ ...relations, paused: next.paused });
+    } catch (cause) {
+      if (isAuthError(cause)) return auth.current(cause);
+      // A locked resume (readiness/disclosure regressed since publish) is a
+      // named, honest reason — `RoomPublishApiError.blockers` — but this
+      // screen's own scope is Deploy's Share-tab control surface, not the
+      // full blocker explainer `DeployStudio.tsx`'s own banner already
+      // owns; leaving `relations.paused` unchanged here is itself the
+      // honest state (the room did not actually resume).
+    } finally {
+      setPauseBusy(false);
+    }
+  }, [relations, token, replicaId]);
+
+  const saveQuietHours = useCallback(async () => {
+    setQuietBusy(true);
+    setQuietNotice("");
+    setQuietError(false);
+    try {
+      const saved = await setOwnedRoomQuietHoursDefault(token, replicaId, {
+        timezone: tz.trim() || null,
+        quietFrom: from.trim() || null,
+        quietTo: to.trim() || null,
+      });
+      setRelations((prev) => (prev ? { ...prev, quiet_hours_default: saved } : prev));
+      setQuietNotice(c.quietHoursSaved);
+    } catch (cause) {
+      if (isAuthError(cause)) return auth.current(cause);
+      setQuietError(true);
+    } finally {
+      setQuietBusy(false);
+    }
+  }, [token, replicaId, tz, from, to, c.quietHoursSaved]);
+
+  const clearQuietHours = useCallback(async () => {
+    setTz("");
+    setFrom("");
+    setTo("");
+    setQuietBusy(true);
+    setQuietNotice("");
+    setQuietError(false);
+    try {
+      const saved = await setOwnedRoomQuietHoursDefault(token, replicaId, { timezone: null, quietFrom: null, quietTo: null });
+      setRelations((prev) => (prev ? { ...prev, quiet_hours_default: saved } : prev));
+      setQuietNotice(c.quietHoursSaved);
+    } catch (cause) {
+      if (isAuthError(cause)) return auth.current(cause);
+      setQuietError(true);
+    } finally {
+      setQuietBusy(false);
+    }
+  }, [token, replicaId, c.quietHoursSaved]);
+
+  const toggleDesign = useCallback(async (design: CheckinDesign) => {
+    setDesignBusy(design.design_id);
+    try {
+      const next = design.state === "active" ? "paused" : "active";
+      const updated = await setCheckinDesignState(token, replicaId, design.design_id, next);
+      setDesigns((prev) => (prev ? prev.map((d) => (d.design_id === updated.design_id ? updated : d)) : prev));
+    } catch (cause) {
+      if (isAuthError(cause)) return auth.current(cause);
+    } finally {
+      setDesignBusy(null);
+    }
+  }, [token, replicaId]);
+
+  // No Room yet: nothing to show — `DeployStudio.tsx`'s own `visitorLink`
+  // null-until-published precedent, one step earlier (null until a Room
+  // ROW exists at all, not merely until it publishes).
+  if (loaded && !relations && !loadError) return null;
+
+  return (
+    <section className="vx-relations" aria-labelledby="relations-title">
+      <div className="vx-stage-title">
+        <h2 id="relations-title">{c.title}</h2>
+        <p className="field-note">{c.intro}</p>
+      </div>
+
+      {!loaded ? (
+        <p className="field-note" role="status">{c.loading}</p>
+      ) : loadError ? (
+        <p className="field-note">{c.errorGeneric}</p>
+      ) : relations ? (
+        <>
+          <article className="vx-relations-card">
+            <h3>{c.stageTitle}</h3>
+            {relations.stage_counts.length === 0 ? (
+              <p className="field-note">{c.stageNone}</p>
+            ) : (
+              <ul className="vx-relations-list">
+                {STAGE_KEYS.map((stage) => {
+                  const bucket = relations.stage_counts.find((b) => b.stage === stage);
+                  if (!bucket) return null;
+                  return (
+                    <li key={stage} className="vx-relations-row">
+                      <span>{c.stageWords[stage]}</span>
+                      <span className="vx-relations-value">{bucket.n}</span>
+                    </li>
+                  );
+                })}
+              </ul>
+            )}
+            <p className="field-note">{c.stageFloorNote}</p>
+          </article>
+
+          <article className="vx-relations-card">
+            <ul className="vx-relations-list">
+              <li className="vx-relations-row">
+                <span>{c.peopleWeekLabel}</span>
+                <span className="vx-relations-value">
+                  {relations.people_this_week.below_floor ? c.fewerThanFive : relations.people_this_week.n}
+                </span>
+              </li>
+              <li className="vx-relations-row">
+                <span>{c.peopleMonthLabel}</span>
+                <span className="vx-relations-value">
+                  {relations.people_this_month.below_floor ? c.fewerThanFive : relations.people_this_month.n}
+                </span>
+              </li>
+              <li className="vx-relations-row">
+                <span>{c.checkinsSentLabel}</span>
+                <span className="vx-relations-value">{relations.checkins_sent_this_week}</span>
+              </li>
+              <li className="vx-relations-row">
+                <span>{c.handoffsWaitingLabel}</span>
+                <span className="vx-relations-value">{relations.handoffs_waiting}</span>
+              </li>
+            </ul>
+          </article>
+
+          <article className="vx-relations-card">
+            <h3>{c.pauseTitle} {relations.paused && <span className="vx-relations-badge">{c.pausedBadge}</span>}</h3>
+            <p className="field-note">{c.pauseBody}</p>
+            <button type="button" className="button secondary-button" onPointerDown={togglePause} disabled={pauseBusy}>
+              {relations.paused ? c.resumeAction : c.pauseAction}
+            </button>
+          </article>
+
+          <article className="vx-relations-card">
+            <h3>{c.quietHoursTitle}</h3>
+            <p className="field-note">{c.quietHoursBody}</p>
+            <div className="vx-relations-quiet-fields">
+              <label>
+                {c.quietHoursTimezoneLabel}
+                <input
+                  type="text"
+                  value={tz}
+                  placeholder={c.quietHoursTimezonePlaceholder}
+                  onChange={(e) => setTz(e.target.value)}
+                />
+              </label>
+              <label>
+                {c.quietHoursFromLabel}
+                <input type="time" value={from} onChange={(e) => setFrom(e.target.value)} />
+              </label>
+              <label>
+                {c.quietHoursToLabel}
+                <input type="time" value={to} onChange={(e) => setTo(e.target.value)} />
+              </label>
+            </div>
+            {quietError && <p className="field-note vx-relations-error">{c.quietHoursInvalid}</p>}
+            {quietNotice && !quietError && <p className="field-note" role="status">{quietNotice}</p>}
+            <div className="vx-relations-quiet-actions">
+              <button type="button" className="button secondary-button" onPointerDown={saveQuietHours} disabled={quietBusy}>
+                {c.quietHoursSave}
+              </button>
+              <button type="button" className="button secondary-button" onPointerDown={clearQuietHours} disabled={quietBusy}>
+                {c.quietHoursClear}
+              </button>
+            </div>
+          </article>
+
+          <article className="vx-relations-card">
+            <h3>{c.checkinKindsTitle}</h3>
+            <p className="field-note">{c.checkinKindsBody}</p>
+            {!designsLoaded ? (
+              <p className="field-note" role="status">{c.checkinKindsLoading}</p>
+            ) : !designs || designs.length === 0 ? (
+              <p className="field-note">{c.checkinKindsEmpty}</p>
+            ) : (
+              <ul className="vx-relations-list">
+                {designs.map((design) => (
+                  <li key={design.design_id} className="vx-relations-row">
+                    <span>
+                      {design.title}
+                      {design.state === "paused" && <span className="vx-relations-badge">{c.checkinKindsPaused}</span>}
+                    </span>
+                    <button
+                      type="button"
+                      className="button secondary-button"
+                      onPointerDown={() => toggleDesign(design)}
+                      disabled={designBusy === design.design_id}
+                    >
+                      {design.state === "active" ? c.checkinKindsPause : c.checkinKindsResume}
+                    </button>
+                  </li>
+                ))}
+              </ul>
+            )}
+          </article>
+        </>
+      ) : null}
+    </section>
+  );
+}
