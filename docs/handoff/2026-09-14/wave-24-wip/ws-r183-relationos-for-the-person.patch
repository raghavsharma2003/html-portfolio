--- /dev/null
+++ b/src/studio/relations-studio.css
@@ -0,0 +1,106 @@
+/* relations-studio.css — WS-R183 ("RelationOS for the person"). Scoped to
+ * `.vx-relations` only, `deploy-studio.css`'s own precedent: this screen is
+ * mounted inside `DeployStudio.tsx`, which already loads its own CSS the
+ * same way (imported directly, not inherited from a sibling panel's load
+ * order), so this file styles nothing outside its own prefix. */
+@layer components {
+  .vx-relations {
+    max-width: 860px;
+    width: 100%;
+    margin-inline: auto;
+    margin-top: var(--space-section, 48px);
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-block, 24px);
+  }
+
+  .vx-relations-card {
+    padding: var(--space-item, 16px) var(--space-block, 24px);
+    border-radius: var(--radius, 20px);
+    border: 1px solid var(--line, rgba(28, 32, 26, 0.12));
+    background: var(--panel-solid, #fffef9);
+  }
+
+  .vx-relations-card h3 {
+    font-size: var(--text-lead, 16px);
+    font-weight: var(--weight-medium, 600);
+    line-height: var(--leading-snug, 1.45);
+    margin: 0 0 var(--space-hair, 4px);
+    color: var(--ink, #171915);
+  }
+
+  .vx-relations-card .field-note {
+    margin: 0 0 var(--space-item, 16px);
+    color: var(--ink-soft, #52564e);
+  }
+
+  .vx-relations-list {
+    list-style: none;
+    margin: 0 0 var(--space-item, 16px);
+    padding: 0;
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-hair, 4px);
+  }
+
+  .vx-relations-row {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: var(--space-item, 16px);
+    padding-block: var(--space-hair, 4px);
+    flex-wrap: wrap;
+  }
+
+  .vx-relations-value {
+    font-weight: var(--weight-medium, 600);
+    color: var(--ink, #171915);
+  }
+
+  .vx-relations-badge {
+    display: inline-block;
+    margin-left: var(--space-hair, 4px);
+    padding: 2px 8px;
+    border-radius: 999px;
+    font-size: 12px;
+    background: var(--signal-soft, #fce9df);
+    color: var(--ink, #171915);
+  }
+
+  .vx-relations-quiet-fields {
+    display: flex;
+    flex-wrap: wrap;
+    gap: var(--space-item, 16px);
+    margin-bottom: var(--space-item, 16px);
+  }
+
+  .vx-relations-quiet-fields label {
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-hair, 4px);
+    font-size: 13px;
+    color: var(--ink-soft, #52564e);
+    flex: 1 1 140px;
+    min-width: 0;
+  }
+
+  .vx-relations-quiet-fields input {
+    padding: 8px 10px;
+    border-radius: 10px;
+    border: 1px solid var(--line, rgba(28, 32, 26, 0.12));
+    background: var(--paper, #fff);
+    color: var(--ink, #171915);
+    font-size: 14px;
+    max-width: 100%;
+  }
+
+  .vx-relations-quiet-actions {
+    display: flex;
+    flex-wrap: wrap;
+    gap: var(--space-item, 16px);
+  }
+
+  .vx-relations-error {
+    color: var(--danger, #a4302c);
+  }
+}
