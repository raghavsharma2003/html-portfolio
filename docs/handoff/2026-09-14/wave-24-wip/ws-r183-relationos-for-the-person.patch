+}
+
+function makeDb(state) {
+  return async (sql, params = []) => {
+    const p = (params || []).map((v) => (v == null ? null : String(v)));
+
+    if (sql.includes("from vy_room") && sql.includes("limit 1") && sql.includes("owner_user_id = ($1)::uuid and replica_id")) {
+      const [ownerId, replicaId] = p;
+      const r = state.rooms.find((x) => x.owner_user_id === ownerId && x.replica_id === replicaId);
+      return r ? [{ ...r }] : [];
+    }
+
+    // roomRelStateStageCounts's own aggregate — agent_id ALONE, never person_id.
+    if (sql.includes("having count(*) >= 5") && sql.includes("from vy_rel_state")) {
+      const [agentId] = p;
+      const buckets = {};
+      for (const row of state.relstate) {
+        if (row.agent_id !== agentId) continue;
+        let stage;
+        if (row.rupture_open) stage = row.trust < 0.45 ? "new" : "warming";
+        else if (row.trust < 0.2) stage = "new";
+        else if (row.trust < 0.45) stage = "warming";
+        else if (row.trust < 0.7) stage = "settled";
+        else if (row.trust < 0.88) stage = "close";
+        else stage = "deep";
+        buckets[stage] = (buckets[stage] || 0) + 1;
+      }
+      return Object.entries(buckets).filter(([, n]) => n >= 5).map(([stage, n]) => ({ stage, n }));
+    }
+    // the owner-dyad exclusion's two follow-up statements (`_room-relstate.js`) —
+    // this fixture world never seeds an owner's own dyad row, so both are no-ops.
+    if (sql.includes("select p.subject_person_id from vy_replica")) return [];
+    if (sql.includes("from vy_rel_state r") && sql.includes("case")) return [{ n: 0 }];
+
+    if (sql.includes("select\n          count(*) filter") || (sql.includes("week_n") && sql.includes("month_n"))) {
+      const [roomId, weekSince, monthSince] = p;
+      const rows = state.followers.filter((f) => f.room_id === roomId);
+      const weekN = rows.filter((f) => f.last_seen_at >= weekSince).length;
+      const monthN = rows.filter((f) => f.last_seen_at >= monthSince).length;
+      return [{ week_n: weekN, month_n: monthN }];
+    }
+
+    if (sql.includes("from vy_room_checkin_delivery")) {
+      const [roomId, weekSince] = p;
+      const n = state.checkinDeliveries.filter(
+        (d) => d.room_id === roomId && d.state === "delivered" && d.created_at >= weekSince,
+      ).length;
+      return [{ n }];
+    }
+
+    if (sql.includes("from vy_room_handoff")) {
+      const [roomId] = p;
+      const n = state.handoffs.filter((h) => h.room_id === roomId && h.state === "sent").length;
+      return [{ n }];
+    }
+
+    if (sql.includes("select timezone, quiet_from, quiet_to from vy_room where room_id")) {
+      const [roomId] = p;
+      const r = state.rooms.find((x) => x.room_id === roomId);
+      return r ? [{ timezone: r.timezone, quiet_from: r.quiet_from, quiet_to: r.quiet_to }] : [];
+    }
+
+    if (sql.includes("set timezone = $3")) {
+      const [ownerId, replicaId, tz, qf, qt] = p;
+      const r = state.rooms.find((x) => x.owner_user_id === ownerId && x.replica_id === replicaId);
+      if (!r) return [];
+      r.timezone = tz === "null" ? null : params[2];
+      r.quiet_from = params[3];
+      r.quiet_to = params[4];
+      return [{ timezone: r.timezone, quiet_from: r.quiet_from, quiet_to: r.quiet_to }];
+    }
+
+    throw new Error(`relations-studio fake db: unmodelled statement: ${sql.slice(0, 120)}`);
+  };
+}
+
+// ═════════════════════════════════════════════════════════════════════════
+console.log("── §1: ownerRoomRelations — stage delegation, floors, scoping ──");
+// ═════════════════════════════════════════════════════════════════════════
+{
+  const state = freshState();
+  const db = makeDb(state);
+
+  // Seed OWNER's own agent with 6 "deep" (trust >= 0.88) dyads — clears the
+  // floor — and 3 "new" dyads — under it.
+  for (let i = 0; i < 6; i++) state.relstate.push({ agent_id: AGENT, person_id: `p-deep-${i}`, trust: 0.95, rupture_open: false });
+  for (let i = 0; i < 3; i++) state.relstate.push({ agent_id: AGENT, person_id: `p-new-${i}`, trust: 0.05, rupture_open: false });
+
+  const result = await ownerRoomRelations(db, OWNER, REPLICA, { now: NOW });
+  ok("ownerRoomRelations returns a result for the real owner", result !== null);
+  ok("the 6-strong deep bucket clears the floor and reports exactly 6", result.stage_counts.find((b) => b.stage === "deep")?.n === 6);
+  ok("NEGATIVE CONTROL: the 3-strong new bucket is under the floor and is completely ABSENT (never a raw 3)",
+    result.stage_counts.every((b) => b.stage !== "new"));
+
+  ok("checkins_sent_this_week/handoffs_waiting start at 0 with no fixture rows seeded", result.checkins_sent_this_week === 0 && result.handoffs_waiting === 0);
+  ok("quiet_hours_default is null/null/null with nothing set yet",
+    result.quiet_hours_default.timezone === null && result.quiet_hours_default.quiet_from === null && result.quiet_hours_default.quiet_to === null);
+  ok("paused reads false for a published, unpaused Room", result.paused === false);
+
+  ok("NEGATIVE CONTROL: a stranger owner's id against ANOTHER owner's replica_id gets null, never that owner's counts",
+    await ownerRoomRelations(db, OWNER_B, REPLICA, { now: NOW }) === null);
+  ok("NEGATIVE CONTROL: an owner's own id against a replica that does not exist gets null",
+    await ownerRoomRelations(db, OWNER, "c1000000-0000-4000-8000-0000000000ff", { now: NOW }) === null);
+}
+
+// ═════════════════════════════════════════════════════════════════════════
+console.log("\n── §2: people-this-week/month — floored at n>=5, unfloored operational counts ──");
+// ═════════════════════════════════════════════════════════════════════════
+{
+  const state = freshState();
+  const db = makeDb(state);
+  const weekAgoIso = new Date(NOW - WEEK_MS + 3600_000).toISOString(); // inside the week window
+  const overAWeekAgoIso = new Date(NOW - WEEK_MS - 3600_000).toISOString(); // just outside it
+
+  // 4 followers active this week — UNDER the n>=5 floor.
+  for (let i = 0; i < 4; i++) state.followers.push({ room_id: state.rooms[0].room_id, last_seen_at: weekAgoIso });
+  // 2 more, active only within the month (not the week).
+  for (let i = 0; i < 2; i++) state.followers.push({ room_id: state.rooms[0].room_id, last_seen_at: overAWeekAgoIso });
+
+  state.checkinDeliveries.push(
+    { room_id: state.rooms[0].room_id, state: "delivered", created_at: weekAgoIso },
+    { room_id: state.rooms[0].room_id, state: "delivered", created_at: weekAgoIso },
+  );
+  state.handoffs.push({ room_id: state.rooms[0].room_id, state: "sent" });
+
+  const under = await ownerRoomRelations(db, OWNER, REPLICA, { now: NOW });
+  ok("NEGATIVE CONTROL: 4 people this week is UNDER the floor — n is null, below_floor is true, never a raw 4",
+    under.people_this_week.n === null && under.people_this_week.below_floor === true);
+  ok("6 people this month (4 + 2) clears the floor and reports exactly 6",
+    under.people_this_month.n === 6 && under.people_this_month.below_floor === false);
+  ok("checkins_sent_this_week is a raw, UNFLOORED count (2, under the people floor, still reported)", under.checkins_sent_this_week === 2);
+  ok("handoffs_waiting is a raw, UNFLOORED count (1)", under.handoffs_waiting === 1);
+
+  // A 5th follower this week clears the floor.
+  state.followers.push({ room_id: state.rooms[0].room_id, last_seen_at: weekAgoIso });
+  const cleared = await ownerRoomRelations(db, OWNER, REPLICA, { now: NOW });
+  ok("5 people this week clears the floor and reports exactly 5", cleared.people_this_week.n === 5 && cleared.people_this_week.below_floor === false);
+}
+
+// ═════════════════════════════════════════════════════════════════════════
+console.log("\n── §3: setRoomQuietHoursDefault — validation, write, scoping ──");
+// ═════════════════════════════════════════════════════════════════════════
+{
+  const state = freshState();
+  const db = makeDb(state);
+
+  async function throws(fn) {
+    try { await fn(); return null; } catch (e) { return e; }
+  }
+
+  const mismatched = await throws(() => setRoomQuietHoursDefault(db, OWNER, REPLICA, { timezone: "Asia/Kolkata", quietFrom: "22:00", quietTo: null }));
+  ok("NEGATIVE CONTROL: quiet_from set with no quiet_to is refused (room_quiet_hours_invalid)",
+    mismatched instanceof RoomPublishError && mismatched.code === "room_quiet_hours_invalid");
+
+  const badShape = await throws(() => setRoomQuietHoursDefault(db, OWNER, REPLICA, { timezone: "Asia/Kolkata", quietFrom: "25:99", quietTo: "07:00" }));
+  ok("NEGATIVE CONTROL: a malformed time (25:99) is refused", badShape instanceof RoomPublishError && badShape.code === "room_quiet_hours_invalid");
+
+  const sameTime = await throws(() => setRoomQuietHoursDefault(db, OWNER, REPLICA, { timezone: "Asia/Kolkata", quietFrom: "22:00", quietTo: "22:00" }));
+  ok("NEGATIVE CONTROL: an identical from/to (a zero-width window) is refused", sameTime instanceof RoomPublishError && sameTime.code === "room_quiet_hours_invalid");
+
+  const noTz = await throws(() => setRoomQuietHoursDefault(db, OWNER, REPLICA, { timezone: null, quietFrom: "22:00", quietTo: "07:00" }));
+  ok("NEGATIVE CONTROL: a window with no time zone to read it in is refused", noTz instanceof RoomPublishError && noTz.code === "room_timezone_invalid");
+
+  const badTz = await throws(() => setRoomQuietHoursDefault(db, OWNER, REPLICA, { timezone: "Not/AZone", quietFrom: "22:00", quietTo: "07:00" }));
+  ok("NEGATIVE CONTROL: an unrecognised time zone name is refused", badTz instanceof RoomPublishError && badTz.code === "room_timezone_invalid");
+
+  const saved = await setRoomQuietHoursDefault(db, OWNER, REPLICA, { timezone: "Asia/Kolkata", quietFrom: "22:00", quietTo: "07:00" });
+  ok("a valid window is written and read back exactly", saved.timezone === "Asia/Kolkata" && saved.quiet_from === "22:00" && saved.quiet_to === "07:00");
+
+  const cleared = await setRoomQuietHoursDefault(db, OWNER, REPLICA, { timezone: null, quietFrom: null, quietTo: null });
+  ok("all-null clears the default cleanly", cleared.timezone === null && cleared.quiet_from === null && cleared.quiet_to === null);
+
+  const stolen = await setRoomQuietHoursDefault(db, OWNER_B, REPLICA, { timezone: "Asia/Kolkata", quietFrom: "22:00", quietTo: "07:00" });
+  ok("NEGATIVE CONTROL: a DIFFERENT owner's bearer against OWNER's own replica_id gets null, never a write", stolen === null);
+  ok("OWNER's own room is UNCHANGED by OWNER_B's attempt", state.rooms[0].timezone === null);
+}
