diff --git a/src/creatorStudio/roomPublishApi.ts b/src/creatorStudio/roomPublishApi.ts
index bdc75db..2d1b441 100644
--- a/src/creatorStudio/roomPublishApi.ts
+++ b/src/creatorStudio/roomPublishApi.ts
@@ -352,3 +352,72 @@ export function firstRoomBlocker(blockers: RoomBlockers | null): { label: string
   if (us) return { label: us.headline, anchor: us.anchor, cls: "us" };
   return null;
 }
+
+// ─────────────────────────────────────────────────────────────────────────
+// WS-R183 ("RelationOS for the person"). Op "relations" and
+// "set_quiet_hours_default" — `roomCohortsApi.ts`'s own `RoomRelStage`
+// mirrored here (a string union rather than an import, that file's own
+// header on why: this studio's TS build never imports `api/`).
+// ─────────────────────────────────────────────────────────────────────────
+
+export type RoomRelStage = "new" | "warming" | "settled" | "close" | "deep";
+
+export interface RoomRelStageCount {
+  stage: RoomRelStage;
+  n: number;
+}
+
+/** `n` is `null` whenever the raw count is under the floor — never a
+ *  rounded or partial number, `friends_brought_this_week`'s own shape one
+ *  interface up. */
+export interface RoomFloorCount {
+  n: number | null;
+  below_floor: boolean;
+}
+
+export interface RoomQuietHoursDefault {
+  timezone: string | null;
+  quiet_from: string | null;
+  quiet_to: string | null;
+}
+
+export interface RoomRelations {
+  // n>=5 floored server side (`api/_room-relstate.js`'s own
+  // `roomRelStateStageCounts`) — a bucket below the floor is simply ABSENT
+  // from this array, never a zero or a rounded number.
+  stage_counts: RoomRelStageCount[];
+  people_this_week: RoomFloorCount;
+  people_this_month: RoomFloorCount;
+  // Operational counts about the AI's OWN activity, never floored — the
+  // same unfloored shape `RoomStats.messages_this_month` already carries.
+  checkins_sent_this_week: number;
+  handoffs_waiting: number;
+  quiet_hours_default: RoomQuietHoursDefault;
+  paused: boolean;
+}
+
+export async function readOwnedRoomRelations(token: string, replicaId: string): Promise<RoomRelations | null> {
+  try {
+    return await call<RoomRelations>(token, { op: "relations", replica_id: replicaId });
+  } catch (e: any) {
+    if (e?.status === 404) return null;
+    throw e;
+  }
+}
+
+/** `timezone: null, quietFrom: null, quietTo: null` clears the default —
+ *  `roomSetQuietHours`'s own follower-level contract, mirrored for the
+ *  owner door (`api/_room-publish.js`'s `setRoomQuietHoursDefault`). */
+export async function setOwnedRoomQuietHoursDefault(
+  token: string,
+  replicaId: string,
+  fields: { timezone: string | null; quietFrom: string | null; quietTo: string | null },
+): Promise<RoomQuietHoursDefault> {
+  return call<RoomQuietHoursDefault>(token, {
+    op: "set_quiet_hours_default",
+    replica_id: replicaId,
+    timezone: fields.timezone,
+    quiet_from: fields.quietFrom,
+    quiet_to: fields.quietTo,
+  });
+}
