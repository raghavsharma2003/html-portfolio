+// ═════════════════════════════════════════════════════════════════════════
+console.log("\n── §4: quietHoursOkForRoomDefaultSql — the fragment, marker and math ──");
+// ═════════════════════════════════════════════════════════════════════════
+{
+  const frag = quietHoursOkForRoomDefaultSql("r", 1);
+  ok("carries the shared quiet-hours marker (`evals/quiet-hours/run.mjs`'s own scan hook)", frag.includes(QUIET_HOURS_MARKER));
+  ok("reads the room alias's own three columns, never a follower's", /r\.quiet_from/.test(frag) && /r\.quiet_to/.test(frag) && /r\.timezone/.test(frag));
