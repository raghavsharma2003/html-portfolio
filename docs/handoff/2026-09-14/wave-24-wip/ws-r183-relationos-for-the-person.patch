+// evals/relations-studio/run.mjs — WS-R183, "RelationOS for the person".
+//
+//   node evals/relations-studio/run.mjs
+//
+// Offline, deterministic, $0, no DB, no network, no browser. Drives the REAL
+// `api/_room-publish.js#ownerRoomRelations`/`setRoomQuietHoursDefault`
+// through a fake `db`, and the REAL `api/_quiet-hours.js#
+// quietHoursOkForRoomDefaultSql`, so the code path a browser reaches is the
+// code path this suite reaches — `evals/room-publish/run.mjs`'s own header,
+// restated for this workstream's two new ops.
+//
+// ── what this suite is actually guarding ──────────────────────────────────
+//
+// 1. STAGE COUNTS ARE DELEGATED, NEVER RE-DERIVED. `ownerRoomRelations` calls
+//    the SAME `roomRelStateStageCounts` the creator's ops board already
+//    uses — the n>=5 floor and the owner-dyad exclusion are proven once,
+//    over there (`evals/room-relstate/run.mjs`, `evals/room-leak/run.mjs`'s
+//    own layer 19); this suite only proves the DELEGATION, not the floor
+//    math a second time.
+// 2. PEOPLE-THIS-WEEK/MONTH ARE FLOORED AT n>=5, WITH A NEGATIVE CONTROL: a
+//    fixture with exactly 4 active-this-week followers reports `n: null,
+//    below_floor: true`, never a raw 4 — and a fixture with 5 reports the
+//    real number.
+// 3. CHECK-INS SENT AND HANDOFFS WAITING ARE NEVER FLOORED — the workstream
+//    brief's own distinction (operational counts about the AI's own
+//    activity, not about which followers hold a property), proven with a
+//    fixture count of 2 (under the people floor) surviving unfloored.
+// 4. OWNERSHIP SCOPING: a stranger owner's id against another owner's
+//    replica_id gets `null` — never that owner's counts — for BOTH new ops.
+// 5. THE QUIET-HOURS DEFAULT WRITE validates exactly like the follower-level
+//    `roomSetQuietHours` it mirrors: both-or-neither on the time pair, a
+//    real time shape, a real (probe-checked) time zone, and clears cleanly.
+// 6. THE COPY GATE, on the real files this workstream wrote, imported
+//    directly from `scripts/check-copy.mjs` — `evals/deploy-studio/run.mjs`'s
+//    own §4, restated for this screen's two new files.
+// 7. THE FLOOR IS HONEST ON SCREEN: `RelationsStudio.tsx`'s own source never
+//    renders `people_this_week.n`/`people_this_month.n` without its
+//    `below_floor` guard — a source-level property check, `evals/deploy-
+//    studio/run.mjs`'s own "no fork" §5 restated for a rendering rule
+//    instead of an import.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { scanSource } from "../../scripts/check-copy.mjs";
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const REPO = join(HERE, "..", "..");
+const STUDIO_DIR = join(REPO, "src/studio");
+
+let pass = 0;
+let fail = 0;
+const ok = (name, cond, extra = "") => {
+  if (cond) pass++;
+  else fail++;
+  console.log(`${cond ? "  ok  " : "FAIL  "}${name}${extra ? `   ${extra}` : ""}`);
+};
+
+const ROOM_PUBLISH = await import(pathToFileURL(join(REPO, "api/_room-publish.js")).href);
+const { ownerRoomRelations, setRoomQuietHoursDefault, RoomPublishError } = ROOM_PUBLISH;
+const QUIET_HOURS = await import(pathToFileURL(join(REPO, "api/_quiet-hours.js")).href);
+const { quietHoursOkForRoomDefaultSql, QUIET_HOURS_MARKER, isQuietHoursOk } = QUIET_HOURS;
+
+// ── the fixture world ───────────────────────────────────────────────────
+const OWNER = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa";
+const OWNER_B = "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb";
+const REPLICA = "c1000000-0000-4000-8000-000000000001";
+const AGENT = "b1000000-0000-4000-8000-000000000001";
+const REPLICA_B = "c1000000-0000-4000-8000-000000000002";
+const AGENT_B = "b1000000-0000-4000-8000-000000000002";
+const NOW = Date.parse("2026-09-14T12:00:00Z");
+const WEEK_MS = 7 * 24 * 60 * 60 * 1000;
+
+function freshState() {
+  return {
+    rooms: [
+      {
+        room_id: "d1000000-0000-4000-8000-000000000001", slug: "arjun", replica_id: REPLICA, agent_id: AGENT,
+        owner_user_id: OWNER, display_name: "Arjun", free_monthly_messages: 20,
+        paid_monthly_messages: 400, paid_monthly_voice_seconds: 600, default_locale: "en",
+        dormancy_days: null, listed_at: null, one_line_bio: "", taste_enabled: false,
+        published_at: "2026-09-01T00:00:00Z", paused_at: null,
+        created_at: "2026-09-01T00:00:00Z", updated_at: "2026-09-01T00:00:00Z",
+        timezone: null, quiet_from: null, quiet_to: null,
+      },
+      {
+        room_id: "d1000000-0000-4000-8000-000000000002", slug: "priya", replica_id: REPLICA_B, agent_id: AGENT_B,
+        owner_user_id: OWNER_B, display_name: "Priya", free_monthly_messages: 20,
+        paid_monthly_messages: 400, paid_monthly_voice_seconds: 600, default_locale: "en",
+        dormancy_days: null, listed_at: null, one_line_bio: "", taste_enabled: false,
+        published_at: "2026-09-01T00:00:00Z", paused_at: null,
+        created_at: "2026-09-01T00:00:00Z", updated_at: "2026-09-01T00:00:00Z",
+        timezone: null, quiet_from: null, quiet_to: null,
