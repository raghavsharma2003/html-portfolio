+ from vy_replica r
+ join meera_log l on l.agent_id=r.agent_id
+ where r.lifecycle not in ('revoked','purging') and r.subject_mode='self'
+ and r.agent_id is not null and r.subject_person_id is not null
+ and exists(select 1 from vy_replica_consent x where x.replica_id=r.replica_id and x.owner_user_id=r.owner_user_id
+   and x.scope='memory' and x.revoked_at is null and (x.expires_at is null or x.expires_at>now()))
