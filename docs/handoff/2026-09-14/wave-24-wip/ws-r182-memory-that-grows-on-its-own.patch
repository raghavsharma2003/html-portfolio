+     where x.replica_id=r.replica_id and x.owner_user_id=r.owner_user_id
+       and x.scope='memory' and x.revoked_at is not null),'-infinity'::timestamptz)
+ and exists(select 1 from vy_person_device d where d.device_id=l.device_id and d.person_id=r.subject_person_id)
+ group by r.replica_id,r.agent_id,r.owner_user_id,r.subject_person_id
+ order by oldest_pending_at limit $1`;
