diff --git a/src/studio/MyDataStudio.tsx b/src/studio/MyDataStudio.tsx
new file mode 100644
index 0000000..7fb7947
--- /dev/null
+++ b/src/studio/MyDataStudio.tsx
@@ -0,0 +1,234 @@
+// WS-R189. "My data, in one place." The person's own export door
+// (`api/_creator-export.js#personExport`, over `api/replica.js`'s SAME
+// "export" op, `view: "person"` — never a second door) rendered in the
+// studio, plus the studio's own real erasure entry point ("the same place
+// the account controls live" — this workstream's own brief's words; the
+// only PRIOR erasure button in this tree lived in `StudioApp.tsx`'s
+// self-test-only `ReplicaWorkspace`, unreachable in the live product,
+// `CloneExperience.tsx`'s own `WorkspaceDrawer` "Delete this clone" being
+// the one that actually ships — this screen is a second, equally real
+// entry point onto the SAME `onRevoke`-shaped door, in the place a person
+// looking for "my data" would look first).
+//
+// A pure data screen: reads `personExport`'s own eight named sections
+// (counts only — this screen never renders a follower's or a relationship's
+// own words, `api/_creator-export.js`'s own boundary law restated at the UI
+// layer), offers the machine-readable JSON as a download and the readable
+// page as a printable tab (`src/room/AccountPage.tsx#openReadable`'s own
+// `window.open` + `document.write` pattern, restated for this door), and —
+// once erasure starts — degrades to the receipt-only view `personExport`
+// itself already returns, never a client-side guess at what was deleted.
+import { useCallback, useEffect, useRef, useState } from "react";
+import { ReplicaApiError, readPersonExport, readPersonExportHtml, revokeReplica } from "./replicaApi";
+import type { PersonExportResult } from "./types";
+import { useStudioLocale } from "./localeContext";
+
+const ERASURE_REQUEST_KEY = "vyakti.myData.erasure-request.v1";
+function storageKey(replicaId: string) {
+  return `${ERASURE_REQUEST_KEY}:${replicaId}`;
+}
+function storedErasureRequest(replicaId: string) {
+  try {
+    return localStorage.getItem(storageKey(replicaId)) || "";
+  } catch {
+    return "";
+  }
+}
+
+type Props = {
+  token: string;
+  replicaId: string;
+  onAuthError: (cause: unknown) => void;
+  /** Called once erasure is really started (the real door answered 200) —
+   *  the shell's own chance to reflect the same "no clone left" state the
+   *  drawer's own `onDelete` path already reaches, never a second source of
+   *  truth for whether a clone still exists. */
+  onErased?: () => void;
+};
+
+export default function MyDataStudio(props: Props) {
+  return <ScopedMyDataStudio key={`${props.replicaId}:${props.token}`} {...props} />;
+}
+
+function ScopedMyDataStudio({ token, replicaId, onAuthError, onErased }: Props) {
+  const { t, locale } = useStudioLocale();
+  const copy = t.myDataStudio;
+  const mounted = useRef(false);
+  useEffect(() => {
+    mounted.current = true;
+    return () => { mounted.current = false; };
+  }, []);
+
+  const [erasureRequestId, setErasureRequestId] = useState<string>(() => storedErasureRequest(replicaId));
+  const [data, setData] = useState<PersonExportResult | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+  const [confirming, setConfirming] = useState(false);
+  const [confirmText, setConfirmText] = useState("");
+  const [erasing, setErasing] = useState(false);
+  const [eraseError, setEraseError] = useState("");
+
+  const load = useCallback(async () => {
+    setError("");
+    try {
+      const result = await readPersonExport(token, erasureRequestId || null);
+      if (!mounted.current) return;
+      setData(result);
+    } catch (cause) {
+      if (!mounted.current) return;
+      if (cause instanceof ReplicaApiError && cause.status === 401) return onAuthError(cause);
+      setError(cause instanceof Error ? cause.message : copy.loadError);
+    } finally {
+      if (mounted.current) setLoading(false);
+    }
+  }, [token, erasureRequestId, onAuthError, copy.loadError]);
+
+  useEffect(() => {
+    setLoading(true);
+    void load();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [token, replicaId]);
+
+  // While an erasure is known to be running and has not yet resolved to a
+  // receipt, poll — `StudioApp.tsx`'s own erasure-status poll restated for
+  // this screen's own read, never a second job or a second poll mechanism
+  // for the SAME one.
+  useEffect(() => {
+    if (!erasureRequestId || data?.receipt) return;
+    const timer = window.setInterval(() => { void load(); }, 4000);
+    return () => window.clearInterval(timer);
+  }, [erasureRequestId, data?.receipt, load]);
+
+  const startErase = useCallback(async () => {
+    setErasing(true);
+    setEraseError("");
+    try {
+      const result = await revokeReplica(token, replicaId);
+      if (!mounted.current) return;
+      setErasureRequestId(result.erasure_request_id);
+      try { localStorage.setItem(storageKey(replicaId), result.erasure_request_id); } catch { /* best effort — the server's own job still exists either way */ }
+      setConfirming(false);
+      setConfirmText("");
+      onErased?.();
+    } catch (cause) {
+      if (!mounted.current) return;
+      if (cause instanceof ReplicaApiError && cause.status === 401) return onAuthError(cause);
+      setEraseError(cause instanceof Error ? cause.message : copy.eraseError);
+    } finally {
+      if (mounted.current) setErasing(false);
+    }
+  }, [token, replicaId, onAuthError, onErased, copy.eraseError]);
+
+  const downloadJson = useCallback(() => {
+    if (!data) return;
+    try {
+      const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+      const url = URL.createObjectURL(blob);
+      const anchor = document.createElement("a");
+      anchor.href = url;
+      anchor.download = "my-data.json";
+      document.body.appendChild(anchor);
+      anchor.click();
+      anchor.remove();
+      URL.revokeObjectURL(url);
+    } catch { /* best effort — every section is still readable on this screen */ }
+  }, [data]);
+
+  const viewPrintable = useCallback(async () => {
+    try {
+      const html = await readPersonExportHtml(token, erasureRequestId || null, locale === "hi" ? "hi" : "en");
+      const win = window.open("", "_blank");
+      if (!win) return;
+      win.document.open();
+      win.document.write(html);
+      win.document.close();
+    } catch (cause) {
+      if (cause instanceof ReplicaApiError && cause.status === 401) onAuthError(cause);
+    }
+  }, [token, erasureRequestId, locale, onAuthError]);
+
+  if (loading && !data) {
+    return (
+      <section className="mydata-studio" aria-busy="true">
+        <p role="status">{copy.loading}</p>
+      </section>
+    );
+  }
+
+  if (error && !data) {
+    return (
+      <section className="mydata-studio">
+        <p role="alert">{error}</p>
+        <button type="button" onClick={() => { setLoading(true); void load(); }}>{copy.retry}</button>
+      </section>
+    );
+  }
+
+  if (!data) return null;
+
+  if (data.receipt) {
+    const complete = data.receipt.state === "complete";
+    return (
+      <section className="mydata-studio mydata-studio--receipt">
+        <h1 id="mydata-title">{complete ? copy.eraseCompleteTitle : copy.eraseInProgressTitle}</h1>
+        <p>{complete ? copy.eraseCompleteBody : copy.eraseInProgressBody}</p>
+        {data.receipt.deleted_classes.length > 0 && (
+          <div className="mydata-section">
+            <p className="mydata-section__label">{copy.receiptDeletedClassesLabel}</p>
+            <ul>{data.receipt.deleted_classes.map((deletedClass) => <li key={deletedClass}>{deletedClass.replaceAll("_", " ")}</li>)}</ul>
+          </div>
+        )}
+      </section>
+    );
+  }
+
+  return (
+    <section className="mydata-studio">
+      <h1 id="mydata-title">{copy.heading}</h1>
+      <p className="mydata-intro">{copy.intro}</p>
+      <div className="mydata-actions">
+        <button type="button" onClick={downloadJson}>{copy.downloadJson}</button>
+        <button type="button" onClick={() => void viewPrintable()}>{copy.viewPrintable}</button>
+      </div>
+      {data.sections.map((section) => (
+        <article key={section.key} className="mydata-section">
+          <h2>{copy.sectionTitles[section.key]}</h2>
+          {section.rows.length === 0
+            ? <p className="mydata-empty">{copy.emptySection}</p>
+            : <p className="mydata-count">{copy.recordCountTemplate.replace("{n}", String(section.rows.length)).replace("{s}", section.rows.length === 1 ? "" : "s")}</p>}
+        </article>
+      ))}
+      <section className="mydata-danger" aria-labelledby="mydata-danger-title">
+        <h2 id="mydata-danger-title">{copy.dangerZoneTitle}</h2>
+        <p>{copy.dangerZoneBody}</p>
+        {!confirming ? (
+          <button type="button" className="mydata-danger__button" onClick={() => setConfirming(true)}>{copy.eraseButton}</button>
+        ) : (
+          <div className="mydata-danger__confirm" role="dialog" aria-modal="true" aria-labelledby="mydata-erase-confirm-title">
+            <p id="mydata-erase-confirm-title"><strong>{copy.eraseConfirmPrompt}</strong></p>
+            <p>{copy.eraseConfirmBody}</p>
+            <label htmlFor="mydata-erase-confirm-input">{copy.eraseConfirmType}</label>
+            <input
+              id="mydata-erase-confirm-input"
+              value={confirmText}
+              autoComplete="off"
+              onChange={(event) => setConfirmText(event.target.value.toUpperCase())}
+            />
+            {eraseError && <p role="alert">{eraseError}</p>}
+            <div className="mydata-danger__actions">
+              <button type="button" disabled={erasing} onClick={() => { setConfirming(false); setConfirmText(""); }}>{copy.eraseCancel}</button>
+              <button
+                type="button"
+                className="mydata-danger__button"
+                disabled={erasing || confirmText !== "ERASE"}
+                onClick={() => void startErase()}
+              >
+                {erasing ? copy.erasing : copy.eraseConfirmButton}
+              </button>
+            </div>
+          </div>
+        )}
+      </section>
+    </section>
+  );
+}
