+// WS-R189. "MY DATA, IN ONE PLACE" — THE PERSON-LANE COMPLETENESS BATTERY.
+//
+//   node evals/person-export/run.mjs
+//
+// `personExport` (`api/_creator-export.js`) is the CREATOR'S export door
+// with a person-kind rendering, never a second door — this battery proves
+// three things offline, against the REAL modules, the same discipline
+// `evals/creator-export/run.mjs` already holds `creatorExport` to:
+//
+//   1. NOTHING IS DROPPED. `personExport`'s own `raw` field is byte-for-byte
+//      what `creatorExport` alone returns for the identical input — the
+//      eight-section readable view is an ADDITIVE projection, never a
+//      narrower door.
+//   2. EVERY SECTION MAPS TO SOMETHING REAL. Every section's own `table`
+//      name is either a real `OWNER_LANE_TABLES` entry or one of the two
+//      borrowed owner-facing readers this workstream reuses (`vy_fact` via
+//      `OWNER_MEMORY_FACTS_SQL`, `vy_rel_state` via
+//      `roomRelStateStageCounts`) — never an invented name that could drift
+//      from what the module under test actually reads.
+//   3. THE BOUNDARY LAW STILL HOLDS for the two NEW reads this workstream
+//      adds. A follower's own fact (a different person_id) and a
+//      follower-shaped relationship row never appear anywhere in the
+//      person's own export, even though both live in the SAME tables
+//      (`vy_fact`, `vy_rel_state`) the two borrowed readers query.
+//   4. THE ERASED-OWNER PATH. An owner with zero replicas left and a known
+//      erasure request id gets the receipt and NOTHING else — no stale
+//      section, no raw table content.
+//
+// Offline, deterministic, $0, no DB, no network, no model call.
+import assert from "node:assert/strict";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const REPO = join(HERE, "..", "..");
+
+let pass = 0;
+let fail = 0;
+const ok = (name, cond, extra = "") => {
+  if (cond) pass++;
+  else fail++;
+  console.log(`${cond ? "  ok  " : "FAIL  "}${name}${extra ? `   ${extra}` : ""}`);
+};
+
+const CE = await import(pathToFileURL(join(REPO, "api/_creator-export.js")).href);
+const {
+  creatorExport, creatorExportTableNames, personExport, personExportSections, APPROVED_CLAIMS_SQL,
+} = CE;
+const { OWNER_MEMORY_FACTS_SQL, ownerMemoryAuthority } = await import(
+  pathToFileURL(join(REPO, "api/_room-memory-authority.js")).href
+);
+const { buildPersonExportReadableHtml } = await import(
+  pathToFileURL(join(REPO, "api/_room-export-readable.js")).href
+);
+const { readFileSync } = await import("node:fs");
+
+const OWNER_A = "a0000000-0000-4000-a000-00000000000a";
+const REPLICA_A = "a0000000-0000-4000-a000-00000000001a";
+const AGENT_A = "a0000000-0000-4000-a000-00000000002a";
+const PERSON_A = "a0000000-0000-4000-a000-00000000005a"; // the owner's OWN subject_person_id
+const PERSON_STRANGER = "a0000000-0000-4000-a000-00000000006a"; // a follower's, never the owner's own
+
+// ═════════════════════════════════════════════════════════════════════════
+// LAYER 1/2 — a full, real world through the real personExport, with the
+// two new reads (Meet memory, relationship counts) plus approved claims,
+// and a hostile follower-shaped row sitting next to every one of them.
+// ═════════════════════════════════════════════════════════════════════════
+console.log("── layer 1/2: a real world, the real personExport, a hostile follower-shaped row beside every new read ──");
+
+const FOLLOWER_FACT_TOKEN = "TOK_FOLLOWER_FACT_zzzzzzzz";
+
+function seedWorld() {
+  return {
+    vy_replica: [{ replica_id: REPLICA_A, owner_user_id: OWNER_A, agent_id: AGENT_A }],
+    vy_agent: [{ agent_id: AGENT_A, slug: "a" }],
+    vy_room: [],
+    vy_teacher_sheet: [{ sheet_id: "sheet-a", replica_id: REPLICA_A, owner_user_id: OWNER_A, agent_id: AGENT_A, status: "validated", sheet: { name: "Owner A" } }],
+    vy_replica_source: [{ source_id: "src-a", replica_id: REPLICA_A, owner_user_id: OWNER_A, kind: "document", state: "ready" }],
+    vy_replica_consent: [{ consent_id: "c-a", replica_id: REPLICA_A, owner_user_id: OWNER_A, scope: "memory", policy_version: "v1", granted_at: "2026-01-01T00:00:00Z", revoked_at: null }],
+    vy_replica_generation: [{ generation_id: "g-a", replica_id: REPLICA_A, owner_user_id: OWNER_A, state: "complete" }],
+    vy_replica_calibration: [{ calibration_id: "cal-a", replica_id: REPLICA_A, owner_user_id: OWNER_A, verdict: "own_recording_won" }],
+    vy_creator_payout: [{ payout_id: "p-a", owner_user_id: OWNER_A, gross_inr: 1000 }],
+    vy_creator_charge_event: [{ event_id: "ev-a", replica_id: REPLICA_A, owner_user_id: OWNER_A, amount_inr: 299 }],
+    // claims: one approved (must appear), one proposed and one rejected (must not)
+    vy_replica_claim: [
+      { claim_id: 1, replica_id: REPLICA_A, domain: "identity", key: "name", body: "own approved claim", status: "approved", source_ids: [], confidence: 0.9 },
+      { claim_id: 2, replica_id: REPLICA_A, domain: "identity", key: "name", body: "still proposed", status: "proposed", source_ids: [], confidence: 0.5 },
+      { claim_id: 3, replica_id: REPLICA_A, domain: "identity", key: "name", body: "rejected claim", status: "rejected", source_ids: [], confidence: 0.1 },
+    ],
+    // Meet memory: the owner's own fact (person_id = PERSON_A, agent_id =
+    // AGENT_A) plus a HOSTILE follower-shaped fact on the SAME agent, a
+    // different person_id — the exact shape the boundary law exists to
+    // catch, `evals/creator-export/run.mjs`'s own follower-lane row
+    // pattern restated for the table this workstream newly reads.
+    vy_fact: [
+      { id: 101, person_id: PERSON_A, agent_id: AGENT_A, kind: "user", name: "preference", body: "own memory fact", communication: { state: "classified" } },
+      { id: 102, person_id: PERSON_STRANGER, agent_id: AGENT_A, kind: "user", name: "preference", body: FOLLOWER_FACT_TOKEN, communication: null },
+    ],
+    // relationship: five rows in "warming" (clears the n>=5 floor) plus two
+    // in "deep" (must never appear at all, structurally below the floor —
+    // the exact "COUNTS only, n>=5" law the workstream brief names) plus
+    // the owner's OWN dyad row (agent_id=AGENT_A, person_id=PERSON_A),
+    // which `roomRelStateStageCounts` itself subtracts back out.
+    vy_rel_state: [
+      ...Array.from({ length: 5 }, (_, i) => ({ agent_id: AGENT_A, person_id: `warm-${i}`, trust: 0.3, rupture_open: false })),
+      ...Array.from({ length: 2 }, (_, i) => ({ agent_id: AGENT_A, person_id: `deep-${i}`, trust: 0.95, rupture_open: false })),
+      { agent_id: AGENT_A, person_id: PERSON_A, trust: 0.3, rupture_open: false },
+    ],
+  };
+}
+
+function stageOf(row) {
+  if (row.rupture_open) return row.trust < 0.45 ? "new" : "warming";
+  if (row.trust < 0.2) return "new";
+  if (row.trust < 0.45) return "warming";
+  if (row.trust < 0.7) return "settled";
+  if (row.trust < 0.88) return "close";
+  return "deep";
+}
+
+function fakeDb(state) {
+  return async function db(sql, params) {
+    if (sql === APPROVED_CLAIMS_SQL) {
+      const [replicaIds] = params;
+      return (state.vy_replica_claim || []).filter((c) => replicaIds.includes(c.replica_id) && c.status === "approved");
+    }
+    if (sql === OWNER_MEMORY_FACTS_SQL) {
+      const [replicaId, ownerUserId] = params;
+      const replica = (state.vy_replica || []).find((r) => r.replica_id === replicaId && r.owner_user_id === ownerUserId);
+      if (!replica) return [];
+      return (state.vy_fact || []).filter((f) => f.agent_id === replica.agent_id && f.person_id === replica.subject_person_id);
+    }
+    // roomRelStateStageCounts's own AGGREGATE (having count(*) >= 5, binds
+    // agent_id ALONE — never person_id, `_room-relstate.js`'s own layer-19
+    // law restated).
+    if (sql.includes("having count(*) >= 5")) {
+      const [agentId] = params;
+      const counts = new Map();
+      for (const row of state.vy_rel_state || []) {
+        if (row.agent_id !== agentId) continue;
+        const stage = stageOf(row);
+        counts.set(stage, (counts.get(stage) || 0) + 1);
+      }
+      return [...counts.entries()].filter(([, n]) => n >= 5).map(([stage, n]) => ({ stage, n }));
+    }
+    // roomRelStateStageCounts's own per-bucket dyad-exclusion subtract.
+    if (sql.includes("r.person_id = (select p.subject_person_id from vy_replica p where p.agent_id = ($1)::uuid limit 1)")) {
+      const [agentId, stage] = params;
+      const replica = (state.vy_replica || []).find((r) => r.agent_id === agentId);
+      const n = (state.vy_rel_state || []).filter(
+        (row) => row.agent_id === agentId && row.person_id === replica?.subject_person_id && stageOf(row) === stage,
+      ).length;
+      return [{ n }];
+    }
+    if (sql.startsWith("select s.* from vy_teacher_sheet s")) {
+      const [replicaIds, owner] = params;
+      const owned = (state.vy_replica || []).filter((r) => replicaIds.includes(r.replica_id) && r.owner_user_id === owner);
+      return (state.vy_teacher_sheet || []).filter((s) => owned.some((r) => s.replica_id === r.replica_id && s.owner_user_id === r.owner_user_id));
+    }
+    if (/select replica_id, agent_id from vy_replica where owner_user_id = \$1::uuid/.test(sql)) {
+      return (state.vy_replica || []).filter((r) => r.owner_user_id === params[0]);
+    }
+    if (/select room_id from vy_room where owner_user_id = \$1::uuid/.test(sql)) {
+      return (state.vy_room || []).filter((r) => r.owner_user_id === params[0]).map((r) => ({ room_id: r.room_id }));
+    }
+    const m = sql.match(/^select \* from (\w+) where (.+?) limit 20000$/s);
+    if (!m) throw new Error(`fakeDb: unrecognized query: ${sql}`);
+    const [, table, clause] = m;
+    const rows = state[table] || [];
+    if (/^replica_id = any\(\$1::uuid\[\]\) and owner_user_id = \$2::uuid$/.test(clause)) {
+      const [replicaIds, ownerUserId] = params;
+      return rows.filter((r) => replicaIds.includes(r.replica_id) && r.owner_user_id === ownerUserId);
+    }
+    if (/^owner_user_id = \$1::uuid$/.test(clause)) return rows.filter((r) => r.owner_user_id === params[0]);
+    if (/^agent_id = any\(\$1::uuid\[\]\)$/.test(clause)) return rows.filter((r) => params[0].includes(r.agent_id));
+    return [];
+  };
+}
+
+// The Meet-memory matcher above needs the replica's own subject_person_id;
+// the fixture's `vy_replica` row carries none by default (creatorExport's
+// own scopedQuery never reads it), so it is set directly here rather than
+// widening the shared shape.
+{
+  const world = seedWorld();
+  world.vy_replica[0].subject_person_id = PERSON_A;
+  const db = fakeDb(world);
+
+  const NOW = 1_800_000_000_000; // fixed clock: both calls below must agree on `exported_at`
+  const rawDump = await creatorExport(db, OWNER_A, { tableApplied: async () => true, now: NOW });
+  const personDump = await personExport(db, OWNER_A, { tableApplied: async () => true, now: NOW });
+
+  ok("personExport's raw field equals creatorExport's own output for the identical input",
+    JSON.stringify(personDump.raw) === JSON.stringify(rawDump));
+  ok("personExport format is the versioned person-export shape", personDump.format === "vyakti-person-export/1");
+  ok("personExport carries no receipt when the owner still has a replica", personDump.receipt === null);
+
+  const sections = Object.fromEntries(personDump.sections.map((s) => [s.key, s]));
+  ok("all eight named sections are present, in order",
+    JSON.stringify(personDump.sections.map((s) => s.key)) === JSON.stringify(["sheet", "sources", "claims", "memory", "relationship", "generations", "consents", "receipts"]));
+
+  ok("sheet section carries the real teacher sheet", sections.sheet.rows.length === 1 && sections.sheet.rows[0].sheet_id === "sheet-a");
+  ok("sources section carries kind and state", sections.sources.rows[0]?.kind === "document" && sections.sources.rows[0]?.state === "ready");
+
+  ok("claims section carries ONLY the approved claim", sections.claims.rows.length === 1 && sections.claims.rows[0].claim_id === 1);
+  ok("claims section never carries a proposed or rejected claim", !sections.claims.rows.some((c) => c.status !== "approved"));
+
+  ok("memory section carries the owner's own fact", sections.memory.rows.some((f) => f.body === "own memory fact"));
+  ok("memory section NEVER carries the hostile follower-shaped fact on the same agent, different person_id",
+    !JSON.stringify(sections.memory).includes(FOLLOWER_FACT_TOKEN));
+  ok("memory section never carries the follower's fact anywhere in the whole person export, serialized",
+    !JSON.stringify(personDump).includes(FOLLOWER_FACT_TOKEN));
+
+  ok("relationship section carries the warming bucket at n=5 (the floor, cleared)",
+    sections.relationship.rows.some((r) => r.stage === "warming" && r.n === 5));
+  ok("relationship section NEVER carries the deep bucket (n=2, below the n>=5 floor)",
+    !sections.relationship.rows.some((r) => r.stage === "deep"));
+  ok("relationship section is COUNTS only — no row carries a person_id or any per-follower field",
+    sections.relationship.rows.every((r) => Object.keys(r).sort().join(",") === "agent_id,n,stage"));
+
+  ok("generations section carries the generation and the calibration verdict",
+    sections.generations.rows.length === 1 && sections.generations.calibration.length === 1);
+  ok("consents section carries the real consent row", sections.consents.rows.length === 1 && sections.consents.rows[0].scope === "memory");
+  ok("receipts section carries the payout and the charge event", sections.receipts.rows.length === 1 && sections.receipts.charges.length === 1);
+
+  // ── every section's own `table` name is real: an OWNER_LANE_TABLES
+  //    entry, one of the two borrowed readers (`vy_fact`, `vy_rel_state`),
+  //    or `vy_replica_claim` itself — read directly (this file's own header
+  //    on why it is not an OWNER_LANE_TABLES entry), real per its own
+  //    schema definition (checked against the DDL, not assumed). ──
