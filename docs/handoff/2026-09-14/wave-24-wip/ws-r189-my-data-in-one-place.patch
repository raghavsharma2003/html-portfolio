+// WS-R189. "My data, in one place" — the SAME "export" op, a person-kind
+// rendering (`view: "person"`), never a second door. `erasureRequestId` is
+// the id `storeErasureRequest`/`storedErasureRequest` (StudioApp.tsx) already
+// keeps in localStorage the moment an erasure starts; passing it lets the
+// server hand back the receipt once every replica is gone, instead of an
+// honest-but-uninformative empty export.
+export async function readPersonExport(token: string, erasureRequestId?: string | null): Promise<PersonExportResult> {
+  return replicaRequest<PersonExportResult>(token, "/api/replica", {
+    method: "POST",
+    body: JSON.stringify({ op: "export", view: "person", erasure_request_id: erasureRequestId || undefined }),
+  });
+}
+
+// WS-R189. `format: "html"` twin of `readPersonExport` above —
+// `fetchRoomExportReadableHtml`'s own shape (`src/room/roomApi.ts`)
+// restated for the owner's own door: the server's response is the
+// printable page itself, `text/html`, never a JSON envelope.
+export async function readPersonExportHtml(token: string, erasureRequestId?: string | null, locale: "en" | "hi" = "en"): Promise<string> {
+  const response = await fetch("/api/replica", {
+    method: "POST",
+    headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
+    body: JSON.stringify({ op: "export", view: "person", format: "html", locale, erasure_request_id: erasureRequestId || undefined }),
+    signal: AbortSignal.timeout(45_000),
+  });
+  const text = await response.text();
+  if (!response.ok) {
+    let code = `replica_request_failed_${response.status}`;
+    try { code = String(JSON.parse(text)?.error || code); } catch { /* the error response is JSON; a non-JSON body here is unexpected but must not throw a parse error over a network error */ }
+    throw new ReplicaApiError(code, response.status);
+  }
+  return text;
+}
