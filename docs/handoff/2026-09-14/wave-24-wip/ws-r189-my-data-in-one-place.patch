+  const unknownTables = personDump.sections.map((s) => s.table).filter((t) => !knownTables.has(t));
+  ok("every section's own table name is a real OWNER_LANE_TABLES entry, one of the two borrowed readers, or vy_replica_claim",
+    unknownTables.length === 0, unknownTables.join(","));
+  ok("vy_replica_claim is deliberately NOT in OWNER_LANE_TABLES (erasure reaches it only by FK cascade, never by name)",
