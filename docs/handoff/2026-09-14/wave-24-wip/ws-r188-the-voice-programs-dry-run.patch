+#!/usr/bin/env node
+// WS-R188 (wave twenty-four). The SAME path `evals/rehearsal/voice-dry-run.mjs`
+// proves offline against the fake providers, against the LIVE Azure providers
+// this repo ships transports for — gated on env var NAMES, never values.
+//
+//   node scripts/voice-day-one.mjs            # dry-run (default): checks
+//                                              # only, refuses to spend
+//   node scripts/voice-day-one.mjs --live      # would actually run the path
+//                                              # (refused here too, still,
+//                                              # unless every required name
+//                                              # is present)
+//
+// LAW 5 of this workstream's brief: "No vendor call, no GPU wake, no money:
+// the live command is proven to refuse without the env names (a negative
+// control in a suite), never by running it." This script is written so that
+// `evals/voice-day-one/run.mjs` can drive its own refusal checks by IMPORTING
+// `requiredVoiceEnvNames`/`missingVoiceEnvNames`/`voiceSpendCeiling` below —
+// pure, no I/O — never by invoking this file as a subprocess with a real (or
+// fabricated) credential.
+//
+// The required set is the REAL union `docs/gurukul/ENV-MANIFEST.md` §7-12
+// documents for a live voice run end to end: Azure Personal Voice creation
+// (the persistent enrolled-voice lifecycle, `api/_voice/registry.js`'s
+// `VENDOR_VOICE_LANE`), its spend fencing, the self-hosted Chatterbox preview
+// lane (`SELF_HOSTED_VOICE_LANE`, `VOICE_LANE_ORDER`'s own PRIMARY), voice
+// evidence extraction (the processing DAG's diarize/separate/enhance/
+// voice_quality steps), private storage, and the database. Every name below
+// is checked against the file:line ENV-MANIFEST.md cites, not guessed.
+import { azurePersonalVoiceConfig, azurePersonalVoiceErasureConfig } from "../api/_voice/providers/azure-personal-voice.js";
+import { openChatterboxConfig } from "../api/_voice/providers/open-chatterbox-preview.js";
+
+// ── the required set (docs/gurukul/ENV-MANIFEST.md §7, §8, §9, §10, §12) ───
+export const REQUIRED_VOICE_ENV = Object.freeze([
+  // §7 — Azure Personal Voice creation (the persistent enrolled-voice lane).
+  { name: "AZURE_PERSONAL_VOICE_ENABLED", section: "§7 Azure Personal Voice" },
+  { name: "AZURE_PERSONAL_VOICE_LIMITED_ACCESS_APPROVED", section: "§7 Azure Personal Voice" },
+  { name: "AZURE_PERSONAL_VOICE_ENDPOINT", section: "§7 Azure Personal Voice" },
+  { name: "AZURE_PERSONAL_VOICE_TTS_ENDPOINT", section: "§7 Azure Personal Voice" },
+  { name: "AZURE_PERSONAL_VOICE_KEY", section: "§7 Azure Personal Voice" },
+  { name: "AZURE_PERSONAL_VOICE_PROJECT_ID", section: "§7 Azure Personal Voice" },
+  { name: "AZURE_PERSONAL_VOICE_COMPANY_NAME", section: "§7 Azure Personal Voice" },
+  { name: "AZURE_PERSONAL_VOICE_BASE_MODEL", section: "§7 Azure Personal Voice" },
+  // §8 — Azure Personal Voice spend fencing (never bypassed by this script).
+  { name: "AZURE_REPLICA_APP_BUDGET_USD", section: "§8 spend fencing" },
+  { name: "AZURE_PERSONAL_VOICE_USD_PER_PROFILE", section: "§8 spend fencing" },
+  { name: "AZURE_PERSONAL_VOICE_SYNTHESIS_USD_PER_MCHARACTERS", section: "§8 spend fencing" },
+  // §9 — the self-hosted Chatterbox preview lane, PRIMARY for synthesis
+  // (`api/_voice/registry.js`'s `SELF_HOSTED_VOICE_LANE`).
+  { name: "AZURE_OPEN_VOICE_ORIGIN", section: "§9 Chatterbox preview" },
+  { name: "OPEN_VOICE_HMAC_SECRET", section: "§9 Chatterbox preview" },
+  // §10 — voice evidence extraction (diarize/separate/enhance/voice_quality).
+  { name: "AZURE_VOICE_EVIDENCE_ORIGIN", section: "§10 voice evidence" },
+  { name: "AZURE_VOICE_EVIDENCE_HMAC_SECRET", section: "§10 voice evidence" },
+  // §12 — private storage every stage above writes derived audio into.
+  { name: "SUPABASE_URL", section: "§12 private storage" },
+  { name: "SUPABASE_SERVICE_ROLE_KEY", section: "§12 private storage" },
+  { name: "REPLICA_STORAGE_BUCKET", section: "§12 private storage" },
+  // The database every door in this path reads and writes through.
+  { name: "NEON_URL", section: "database" },
+]);
+
+// Named, informational, NEVER blocking: the brief names "Azure Foundry and
+// Speech keys, the subscription and tenant ids" as the gating set. Foundry
+// (`AZURE_FOUNDRY_ENDPOINT`/`AZURE_FOUNDRY_API_KEY`) is real and documented
+// (ENV-MANIFEST.md §1) but is the claim-extraction/dialogue lane, not voice
+// — this dry run's own path never reaches it, so it is not in
+// REQUIRED_VOICE_ENV above; a HumanOS onboarding day-one that also drafts a
+// sheet from sources would need it too, named here so the runbook does not
+// silently drop it. `docs/gurukul/ENV-MANIFEST.md` documents no separate
+// "subscription id"/"tenant id" pair for the voice lanes specifically — the
+// one `AZURE_TENANT_ID` name that exists in the manifest at all
+// (`api/_channel-secrets.js`'s `keyVaultAuth()`) is a DIFFERENT subsystem
+// (channel secret storage), so it is named here for completeness, not
+// claimed as a voice requirement it is not.
+export const INFORMATIONAL_VOICE_ENV = Object.freeze([
+  { name: "AZURE_FOUNDRY_ENDPOINT", why: "claim extraction / dialogue, ENV-MANIFEST.md §1 — not this path" },
+  { name: "AZURE_FOUNDRY_API_KEY", why: "claim extraction / dialogue, ENV-MANIFEST.md §1 — not this path" },
+  { name: "AZURE_TENANT_ID", why: "channel secret Key Vault auth, api/_channel-secrets.js — not this path" },
+]);
+
+export function missingVoiceEnvNames(env = process.env) {
+  return REQUIRED_VOICE_ENV.filter((entry) => !String(env[entry.name] || "").trim()).map((entry) => entry.name);
+}
+
+/**
+ * The exact spend ceiling this run would honour, read from the SAME two
+ * places the real spend fence reads (`api/_provider-budget.js`'s
+ * `AZURE_REPLICA_APP_BUDGET_USD`, and `AZURE_PERSONAL_VOICE_USD_PER_PROFILE`/
+ * `..._SYNTHESIS_USD_PER_MCHARACTERS`) — never a second, hand-typed number
+ * that could drift from the real fence. Returns null when the names needed
+ * to compute it are missing; never guesses a default here (the real fence's
+ * own defaults are for ITS refusal message, not for a printed plan).
+ */
+export function voiceSpendCeiling(env = process.env) {
+  const appBudgetUsd = Number(env.AZURE_REPLICA_APP_BUDGET_USD);
+  const perProfileUsd = Number(env.AZURE_PERSONAL_VOICE_USD_PER_PROFILE);
+  const perMCharUsd = Number(env.AZURE_PERSONAL_VOICE_SYNTHESIS_USD_PER_MCHARACTERS);
+  if (!Number.isFinite(appBudgetUsd) || appBudgetUsd <= 0) return null;
+  return Object.freeze({
+    app_budget_usd: appBudgetUsd,
+    per_profile_usd: Number.isFinite(perProfileUsd) ? perProfileUsd : null,
+    per_m_characters_usd: Number.isFinite(perMCharUsd) ? perMCharUsd : null,
+  });
+}
+
+function printPlan(env, live) {
+  const missing = missingVoiceEnvNames(env);
+  console.log(`voice-day-one: ${live ? "--live requested" : "dry-run (default)"}`);
+  console.log(`voice-day-one: ${REQUIRED_VOICE_ENV.length} required env var names checked, by presence only (never a value printed or logged)`);
+  if (missing.length) {
+    console.log(`voice-day-one: REFUSING — ${missing.length} required name(s) not set:`);
+    for (const name of missing) {
