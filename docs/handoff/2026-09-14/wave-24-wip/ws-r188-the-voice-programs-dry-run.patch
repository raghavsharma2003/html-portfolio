+// ═════════════════════════════════════════════════════════════════════════
+// STEP 4 — A FOLLOWER'S ROOM REPLY, spoken sentence by sentence, with the
+// declared language (WS-R180) and the bound register (WS-R176), through the
+// SAME real fake voice provider.
+// ═════════════════════════════════════════════════════════════════════════
+function roomVoiceSeamFromRealFakeProvider(provider, providerRef) {
+  const calls = { synth: 0, protect: 0, synthTexts: [], prosodyPlans: [] };
+  const synth = async ({ authorized, text, prosody }) => {
+    calls.synth += 1; calls.synthTexts.push(text); calls.prosodyPlans.push(prosody);
+    const result = await provider.synthesizeStream({ providerRef, text });
+    const checked = VoiceContracts.assertSynthesisResult(result);
+    const chunks = [];
+    for await (const chunk of checked.stream) chunks.push(Buffer.from(chunk));
+    return {
+      stream: (async function* () { yield new Uint8Array(Buffer.concat(chunks)); })(),
+      format: { sampleRate: 24_000, channels: 1 }, renderedText: checked.renderedText,
+      disclosureText: checked.disclosureText, renderer: "fake",
+    };
+  };
