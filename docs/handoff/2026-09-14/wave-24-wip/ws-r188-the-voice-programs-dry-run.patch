+// WS-R188 (wave twenty-four). Refusal controls for `scripts/voice-day-one.mjs`
+// — law 5 of this workstream's brief: "the live command is proven to refuse
+// without the env names ... never by running it." This suite imports the
+// script's own pure functions (`REQUIRED_VOICE_ENV`, `missingVoiceEnvNames`,
+// `voiceSpendCeiling`) and asserts refusal shapes; it never spawns the script
+// with a real credential and never spends.
+//
+//   node evals/voice-day-one/run.mjs
+//
+// Offline, deterministic, $0, no DB, no network, no model call, no GPU.
+import assert from "node:assert/strict";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..", "..");
+const {
+  REQUIRED_VOICE_ENV, INFORMATIONAL_VOICE_ENV, missingVoiceEnvNames, voiceSpendCeiling,
+} = await import(pathToFileURL(join(ROOT, "scripts/voice-day-one.mjs")).href);
+
+let pass = 0;
+let fail = 0;
+function ok(name, cond, extra = "") {
+  if (cond) { pass++; console.log(`  ok  ${name}${extra ? `   ${extra}` : ""}`); }
+  else { fail++; console.log(`FAIL  ${name}${extra ? `   ${extra}` : ""}`); }
+}
+
+// ── 1. With NO env at all, every required name is reported missing. ────────
+ok("NEGATIVE CONTROL: with no env set, every required name refuses by name",
+  missingVoiceEnvNames({}).length === REQUIRED_VOICE_ENV.length
+  && REQUIRED_VOICE_ENV.every((entry) => missingVoiceEnvNames({}).includes(entry.name)));
+
+// ── 2. Setting every name BUT ONE still refuses on that one name. ──────────
+{
+  const complete = Object.fromEntries(REQUIRED_VOICE_ENV.map((entry) => [entry.name, "x".repeat(24)]));
+  for (const entry of REQUIRED_VOICE_ENV) {
+    const almost = { ...complete };
+    delete almost[entry.name];
+    const missing = missingVoiceEnvNames(almost);
+    ok(`NEGATIVE CONTROL: missing only ${entry.name} is refused by that exact name, and no other`,
+      missing.length === 1 && missing[0] === entry.name);
+  }
+}
+
+// ── 3. A blank string (present key, empty value) is treated as missing —
+// never as "set". ────────────────────────────────────────────────────────
+{
+  const complete = Object.fromEntries(REQUIRED_VOICE_ENV.map((entry) => [entry.name, "x".repeat(24)]));
+  const blanked = { ...complete, AZURE_PERSONAL_VOICE_KEY: "   " };
+  ok("NEGATIVE CONTROL: a whitespace-only value is refused, not accepted as present",
+    missingVoiceEnvNames(blanked).includes("AZURE_PERSONAL_VOICE_KEY"));
+}
+
+// ── 4. With every name present, nothing is missing (the positive control
+// that proves the negative controls above are testing something real). ────
+{
+  const complete = Object.fromEntries(REQUIRED_VOICE_ENV.map((entry) => [entry.name, "x".repeat(24)]));
+  ok("positive control: with every required name set, nothing is reported missing",
+    missingVoiceEnvNames(complete).length === 0);
+}
+
+// ── 5. The spend ceiling is read from the SAME names the real spend fence
+// (api/_provider-budget.js) reads, never a second hand-typed number, and is
+// null (never a guessed default) when the budget name itself is absent. ───
+ok("the spend ceiling is null when AZURE_REPLICA_APP_BUDGET_USD is absent, never a guessed default",
+  voiceSpendCeiling({}) === null);
+ok("the spend ceiling reads the real three names, unchanged", (() => {
+  const ceiling = voiceSpendCeiling({
+    AZURE_REPLICA_APP_BUDGET_USD: "25",
+    AZURE_PERSONAL_VOICE_USD_PER_PROFILE: "1.5",
+    AZURE_PERSONAL_VOICE_SYNTHESIS_USD_PER_MCHARACTERS: "30",
+  });
+  return ceiling.app_budget_usd === 25 && ceiling.per_profile_usd === 1.5 && ceiling.per_m_characters_usd === 30;
+})());
+ok("a non-numeric or zero budget is treated the same as absent (refuses to print a bogus ceiling)",
+  voiceSpendCeiling({ AZURE_REPLICA_APP_BUDGET_USD: "0" }) === null
+  && voiceSpendCeiling({ AZURE_REPLICA_APP_BUDGET_USD: "not-a-number" }) === null);
+
+// ── 6. The script never prints a VALUE — only names — anywhere in its own
+// source (the same discipline scripts/write-config.mjs's own header states).
+// A source scan, not a runtime capture, so this cannot be defeated by an
+// env var this suite happens not to set. ───────────────────────────────────
+{
+  const source = await (await import("node:fs/promises")).readFile(join(ROOT, "scripts/voice-day-one.mjs"), "utf8");
+  ok("the script's own source never logs an env value, only names (no `env[` read inside a console.log/console.error argument)",
+    !/console\.(log|error)\([^)]*env\[/.test(source));
+  ok("informational names (Foundry, tenant id) are named but never added to the blocking required list",
+    INFORMATIONAL_VOICE_ENV.every((entry) => !REQUIRED_VOICE_ENV.some((req) => req.name === entry.name)));
+}
+
+// ── 7. NEGATIVE CONTROL — running the script itself (as a real CLI, exactly
+// how a human would) refuses with a non-zero exit and never a stack trace,
+// both with and without --live, when no env is set. This is the ONE place
+// this suite spawns the real file, and it spawns it with an EMPTY env (never
+// a real or fabricated credential) — proving the refusal a human actually
+// sees, not just the pure function underneath it. ──────────────────────────
+{
+  const { spawnSync } = await import("node:child_process");
+  for (const args of [[], ["--live"]]) {
+    const result = spawnSync(process.execPath, [join(ROOT, "scripts/voice-day-one.mjs"), ...args], {
+      env: { PATH: process.env.PATH }, encoding: "utf8",
+    });
+    ok(`NEGATIVE CONTROL: \`node scripts/voice-day-one.mjs${args.length ? " " + args.join(" ") : ""}\` with no env refuses (exit ${result.status}), no stack trace`,
+      result.status === 1 && !/at .*\.mjs:\d+/.test(result.stdout + result.stderr) && /REFUSING/.test(result.stdout));
+  }
+}
+
+console.log(`\nvoice-day-one: ${pass} passed, ${fail} failed`);
+if (fail > 0) process.exit(1);
