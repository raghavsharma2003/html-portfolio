+    return 1;
+  }
+  console.log("voice-day-one: every required name is present.");
+  const ceiling = voiceSpendCeiling(env);
+  console.log(`voice-day-one: spend ceiling this run would honour: app budget ${ceiling ? `USD ${ceiling.app_budget_usd}` : "(unreadable)"}, per-profile USD ${ceiling?.per_profile_usd ?? "(unreadable)"}, synthesis USD ${ceiling?.per_m_characters_usd ?? "(unreadable)"} per million characters`);
+  // Names are present; a structural check (real config validators, still no
+  // network) catches a malformed value before anything is attempted.
+  try {
+    azurePersonalVoiceConfig(env);
+    azurePersonalVoiceErasureConfig(env);
+    openChatterboxConfig(env);
+    console.log("voice-day-one: structural check passed (the real provider config validators accepted every value's SHAPE — this proves nothing about whether the credential itself is valid).");
+  } catch (error) {
+    console.log(`voice-day-one: REFUSING — a required value is present but malformed: ${error.code || error.message}`);
+    return 1;
+  }
+  if (!live) {
+    console.log("voice-day-one: dry-run only. Pass --live to run the path for real (this build still never spends beyond the ceiling printed above, and every real door — the same doors evals/rehearsal/voice-dry-run.mjs exercises offline — still enforces its own consent, ownership and budget gates).");
+    return 0;
+  }
+  console.log("voice-day-one: --live is not implemented in this workstream's own scope (law 5: proven to refuse, never proven by running it). Run the individual real doors by hand once every gate above is green.");
+  return 0;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const live = process.argv.includes("--live");
+  process.exit(printPlan(process.env, live));
+}
