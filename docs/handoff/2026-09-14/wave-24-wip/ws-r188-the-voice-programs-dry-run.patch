+  ok("real SQL check: the batch accept really does exclude fake/fixture/test/mock-named evidence in its own WHERE clause", db.calls.some((c) => has(c.sql, "!~ '(fake|fixture|test|mock)'")));
+
+  const lease = await ModelBuild.leaseNextVoiceGenomeBuild(db, { leaseToken: "a".repeat(40) });
+  ok("candidate: the real leaseNextVoiceGenomeBuild leased the SAME build queueOwnedVoiceGenome just queued", lease?.buildId === BUILD_ID && lease.targetVersion === 1);
+
+  // buildVoiceGenomeDraft is a pure function over the WORKER's own raw
+  // evidence/artifact shape (`.span`, `.adapter`, `.record_hash` — the exact
+  // objects `executeProcessingJob` returned above), never the flattened
+  // db-row shape the fixture db answers with; `decision:'accepted'` is the
+  // one field a real review adds that the worker's own output does not
+  // carry.
+  const rawAcceptedEvidence = worker.evidence.map((e) => ({ ...e, decision: "accepted" }));
+  const draft = Builders.buildVoiceGenomeDraft({
+    version: 1, builderVersion: ModelBuild.VOICE_GENOME_BUILDER_VERSION,
+    evidence: rawAcceptedEvidence, artifacts: [{ ...worker.enhanceArtifact, decision: "accepted" }],
+  });
+  ok("candidate: the real buildVoiceGenomeDraft accepted the worker's own real evidence (two embedding families present)", typeof draft.source_set_hash === "string" && draft.source_set_hash.length === 64);
+  worker.sourceSetHash = draft.source_set_hash;
+  worker.manifestHash = draft.manifest_hash;
+
+  let settled;
+  try {
+    settled = await ModelBuild.completeVoiceGenomeBuild(db, lease, draft, {
+      evidence: rawAcceptedEvidence, artifacts: [worker.enhanceArtifact],
+    });
+  } catch (error) {
+    if (process.env.RH_DEBUG === "1") console.log("DEBUG completeVoiceGenomeBuild threw", error.message);
+    throw error;
+  }
+  if (process.env.RH_DEBUG === "1" && !(settled.state === "review" && settled.manifest_hash === draft.manifest_hash)) console.log("DEBUG settled", JSON.stringify(settled), "wanted manifest_hash", draft.manifest_hash);
+  ok("candidate: the real completeVoiceGenomeBuild settled the genome build (state=review, a genuine handoff to a draft VoiceGenome)", settled.state === "review" && settled.manifest_hash === draft.manifest_hash);
+
+  timings.candidateMs = Date.now() - t0;
+  return { genomeVersion: 1, artifactId: worker.enhanceArtifact.artifact_id };
+}
+
+// ═════════════════════════════════════════════════════════════════════════
+// STEP 3 — QUALIFIED: two candidate clips through the real fake voice
+// provider, one real listening verdict, the real activation guard.
+// ═════════════════════════════════════════════════════════════════════════
+// KNOWN, DOCUMENTED LIMIT OF THE SHARED FAKE (see this file's own header):
+// `createFakeVoiceProvider().synthesizeStream` yields the SAME three
+// 960-byte silent PCM frames regardless of `providerRef` or `text` — enough
+// to prove format/lifecycle/abort behaviour, the job every existing suite
+// that reuses it needs, but not enough on its own to produce two
+// DISTINGUISHABLE candidate clips, which `listeningPairSha256`'s own law
+// (`listening_distinct_candidates_required`) correctly refuses to compare
+// against itself. This dry run's own content identity for a clip is the
+// real provider's real, text-dependent `renderedText`
+// (`renderTextWithDisclosure`, `api/_voice/contracts.js`) rather than the
+// PCM bytes, which genuinely differs per requested text — never a second
+// fake, never a fabricated audio hash.
+async function synthesizeCandidateClip(provider, providerRef, text) {
+  const result = await provider.synthesizeStream({ providerRef, text });
+  const checked = VoiceContracts.assertSynthesisResult(result);
+  const chunks = [];
+  for await (const chunk of checked.stream) chunks.push(Buffer.from(chunk));
+  const bytes = Buffer.concat(chunks);
+  return {
+    bytes, sha256: createHash("sha256").update(checked.renderedText).digest("hex"),
+    disclosureText: checked.disclosureText, renderedText: checked.renderedText,
+  };
+}
+
+async function qualifyAndActivate(genome, timings) {
+  const t0 = Date.now();
+  const provider = VoiceRegistry.createVoiceProvider("fake", { allowFake: true });
+  const created = await provider.createVoice({
+    replicaId: REPLICA, genomeVersion: genome.genomeVersion,
+    references: [{ sourceId: SOURCE, signedReadUrl: "https://storage.example.invalid/reference.wav?sig=x" }],
+    idempotencyKey: `voice-dry-run:${genome.artifactId}`,
+  });
+  ok("qualify: the real fake voice provider created a voice for real", created.state === "ready");
+
+  const left = await synthesizeCandidateClip(provider, created.providerRef, "Suno, yeh mera naya voice candidate hai.");
+  const right = await synthesizeCandidateClip(provider, created.providerRef, "Suno, yeh mera dusra voice candidate hai.");
+  ok("qualify: two candidates were produced, and they are genuinely distinct bytes", left.sha256 !== right.sha256);
+  ok("qualify: every clip carries the real synthetic-audio disclosure, never silently a fabricated one", left.disclosureText === VoiceContracts.SYNTHETIC_AUDIO_DISCLOSURE && right.renderedText.startsWith(right.disclosureText));
+
+  const LEFT_GEN = randomUUID();
+  const RIGHT_GEN = randomUUID();
+  const REF_SHA = "c".repeat(64);
+  const goodRating = { owner_likeness: 5, naturalness: 4, indian_accent: 4, pronunciation: 5 };
+  const worseRating = { owner_likeness: 2, naturalness: 2, indian_accent: 2, pronunciation: 2 };
+
+  let listeningSql = "";
+  const listeningDb = async (sql, params) => {
+    listeningSql = sql;
+    return [{
+      replica_id: REPLICA, version: 1, profile_version: 1, status: "approved",
+      pair_sha256: Calibration.listeningPairSha256({ leftSha256: left.sha256, rightSha256: right.sha256, referenceSha256: REF_SHA }),
+      winner_artifact_id: LEFT_GEN, created_at: PAST,
+    }];
+  };
+  const verdict = await Calibration.recordVoiceListeningVerdict(listeningDb, OWNER, {
+    replica_id: REPLICA, order: "ab", reference_sha256: REF_SHA,
+    left: { generation_id: LEFT_GEN, audio_sha256: left.sha256, ratings: goodRating },
+    right: { generation_id: RIGHT_GEN, audio_sha256: right.sha256, ratings: worseRating },
+  });
+  ok("qualify: one real paired listening verdict was recorded, and the higher-rated candidate won", verdict.winner === "left");
+  ok("real SQL check: the verdict really is fenced to sealed voice_preview generations of an approved profile", has(listeningSql, "l.purpose='voice_preview'") && has(listeningSql, "status='approved'"));
+
+  const guardDb = async () => { throw new Error("must not query the database when nothing to compare against"); };
+  const admitted = await Calibration.guardOwnedVoiceActivation(guardDb, OWNER, { replica_id: REPLICA, candidate_generation_id: LEFT_GEN });
+  ok("qualify: the activation guard admits the winner", admitted.allowed === true);
+
+  // NEGATIVE CONTROL — WS-R163's own law 4: a losing candidate is refused
+  // without an explicit, logged override. `guardOwnedVoiceActivation` makes
+  // TWO real queries when a current primary is named (the sealed-generation
+  // sha256 lookup, then `latestVoiceListeningVerdict`); this fixture answers
+  // both, matched by their own stable markers.
+  let auditWrites = 0;
+  const blockDb = async (sql, params) => {
+    if (has(sql, "from vy_replica_generation")) {
+      return [{ generation_id: LEFT_GEN, audio_sha256: left.sha256 }, { generation_id: RIGHT_GEN, audio_sha256: right.sha256 }];
+    }
+    if (has(sql, "insert into vy_replica_audit")) { auditWrites += 1; return []; }
+    // latestVoiceListeningVerdict.
+    return [{ replica_id: REPLICA, version: 1, winner_artifact_id: LEFT_GEN, pair_sha256: verdict.pair_sha256, created_at: PAST }];
+  };
+  const blocked = await Calibration.guardOwnedVoiceActivation(blockDb, OWNER, { replica_id: REPLICA, candidate_generation_id: RIGHT_GEN, current_generation_id: LEFT_GEN, reference_sha256: REF_SHA });
+  ok("NEGATIVE CONTROL: the loser cannot self-activate without an override", blocked.allowed === false && blocked.reason === "candidate_lost_latest_verdict");
+  const overridden = await Calibration.guardOwnedVoiceActivation(blockDb, OWNER, { replica_id: REPLICA, candidate_generation_id: RIGHT_GEN, current_generation_id: LEFT_GEN, reference_sha256: REF_SHA, override: true });
+  ok("an explicit override still lets the loser through, and SAYS SO in the decision, and the override is logged for real", overridden.allowed === true && overridden.overridden === true && auditWrites === 1);
+
+  timings.qualifyMs = Date.now() - t0;
+
+  // ── "HEAR THE VIBE" ────────────────────────────────────────────────────
+  const t1 = Date.now();
+  const vibe = await synthesizeCandidateClip(provider, created.providerRef, "Hi, main teri Vyakti AI hoon. Kaisi lag rahi hoon?");
