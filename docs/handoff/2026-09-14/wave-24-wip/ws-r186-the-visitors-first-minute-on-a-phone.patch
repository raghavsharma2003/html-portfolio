+// WS-R186 (wave twenty-four) — THE VISITOR'S FIRST MINUTE ON A PHONE.
+//
+//   node evals/rehearsal/visitor-first-minute.mjs           the English walk (gate budget)
+//   node evals/rehearsal/visitor-first-minute.mjs --full   + the Hindi walk
+//
+// WS-R164 (`evals/first-five-minutes/run.mjs`) measured the PERSON's own
+// first five minutes, landing to Meet, with no throttling. WS-R174
+// (`evals/rehearsal/person-room.mjs`) walked a stranger into a published
+// person's Room in Chromium, at desktop width, with no clock. Neither one is
+// this file's own subject: a FRIEND taps a WhatsApp link on a PHONE, on the
+// network India actually has, and every screen between that tap and the
+// first reply is a place they leave (this workstream's own brief). This walk
+// times that, at 390x844, under the exact CPU/network throttle
+// `scripts/check-performance.mjs` already uses for the Room's own layout
+// target ("Fast 3G": 4x CPU, 1.6 Mbps down, 750 Kbps up, 150 ms RTT — that
+// file's own header on why those three numbers are the honest stand-in for a
+// busy Indian tower, not a bespoke guess), and adds the ONE thing that gate
+// does not: the install prompt's own real, product-defined visibility law
+// (`src/room/installPrompt.ts`), proven against the REAL `/r/<slug>`
+// production door rather than the layout fixture's `fixtureInstallPrompt`
+// short-circuit.
+//
+// ── WHAT IS DRIVEN THROUGH THE BROWSER, AND WHAT THROUGH A FIXTURE SHORTCUT
+//    (named here rather than left to be inferred) ──────────────────────────
+//
+// Real, through the browser, against the REAL built `dist/room.html` and the
+// REAL `api/room.js`/`api/room-about.js` handlers over a fixture `db`: every
+// screen a visitor's own phone renders — the taste screen, the join sheet
+// (age attestation, memory consent), the about page, the composer, the
+// reply bubble, the install card — under real CDP throttling, cold context
+// per timed run (`check-performance.mjs`'s own "a fresh context has never
+// fetched anything" reasoning, restated here for a stateful walk rather than
+// a static asset).
+//
+// A FIXTURE SHORTCUT, named rather than silently taken (`person-room.mjs`'s
+// own precedent, restated): the OWNER side of getting a person's Room
+// published — sign-in, HumanOS approval, Readiness, runtime activation — is
+// WS-R174's own already-proven subject, not this brief's. This walk mints
+// the published Room directly through the REAL `/api/replica` and
+// `/api/room-publish` doors (create, then publish) with the SAME
+// already-passing fixture shortcuts `freshRehearsalCreatorState()` seeds by
+// default (`rehearsalRuntimeActive`/`rehearsalDisclosureApproved`, that
+// file's own header: "out of this rehearsal's scope"), plus a published
+// person `vy_teacher_sheet` row seeded directly onto the fixture state (the
+// same shape `person-room.mjs` proved loads through the REAL
+// `loadTeacherAgent` validation). No browser ever drives the owner half of
+// this walk — this workstream's own subject starts the moment a stranger
+// has a link.
+//
+// ── WHY THREE INDEPENDENT "COLD" MEASURED RUNS NEED A SERVER-SIDE RESET,
+//    NOT ONLY A FRESH BROWSER CONTEXT ───────────────────────────────────────
+//
+// A fresh Playwright context has empty `localStorage` (the browser side of
+// "cold"), but `openRoom` decides whether to show the join sheet at all off
+// the SERVER's own follower row for this (person, room) pair — a real
+// returning follower's second device skips straight to `talking`
+// (`RoomApp.tsx`'s own `opened.joined` branch). Only two fixture-recognized
+// follower identities exist in this repo
+// (`evals/rehearsal/stubs/auth-with-fake-user.mjs`'s own fixed `KNOWN` map,
+// a SHARED file this brief does not list and this suite does not touch), so
+// three genuinely independent "first-ever visitor" measurements on the SAME
+// identity need the follower row cleared between them. Rather than inventing
+// a second reset mechanism, this file calls the REAL `POST /api/room
+// {op:"forget"}` door between runs — the product's own real cleanup,
+// already proven end to end by `follower.mjs`'s own forget step — so each
+// timed run starts from a state a genuine stranger's phone would actually be
+// in, not a hand-rolled approximation of one.
+//
+// ── THE INSTALL PROMPT'S OWN LAW, PROVEN RATHER THAN SHORT-CIRCUITED ───────
+//
+// `installPrompt.ts`'s `shouldShowInstallCard` never shows the card on a
+// browser's FIRST visit to a Room at all (`readyBySecondVisit`), and gates a
+// working button on a captured `beforeinstallprompt` — an event headless
+// Chromium does not reliably fire against a plain-HTTP loopback server with
+// no real installability signal. iOS is the one branch `shouldShowInstallCard`
+// admits WITHOUT that event (`RoomApp.tsx`'s own `isIOS`, read straight off
+// `navigator.userAgent`), rendered as static "Add to Home Screen"
+// instructions rather than a button — the deterministic, real path this
+// suite drives with an iPhone-shaped `userAgent` on its own dedicated
+// context, never a synthetic `beforeinstallprompt` dispatch standing in for
+// a real one. Two navigations in ONE context (same `localStorage`, so the
+// visit counter genuinely increments): the FIRST proves the negative control
+// the brief's law 5 names — never before the first reply, because visit 1 is
+// never "ready by second visit" regardless of phase — and the SECOND proves
+// the card appears once the product's own real second-visit rule is
+// satisfied, never earlier and never later.
+//
+// ── NEGATIVE CONTROLS (ws-common's law: at least one; this suite ships
+//    three, matching the brief's own law 5) ────────────────────────────────
+//
+// 1. A signed-out visitor's cold open of a slug that was never published
+//    (created or not — `roomBySlug`'s own predicate treats both alike, and
+//    `copy.ts`'s own `unavailable.body` deliberately never says which) is
+//    refused with the honest, deliberately vague `room_unavailable` — never
+//    reachable, never a stack.
+// 2. A creator PAUSING their Room mid-life (`op:"pause"`, unconditional per
+//    `api/_room-publish.js`'s own header) makes the exact SAME honest,
+//    vague page render for a cold visitor — `copy.ts`'s own comment on why
+//    "paused" and "never published" must read identically to a stranger —
+//    inside the SAME budget a real "about page readable" visit gets, never
+//    a slower path because something failed.
+// 3. The install card never appears on a Room's first visit even when every
+//    OTHER condition (signed in, talking, a captured-equivalent iOS signal)
+//    already holds — see the install-prompt section above.
+import { createServer } from "node:http";
+import { execSync } from "node:child_process";
+import { dirname, join, extname } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { randomUUID } from "node:crypto";
+import { register } from "node:module";
+import { readFile } from "node:fs/promises";
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const ROOT = join(HERE, "..", "..");
+const DIST = join(ROOT, "dist");
+const FULL = process.env.REHEARSAL_FULL === "1" || process.argv.includes("--full");
+const VIEWPORT = { width: 390, height: 844 };
+const RUNS = 3;
+
+// The exact throttle shape `scripts/check-performance.mjs` uses for every
+// public entry point — restated here (not imported: that file has no
+// exported constant, only a module-scoped one) rather than invented, per
+// that file's own comment on WHY these three numbers are the honest
+// standard rather than a bespoke guess.
+const THROTTLE = {
+  latencyMs: 150,
+  downloadBps: (1.6 * 1024 * 1024) / 8,
+  uploadBps: (750 * 1024) / 8,
+  cpuRate: 4,
+};
+
+// Law 3, this workstream's own brief. Never lowered to pass; a miss is
+// investigated and fixed at its cause, logged as a rejection.
+const BUDGETS = {
+  tapToAboutMs: 3000,
+  joinToFirstReplyMs: 8000,
+  totalMs: 20000,
+};
+
+let pass = 0;
+let fail = 0;
+const failures = [];
+function ok(name, cond, extra = "") {
+  if (cond) { pass++; console.log(`  ok  ${name}${extra ? `   ${extra}` : ""}`); }
+  else { fail++; failures.push(name); console.log(`FAIL  ${name}${extra ? `   ${extra}` : ""}`); }
+}
+
+// The one launch every rehearsal in this repo shares.
+const { launchRehearsalBrowser } = await import(pathToFileURL(join(ROOT, "evals/rehearsal/browser.mjs")).href);
+{
+  const probe = await launchRehearsalBrowser();
+  if (!probe.browser) {
+    console.log(`SKIP: ${probe.reason} — the release gate runs this walk with a real Chromium`);
+    process.exit(0);
+  }
+  await probe.browser.close();
+}
+
+// MUST happen before any dynamic import of api/*.js — every sibling
+// rehearsal's own law, repeated here.
+register("./loader.mjs", import.meta.url);
+process.env.ROOM_SESSION_SECRET = process.env.ROOM_SESSION_SECRET || "y".repeat(48);
+
+const { setFixtureDb } = await import("./stubs/db.mjs");
+const { setFakeReply } = await import("./stubs/surface-with-fake-model.mjs");
+const { REHEARSAL_OWNER_TOKEN, REHEARSAL_OWNER } = await import("./stubs/auth-with-fake-user.mjs");
+const { freshRehearsalCreatorState, rehearsalCreatorDb, loadFixtureAgent } = await import(
+  pathToFileURL(join(ROOT, "evals/room-doors/fixtures.mjs")).href
+);
+const { USER_A, USER_B } = await import(pathToFileURL(join(ROOT, "evals/room/fixtures.mjs")).href);
+const { READINESS_OVERALL_FLOOR, READINESS_PART_FLOOR } = await import(pathToFileURL(join(ROOT, "api/_readiness.js")).href);
+
+let builtOnce = false;
+function ensureBuilt() {
+  if (builtOnce) return;
+  execSync("npx vite build", { cwd: ROOT, stdio: "inherit" });
+  builtOnce = true;
+}
+
+const CONTENT_TYPES = {
+  ".html": "text/html; charset=utf-8", ".js": "application/javascript; charset=utf-8",
+  ".mjs": "application/javascript; charset=utf-8", ".css": "text/css; charset=utf-8",
+  ".json": "application/json; charset=utf-8", ".png": "image/png", ".svg": "image/svg+xml",
+  ".ico": "image/x-icon", ".woff2": "font/woff2", ".webmanifest": "application/manifest+json",
+  ".txt": "text/plain; charset=utf-8",
+};
+
+function withVercelShims(res) {
+  res.status = (code) => { res.statusCode = code; return res; };
+  res.json = (body) => { if (!res.hasHeader("content-type")) res.setHeader("content-type", "application/json; charset=utf-8"); res.end(JSON.stringify(body)); return res; };
+  res.send = (body) => {
+    if (Buffer.isBuffer(body) || typeof body === "string") res.end(body);
+    else { if (!res.hasHeader("content-type")) res.setHeader("content-type", "application/json; charset=utf-8"); res.end(JSON.stringify(body)); }
+    return res;
+  };
+  return res;
+}
+
+async function readJsonBody(req) {
+  const chunks = [];
+  for await (const chunk of req) chunks.push(chunk);
+  const raw = Buffer.concat(chunks).toString("utf8");
+  if (!raw) return {};
+  try { return JSON.parse(raw); } catch { return {}; }
+}
+
+async function serveDistFile(res, relPath) {
+  try {
+    const bytes = await readFile(join(DIST, relPath));
+    res.writeHead(200, { "content-type": CONTENT_TYPES[extname(relPath)] || "application/octet-stream" });
+    res.end(bytes);
+    return true;
+  } catch { return false; }
+}
+
+/** One loopback server: the owner's two setup doors (`/api/replica`,
+ *  `/api/room-publish`) and the visitor's own real surface (`/api/room`,
+ *  `/r/<slug>/about`, `dist/room.html`) — this walk's own subject is the
+ *  visitor half, but the owner doors are what mint the Room it visits, so
+ *  one server answers both rather than two racing over the same fixture
+ *  `state`. */
+async function startServer(state) {
+  const db = rehearsalCreatorDb(state);
+  setFixtureDb(db);
+
+  const replicaHandler = (await import(pathToFileURL(join(ROOT, "api/replica.js")).href)).default;
+  const roomPublishHandler = (await import(pathToFileURL(join(ROOT, "api/room-publish.js")).href)).default;
+  const roomHandler = (await import(pathToFileURL(join(ROOT, "api/room.js")).href)).default;
+  const roomAboutHandler = (await import(pathToFileURL(join(ROOT, "api/room-about.js")).href)).default;
+
+  const server = createServer(async (req, res) => {
+    withVercelShims(res);
+    try {
+      const url = new URL(req.url, "http://127.0.0.1");
+      const pathname = url.pathname;
+      req.query = Object.fromEntries(url.searchParams);
+      if (req.method !== "GET" && req.method !== "HEAD") req.body = await readJsonBody(req);
+
+      if (pathname === "/api/replica" && (req.method === "POST" || req.method === "OPTIONS")) {
+        return await replicaHandler(req, res);
+      }
+      if (pathname === "/api/room-publish" && (req.method === "POST" || req.method === "GET" || req.method === "OPTIONS")) {
+        return await roomPublishHandler(req, res);
+      }
+      if (pathname === "/api/room" && (req.method === "POST" || req.method === "OPTIONS")) {
+        return await roomHandler(req, res);
+      }
+
+      const aboutMatch = /^\/r\/([^/]+)\/about\/?$/.exec(pathname);
+      if (aboutMatch && (req.method === "GET" || req.method === "HEAD")) {
+        req.query = { slug: decodeURIComponent(aboutMatch[1]), lang: url.searchParams.get("lang") || "" };
+        return await roomAboutHandler(req, res);
+      }
+
+      if (/^\/r\/[^/]+\/?$/.test(pathname) && (req.method === "GET" || req.method === "HEAD")) {
+        if (await serveDistFile(res, "room.html")) return;
+      }
+
+      if (pathname.startsWith("/api/")) {
+        res.status(404).json({ error: "not_modelled_by_this_walk" });
+        return;
+      }
+
+      if (req.method === "GET" || req.method === "HEAD") {
+        const rel = pathname === "/" ? "room.html" : pathname.replace(/^\//, "");
+        if (await serveDistFile(res, rel)) return;
+      }
+      res.writeHead(404, { "content-type": "text/plain" });
+      res.end("not found");
+    } catch (error) {
+      res.writeHead(500, { "content-type": "text/plain" });
+      res.end(String(error && error.stack ? error.stack : error));
+    }
+  });
+  await new Promise((resolve, reject) => { server.once("error", reject); server.listen(0, "127.0.0.1", resolve); });
+  const bound = server.address();
+  return { server, url: `http://127.0.0.1:${bound.port}`, stop: async () => new Promise((r) => server.close(r)) };
+}
+
+const FOLLOWER_COPY = {
+  en: {
+    tasteJoin: "Join to keep talking", memoryYes: "Yes, remember me", age: "I am 18 or older.",
+    aboutHeading: "What this AI knows about you",
+    unavailableTitle: "This room is not open",
+  },
+  hi: {
