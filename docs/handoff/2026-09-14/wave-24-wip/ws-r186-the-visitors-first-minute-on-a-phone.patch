+
+function median(nums) {
+  const s = [...nums].sort((a, b) => a - b);
+  const n = s.length;
+  return n % 2 ? s[(n - 1) / 2] : (s[n / 2 - 1] + s[n / 2]) / 2;
+}
+
+/** Law 4 (one screen, nothing below the fold, the keyboard never covers the
+ *  primary button) and law 5's third negative control (the install card
+ *  never appears before the first reply) — ONE combined walk, one identity,
+ *  one join. Combined deliberately rather than three separate contexts:
+ *  `POST /api/room {op:"forget"}` is rate-limited to 3 calls/minute per
+ *  identity (`api/room.js`'s own `room_forget_user` bucket) and this walk
+ *  already spends its budget resetting the THREE timed runs in
+ *  `walkLocale` below; splitting this check into further contexts would
+ *  need a forget between each one this file has no budget left for. One
+ *  join here answers all four checks instead:
+ *
+ *   1. the fold check, the moment `.room-join` is reached;
+ *   2. the keyboard-safety check, the moment the composer is reached;
+ *   3. NEGATIVE CONTROL — no install card right after the first reply
+ *      (never ready by second visit, `installPrompt.ts`'s own rule, true
+ *      regardless of phase);
+ *   4. a second navigation in the SAME context (so the visit counter this
+ *      file's own header explains genuinely increments) — the product's own
+ *      real second-visit rule now allows the card.
+ *
+ *  An iPhone-shaped `userAgent` is the one deterministic path
+ *  `shouldShowInstallCard` admits without a captured `beforeinstallprompt` —
+ *  headless Chromium does not reliably fire that event against a
+ *  plain-HTTP loopback server with no real installability signal, this
+ *  file's own header on why a synthetic dispatch is not used instead.
+ *
+ *  THE KEYBOARD CHECK'S OWN HONEST LIMIT, named rather than silently
+ *  assumed: headless Chromium has no real on-screen software keyboard, so
+ *  no focus event here ever produces the genuine divergence a live OS
+ *  keyboard causes (the visual viewport shrinking while the layout
+ *  viewport does not). What this DOES prove, faithfully:
+ *  `page.setViewportSize` genuinely changes the CSS viewport Chromium lays
+ *  out against, and `.room-composer` is `position: sticky; bottom: 0`
+ *  (`room.css`) — so shrinking the viewport by a phone-keyboard-sized
+ *  amount (340px, a large Android keyboard plus a suggestion bar) and
+ *  reading `window.visualViewport.height` back against the send button's
+ *  own real bounding rect is the closest a headless environment can get to
+ *  the real question, and is exactly what would catch a regression to
+ *  `position: fixed` pinned to a stale height, or an ancestor with
+ *  `overflow: hidden` clipping the composer out of the visible area. A
+ *  live-device measurement that disagrees is what should change this
+ *  check, never the other way around. */
+async function checkJoinSheetKeyboardAndInstallPrompt(browser, url, room, locale, bearer) {
+  const c = FOLLOWER_COPY[locale];
+  const context = await browser.newContext({
+    viewport: VIEWPORT,
+    userAgent: "Mozilla/5.0 (iPhone; CPU iPhone OS 17_4 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4 Mobile/15E148 Safari/604.1",
+  });
+  await context.addInitScript(authInitScript(bearer), { token: bearer });
+  const page = await context.newPage();
+  await page.goto(`${url}/r/${room.slug}?via=search`, { waitUntil: "domcontentloaded" });
+  if (locale === "hi") {
+    await page.locator('.room-lang-switch button[lang="hi"]').click({ timeout: 15_000 });
+    await page.waitForFunction(
+      () => document.querySelector('.room-lang-switch button[lang="hi"]')?.getAttribute("aria-pressed") === "true",
+      null, { timeout: 10_000 },
+    );
+  }
+  await page.getByRole("button", { name: c.tasteJoin }).click({ timeout: 15_000 });
+  await page.waitForSelector(".room-join", { timeout: 10_000 });
+
+  // Law 4, first half: nothing below the fold that must be tapped.
+  const foldCheck = await page.evaluate(() => {
+    const vh = window.innerHeight;
+    const rects = Array.from(document.querySelectorAll(
+      '.room-join input[type="checkbox"], .room-join button',
+    )).map((el) => ({ text: (el.textContent || "").trim().slice(0, 40), bottom: el.getBoundingClientRect().bottom }));
+    return { vh, rects, fits: rects.length > 0 && rects.every((r) => r.bottom <= vh) };
+  });
+  ok(`${locale}: the join sheet's every interactive control fits inside the 390x844 viewport, nothing below the fold`,
+    foldCheck.fits, JSON.stringify(foldCheck));
+
+  await page.locator('input[type="checkbox"]').check();
+  await Promise.all([
+    page.waitForResponse((r) => r.url().endsWith("/api/room") && r.request().postDataJSON()?.op === "join", { timeout: 15_000 }),
+    page.getByRole("button", { name: c.memoryYes }).click(),
+  ]);
+  await page.waitForSelector(".room-composer textarea", { timeout: 15_000 });
+
+  // Law 4, second half: the keyboard never covers the primary button.
+  await page.locator(".room-composer textarea").focus();
+  await page.setViewportSize({ width: VIEWPORT.width, height: VIEWPORT.height - 340 });
