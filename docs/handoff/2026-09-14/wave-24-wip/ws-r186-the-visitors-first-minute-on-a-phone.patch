+  // ── join sheet: age attest + memory consent, minimum taps ──────────────
+  const tJoinStart = Date.now();
+  await page.locator('input[type="checkbox"]').check();
+  const [joinResponse] = await Promise.all([
+    page.waitForResponse((r) => r.url().endsWith("/api/room") && r.request().postDataJSON()?.op === "join", { timeout: 15_000 }),
+    page.getByRole("button", { name: c.memoryYes }).click(),
+  ]);
+  const joinBody = await joinResponse.json().catch(() => ({}));
+  ok(`${locale} run${runIndex}: the visitor joins for real, a real session minted`,
+    joinResponse.status() === 200 && typeof joinBody.session === "string" && joinBody.session.length > 20);
+
+  await page.waitForSelector(".room-composer textarea", { timeout: 15_000 });
+  const beforeCount = await page.locator(".room-bubble.from-them").count();
+  await page.locator(".room-composer textarea").fill(locale === "hi" ? "आप कौन हैं?" : "Who are you?");
+  const [sayResponse] = await Promise.all([
+    page.waitForResponse((r) => r.url().endsWith("/api/room") && r.request().postDataJSON()?.op === "say", { timeout: 15_000 }),
+    page.locator(".room-send").click(),
+  ]);
+  const sayBody = await sayResponse.json().catch(() => ({}));
+  await page.waitForFunction((n) => document.querySelectorAll(".room-bubble.from-them").length > n, beforeCount, { timeout: 15_000 });
+  const joinToFirstReplyMs = Date.now() - tJoinStart;
+  const totalMs = Date.now() - t0;
+  ok(`${locale} run${runIndex}: join sheet to first reply under ${BUDGETS.joinToFirstReplyMs}ms`,
+    sayResponse.status() === 200 && joinToFirstReplyMs < BUDGETS.joinToFirstReplyMs, `${joinToFirstReplyMs}ms`);
+  ok(`${locale} run${runIndex}: the reply carries the person's own AI, never a teacher's`,
+    typeof sayBody?.reply === "string" && sayBody.reply.includes(room.displayName || ""));
+  ok(`${locale} run${runIndex}: total, cold tap to first reply, under ${BUDGETS.totalMs}ms`, totalMs < BUDGETS.totalMs, `${totalMs}ms`);
+
+  await context.close();
