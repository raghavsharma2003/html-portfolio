+  const published = await fetch(`${url}/api/room-publish`, {
+    method: "POST",
+    headers: { "content-type": "application/json", authorization: `Bearer ${REHEARSAL_OWNER_TOKEN}` },
+    body: JSON.stringify({ op: "publish", replica_id: rid }),
