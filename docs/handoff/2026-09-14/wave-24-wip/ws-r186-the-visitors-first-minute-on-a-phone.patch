+  const cdp = await context.newCDPSession(page);
+  await cdp.send("Network.enable");
+  await cdp.send("Network.emulateNetworkConditions", {
+    offline: false, latency: THROTTLE.latencyMs, downloadThroughput: THROTTLE.downloadBps, uploadThroughput: THROTTLE.uploadBps,
+  });
+  await cdp.send("Emulation.setCPUThrottlingRate", { rate: THROTTLE.cpuRate });
+
+  const t0 = Date.now();
+  await page.goto(`${url}/r/${room.slug}?via=search`, { waitUntil: "domcontentloaded" });
+
+  if (locale === "hi") {
+    await page.locator('.room-lang-switch button[lang="hi"]').click({ timeout: 15_000 });
+    await page.waitForFunction(
+      () => document.querySelector('.room-lang-switch button[lang="hi"]')?.getAttribute("aria-pressed") === "true",
+      null, { timeout: 10_000 },
+    );
+  }
+  await page.getByRole("button", { name: c.tasteJoin }).click({ timeout: 15_000 });
+  await page.waitForSelector(".room-join", { timeout: 10_000 });
+
+  // ── tap to about page readable (<3s, law 3) ────────────────────────────
+  const aboutHref = await page.locator(".room-about-link").getAttribute("href");
+  const tAboutStart = Date.now();
+  const aboutPage = await context.newPage();
+  await aboutPage.goto(`${url}${aboutHref}`, { waitUntil: "domcontentloaded" });
+  await aboutPage.locator("h1").first().waitFor({ state: "visible", timeout: 10_000 });
+  const tapToAboutMs = Date.now() - tAboutStart;
+  const aboutHeading = await aboutPage.locator("h1").first().innerText().catch(() => "");
+  ok(`${locale} run${runIndex}: the about page opens for real and reads within ${BUDGETS.tapToAboutMs}ms`,
+    aboutHeading === c.aboutHeading && tapToAboutMs < BUDGETS.tapToAboutMs, `${tapToAboutMs}ms heading=${JSON.stringify(aboutHeading)}`);
+  const aboutBodyText = await aboutPage.locator("body").innerText().catch(() => "");
+  ok(`${locale} run${runIndex}: the about page carries the person's own disclosure line`, aboutBodyText.includes(PERSON_LINE));
