+    return { vvh, sendBottom: send ? send.getBoundingClientRect().bottom : null };
+  });
+  ok(`${locale}: the composer's send button stays inside the visual viewport once a phone keyboard's own height is taken from it`,
+    afterShrink.sendBottom !== null && afterShrink.sendBottom <= afterShrink.vvh + 1, JSON.stringify(afterShrink));
+  await page.setViewportSize(VIEWPORT);
+
+  // ── visit 1 continues: ask, get a reply — the install card must stay
+  //    absent even though `talking` and `isIOS` both already hold. ────────
+  const beforeCount = await page.locator(".room-bubble.from-them").count();
+  await page.locator(".room-composer textarea").fill(locale === "hi" ? "आप कौन हैं?" : "Who are you?");
+  await Promise.all([
+    page.waitForResponse((r) => r.url().endsWith("/api/room") && r.request().postDataJSON()?.op === "say", { timeout: 15_000 }),
+    page.locator(".room-send").click(),
+  ]);
+  await page.waitForFunction((n) => document.querySelectorAll(".room-bubble.from-them").length > n, beforeCount, { timeout: 15_000 });
+  ok(`${locale}: NEGATIVE CONTROL — the install card never appears on a Room's first visit, even right after the first reply`,
+    (await page.locator(".room-cap[role=note]").count()) === 0);
+
+  // ── visit 2: same identity, same browser (same localStorage, so the
+  //    visit counter genuinely increments), the product's OWN real
+  //    second-visit rule now allows the card. ─────────────────────────────
+  await page.goto(`${url}/r/${room.slug}?via=search`, { waitUntil: "domcontentloaded" });
+  await page.waitForSelector(".room-composer textarea, .room-cap[role=note]", { timeout: 15_000 });
+  const cardVisible = await page.locator(".room-cap[role=note]").count();
+  ok(`${locale}: after the first reply, on the visit the product's own rule allows, the install card appears (iOS variant, static instructions)`,
+    cardVisible > 0);
+
+  await context.close();
+}
+
+/** Law 5's first two negative controls: a slug that was never published,
+ *  and the SAME room after its owner pauses it, both collapse to the
+ *  identical honest, deliberately vague page — never a distinct "paused"
+ *  message that would tell a stranger which creators took their Room down
+ *  (`copy.ts`'s own comment). Fetch-based for the never-published case
+ *  (a stranger's browser never even reaches a rendered page worth
+ *  screenshotting — the door itself is what refuses); a real cold browser
