+  const heading = await page.locator(".room-gone h2").first().innerText().catch(() => "");
+  const body = await page.locator(".room-gone .room-lede").first().innerText().catch(() => "");
+  ok(`${locale}: NEGATIVE CONTROL — a paused Room shows the SAME honest, deliberately vague page, inside the about-page budget (${BUDGETS.tapToAboutMs}ms)`,
+    heading === c.unavailableTitle && wallMs < BUDGETS.tapToAboutMs, `${wallMs}ms heading=${JSON.stringify(heading)}`);
+  ok(`${locale}: the honest page never claims a different reason for a paused Room than for one that was never published`,
+    /paused/i.test(body) && /old/i.test(body));
+  await context.close();
+}
+
+async function walkLocale(locale) {
+  console.log(`\n── the visitor's first minute on a phone (${locale}) ──`);
+  const bearer = locale === "hi" ? USER_B : USER_A;
+  const displayName = locale === "hi" ? "Rhea Kapoor" : "Maya Iyer";
+
+  const state = freshRehearsalCreatorState();
+  const { url, stop } = await startServer(state);
+  const { rid, room } = await publishPersonRoom(url, state, { displayName });
+  setFakeReply(() => `Hi, I am ${displayName}'s AI. Rehearsal reply, standing in for a real model call.`);
+
+  const launched = await launchRehearsalBrowser();
+  if (!launched.browser) { await stop(); throw new Error(`chromium launched for the probe above but not for the ${locale} walk: ${launched.reason}`); }
+  const browser = launched.browser;
+  const timings = [];
+  try {
+    for (let i = 1; i <= RUNS; i++) {
+      const timing = await measuredVisit(browser, url, room, locale, bearer, i);
+      timings.push(timing);
+      // A server-side reset before the NEXT cold context — this file's own
+      // header on why localStorage alone is not enough. Skipped after the
+      // LAST run: the negative controls that follow want this identity's
+      // history intact, matching a real returning stranger.
+      if (i < RUNS) await forgetFollower(url, timing.bearer, timing.session);
+    }
+
+    console.log(`\n  ${locale} wall clocks (ms), n=${RUNS}:`);
+    console.log(`  ${"run".padEnd(6)}${"tapToAbout".padStart(14)}${"joinToReply".padStart(14)}${"total".padStart(10)}`);
+    timings.forEach((t, i) => {
+      console.log(`  ${String(i + 1).padEnd(6)}${String(Math.round(t.tapToAboutMs)).padStart(14)}${String(Math.round(t.joinToFirstReplyMs)).padStart(14)}${String(Math.round(t.totalMs)).padStart(10)}`);
+    });
+    const medians = {
+      tapToAboutMs: median(timings.map((t) => t.tapToAboutMs)),
+      joinToFirstReplyMs: median(timings.map((t) => t.joinToFirstReplyMs)),
+      totalMs: median(timings.map((t) => t.totalMs)),
+    };
+    console.log(`  ${"median".padEnd(6)}${String(Math.round(medians.tapToAboutMs)).padStart(14)}${String(Math.round(medians.joinToFirstReplyMs)).padStart(14)}${String(Math.round(medians.totalMs)).padStart(10)}\n`);
+
+    // Between the timed runs above and the checks below, this identity's
+    // last follower row (from the final timed run, never forgotten) is
+    // still live — deliberate, `measuredVisit`'s own comment.
+    await forgetFollower(url, bearer, timings[timings.length - 1].session);
+
+    await checkJoinSheetKeyboardAndInstallPrompt(browser, url, room, locale, bearer);
+    // Pauses the Room — must run LAST, since every check above needs it
+    // published.
+    await checkUnreachableNegativeControls(browser, url, room, rid, locale, bearer);
+  } finally {
+    await browser.close();
+    await stop();
+  }
+  return timings;
+}
+
+ensureBuilt();
+
+const started = Date.now();
+const clocks = {};
+{
+  const t = Date.now();
+  await walkLocale("en");
+  clocks.walkEnMs = Date.now() - t;
+}
+if (FULL) {
+  const t = Date.now();
+  await walkLocale("hi");
+  clocks.walkHiMs = Date.now() - t;
+} else {
+  console.log("\n(Hindi walk skipped — set REHEARSAL_FULL=1 or pass --full to run it too. The English walk alone is what evals/run.mjs registers.)");
+}
+const wallMs = Date.now() - started;
+console.log(`\nwall clocks (ms): ${JSON.stringify(clocks)}, total ${wallMs}ms`);
+
+console.log(`\n${pass + fail} checks, ${pass} passed, ${fail} failed`);
+if (fail) {
+  console.error(`failed: ${failures.join(", ")}`);
+  process.exit(1);
+}
