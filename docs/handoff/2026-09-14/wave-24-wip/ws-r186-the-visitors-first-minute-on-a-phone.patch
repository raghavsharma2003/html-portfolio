+
+  const paused = await fetch(`${url}/api/room-publish`, {
+    method: "POST",
+    headers: { "content-type": "application/json", authorization: `Bearer ${REHEARSAL_OWNER_TOKEN}` },
+    body: JSON.stringify({ op: "pause", replica_id: rid }),
