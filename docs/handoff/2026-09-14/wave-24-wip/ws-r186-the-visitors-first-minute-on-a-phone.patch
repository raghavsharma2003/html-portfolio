+/** ONE measured, cold visit: taste dismiss -> about page (timed) -> join
+ *  (age + memory, minimum taps) -> ask one question -> the fake seam's reply
+ *  (timed), all under the real 4G throttle. Returns the three wall clocks
+ *  and leaves a real follower row behind, which the caller forgets before
+ *  the next run so the NEXT cold context is genuinely a stranger's first
+ *  visit at the server layer too (this file's own header, "why a server-side
+ *  reset"). */
+async function measuredVisit(browser, url, room, locale, bearer, runIndex) {
+  const c = FOLLOWER_COPY[locale];
+  const context = await browser.newContext({ viewport: VIEWPORT });
+  await context.addInitScript(authInitScript(bearer), { token: bearer });
+  const page = await context.newPage();
