+  const rid = createdBody.replica.replica_id;
+  const replica = state.replicas.find((r) => r.replica_id === rid);
+  // Minted opaquely at real runtime activation in production, out of this
+  // walk's own scope (`person-room.mjs`'s own identical shortcut, cited in
