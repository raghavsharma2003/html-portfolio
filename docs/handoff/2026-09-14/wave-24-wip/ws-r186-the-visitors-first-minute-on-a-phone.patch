+}
+
+/** Real cleanup between measured runs — this file's own header on why a
+ *  fresh browser context alone is not enough. */
+async function forgetFollower(url, bearer, session) {
+  const resp = await fetch(`${url}/api/room`, {
+    method: "POST",
+    headers: { "content-type": "application/json", authorization: `Bearer ${bearer}` },
