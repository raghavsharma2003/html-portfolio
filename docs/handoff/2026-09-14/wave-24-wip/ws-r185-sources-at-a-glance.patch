+/* Sources at a glance — WS-R185. Mobile-first (390px), desktop at 768px+.
+ * Tokens from design/tokens.css and studio.css's own palette; no new colour
+ * or radius scale introduced. */
+@layer components {
+  .sources-studio {
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-block, 24px);
+    max-width: 720px;
+  }
+
+  .sources-list {
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-item, 16px);
+  }
+
+  .sources-row {
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-tight, 8px);
+    border: 1px solid var(--line, rgba(28, 32, 26, 0.12));
+    border-radius: var(--radius-card, 16px);
+    padding: var(--space-item, 16px);
+  }
+  .sources-row[data-state="rejected"] { border-color: var(--danger-line, rgba(179, 38, 30, 0.35)); }
+  .sources-row[data-state="deleting"] { opacity: 0.6; }
+
+  .sources-row-head {
+    display: flex;
+    align-items: baseline;
+    gap: var(--space-tight, 8px);
+    flex-wrap: wrap;
+  }
+  .sources-row-kind {
+    font-size: var(--text-small, 12px);
+    text-transform: uppercase;
+    letter-spacing: 0.04em;
+    color: var(--ink-soft, #52564e);
+  }
+  .sources-row-name {
+    font-size: var(--text-body, 14px);
+    color: var(--ink, #171915);
+    word-break: break-word;
+  }
+  .sources-row-state {
+    margin: 0;
+    font-size: var(--text-small, 12px);
+    color: var(--ink-soft, #52564e);
+  }
+
+  .sources-row-yield {
+    margin: 0;
+    padding: 0;
+    list-style: none;
+    display: flex;
+    flex-wrap: wrap;
+    gap: var(--space-tight, 8px);
+  }
+  .sources-row-yield li {
+    font-size: var(--text-small, 12px);
+    background: var(--surface-raised, rgba(28, 32, 26, 0.05));
+    border-radius: var(--radius-pill, 999px);
+    padding: 4px 10px;
+    color: var(--ink-soft, #52564e);
+  }
+
+  .sources-row-remove {
+    align-self: flex-start;
+    min-height: 40px;
+    padding: 8px 16px;
+    border: 1px solid var(--line, rgba(28, 32, 26, 0.12));
+    border-radius: var(--radius-pill, 999px);
+    background: none;
+    color: var(--ink, #171915);
+    font-size: var(--text-body, 14px);
+    cursor: pointer;
+  }
+  .sources-row-remove:hover:not(:disabled) { border-color: var(--line-strong, rgba(28, 32, 26, 0.22)); }
+  .sources-row-remove:disabled { opacity: 0.6; cursor: default; }
+
+  .sources-empty {
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-tight, 8px);
+    padding: var(--space-block, 24px);
+    border: 1px dashed var(--line, rgba(28, 32, 26, 0.12));
+    border-radius: var(--radius-card, 16px);
+    color: var(--ink-soft, #52564e);
+  }
+
+  .sources-error {
+    display: flex;
+    align-items: center;
+    gap: var(--space-item, 16px);
+    color: var(--danger, #b3261e);
+  }
+
+  .sources-confirm-backdrop {
+    position: fixed;
+    inset: 0;
+    background: rgba(15, 17, 14, 0.45);
+    display: flex;
+    align-items: flex-end;
+    justify-content: center;
+    padding: var(--space-item, 16px);
+    z-index: 40;
+  }
+  @media (min-width: 768px) {
+    .sources-confirm-backdrop { align-items: center; }
+  }
+
+  .sources-confirm {
+    width: 100%;
+    max-width: 420px;
+    background: var(--surface, #fdfcf8);
+    border-radius: var(--radius-card, 16px);
+    padding: var(--space-block, 24px);
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-item, 16px);
+  }
+  .sources-confirm h2 { margin: 0; font-size: var(--text-title, 18px); color: var(--ink, #171915); }
+  .sources-confirm-target { margin: 0; font-size: var(--text-small, 12px); color: var(--ink-soft, #52564e); word-break: break-word; }
+  .sources-confirm ul { margin: 0; padding-left: 1.2em; color: var(--ink-soft, #52564e); font-size: var(--text-body, 14px); }
+  .sources-confirm p { margin: 0; color: var(--ink-soft, #52564e); font-size: var(--text-body, 14px); }
+
+  .sources-confirm-actions {
+    display: flex;
+    gap: var(--space-tight, 8px);
+    justify-content: flex-end;
+    flex-wrap: wrap;
+  }
+  .sources-confirm-actions button {
+    min-height: 44px;
+    padding: 8px 18px;
+    border-radius: var(--radius-pill, 999px);
+    border: 1px solid var(--line, rgba(28, 32, 26, 0.12));
+    background: none;
+    font-size: var(--text-body, 14px);
+    cursor: pointer;
+  }
+  .sources-confirm-remove {
+    background: var(--danger, #b3261e);
+    border-color: var(--danger, #b3261e);
+    color: #fff;
+  }
+  .sources-confirm-actions button:disabled { opacity: 0.6; cursor: default; }
+}
