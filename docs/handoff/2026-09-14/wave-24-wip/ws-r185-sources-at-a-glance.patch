+// WS-R185. THE "WHAT GOES WITH IT" READ, before the tap. It answers the exact
+// question `markOwnedSourceDeleting` above is about to act on, from the same
+// tables `completeSourceErasure` eventually settles: a claim CITING ONLY THIS
+// SOURCE (`cardinality(source_ids)=1`) has no other evidence to fall back on,
+// so removing this source is the one thing that actually erases it, not just
+// invalidates one of several citations. A claim with other citations still
+// gets superseded by `markOwnedSourceDeleting` (it invalidates every claim
+// naming this source, not only the singly-cited ones — see that function's
+// own `invalidated` CTE), but it is not what removing THIS source, alone,
+// takes away, so it is deliberately not counted here. Read-only: it changes
+// nothing, so a studio can show this preview on every render of a Remove
+// control without cost.
+//
+// Three negative controls this function must answer honestly, not just not
+// crash on: a stranger's bearer never reaches this function at all (the door
+// requires an owner session first); another owner's source id, and a source
+// already `deleting`, both resolve to `null` here — the same "not found"
+// answer a client cannot use to enumerate someone else's sources or replay a
+// stale receipt.
+export async function ownedSourceRemovalPreview(db, ownerUserId, id, source) {
+  const rid = replicaId(id);
+  const sid = replicaId(source);
+  const rows = await db(
+    `select s.source_id, s.kind, s.duration_ms,
+            exists (
+              select 1 from vy_replica_voice_reference vr
+               where vr.replica_id = s.replica_id and vr.owner_user_id = s.owner_user_id
+                 and vr.source_id = s.source_id
+            ) is_primary_voice,
+            coalesce((
+              select count(*) from vy_replica_claim c
+               where c.replica_id = s.replica_id and c.owner_user_id = s.owner_user_id
+                 and s.source_id = any(c.source_ids) and cardinality(c.source_ids) = 1
+                 and c.status in ('proposed', 'approved')
+            ), 0) claims_only_here
+       from vy_replica_source s
+      where s.replica_id = $1::uuid and s.owner_user_id = $2::uuid and s.source_id = $3::uuid
+        and s.state <> 'deleting'
+      limit 1`,
+    [rid, ownerUserId, sid],
+  );
+  const row = rows[0];
+  if (!row) return null;
+  const durationMs = row.duration_ms == null ? null : Number(row.duration_ms);
+  const isMedia = row.kind === "audio" || row.kind === "video";
+  return Object.freeze({
+    source_id: row.source_id,
+    claims_only_here: Number(row.claims_only_here) || 0,
+    voice_seconds: isMedia && durationMs != null ? Math.round(durationMs / 1000) : 0,
+    is_primary_voice: Boolean(row.is_primary_voice),
+  });
+}
