@@ -0,0 +1,74 @@
+// sourcesApi.ts — WS-R185. fetch wrapper for the Sources at a glance screen,
+// following the existing *Api.ts pattern (see contextLockerApi.ts,
+// enrollmentApi.ts). Two owner-only reads, plus the dispatch that sends
+// "Remove" to whichever EXISTING single-source erasure a source's kind
+// already uses — this file adds no new erasure of its own.
+import { replicaRequest } from "./replicaApi";
+import { removeContextItem } from "./contextLockerApi";
+import { deleteSource } from "./enrollmentApi";
+
+export type SourceGlanceKind = "recording" | "file" | "link" | "call";
+
+export interface SourceYield {
+  claims_accepted: number;
+  facts_drafted: number;
+  voice_seconds: number;
+}
+
+export interface SourceGlance {
+  source_id: string;
+  kind: SourceGlanceKind;
+  /** Present only for a file/link that lives in the Context Locker — the
+   *  handle "Remove" needs to call the existing `DELETE /api/context-items`
+   *  door instead of `POST /api/replica-source {op:"delete"}`. */
+  item_id: string | null;
+  /** The owner's own file name or link, or empty when none was ever given
+   *  (a recording or a call names no file at all). Never a storage path. */
+  display_name: string;
+  state: string;
+  contains_third_parties: boolean;
+  rejection_code: string;
+  yielded: SourceYield;
+  created_at: string | null;
+}
+
+export interface SourceRemovalPreview {
+  source_id: string;
+  /** Claims with no other citation — removing this source is the one thing
+   *  that actually erases them, not merely one of several citations. */
+  claims_only_here: number;
+  voice_seconds: number;
+  is_primary_voice: boolean;
+}
+
+export async function loadSourcesGlance(token: string, replicaId: string, signal?: AbortSignal): Promise<SourceGlance[]> {
+  const data = await replicaRequest<{ sources: SourceGlance[] }>(token, "/api/replica-source", {
+    method: "POST",
+    body: JSON.stringify({ op: "overview", replica_id: replicaId }),
+    signal,
+  });
+  return Array.isArray(data.sources) ? data.sources : [];
+}
+
+export async function loadSourceRemovalPreview(token: string, replicaId: string, sourceId: string, signal?: AbortSignal): Promise<SourceRemovalPreview> {
+  const data = await replicaRequest<{ preview: SourceRemovalPreview }>(token, "/api/replica-source", {
+    method: "POST",
+    body: JSON.stringify({ op: "removal_preview", replica_id: replicaId, source_id: sourceId }),
+    signal,
+  });
+  return data.preview;
+}
+
+/** "Remove" calls the SAME door the source's own owning panel already uses —
+ *  a Context Locker file/link through `removeContextItem` (which also
+ *  retracts the item and its still-undecided proposal), everything else
+ *  through `POST /api/replica-source {op:"delete"}` (`markOwnedSourceDeleting`
+ *  — the recorder's and a call's own single-source erasure). This file adds
+ *  no third erasure path of its own. */
+export async function removeSourceGlanceEntry(token: string, replicaId: string, source: SourceGlance): Promise<void> {
+  if (source.item_id) {
+    await removeContextItem(token, replicaId, source.item_id);
+    return;
+  }
+  await deleteSource(token, replicaId, source.source_id);
+}
