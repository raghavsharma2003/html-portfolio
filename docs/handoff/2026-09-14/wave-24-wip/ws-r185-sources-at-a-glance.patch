new file mode 100644
index 0000000..03caf50
--- /dev/null
+++ b/src/studio/SourcesStudio.tsx
@@ -0,0 +1,218 @@
+// SourcesStudio.tsx — WS-R185. Sources at a glance.
+//
+// The recorder, the Context Locker (files and links) and a Mirror Call each
+// land what the owner gives them in a different panel, under a different
+// word. This screen is the one list that ties them together: what it is,
+// what state it is in (in plain words, never a raw code), and what it
+// yielded — as counts, never a claim's own text. It replaces none of those
+// panels; "Add more" and HumanOS still reach them directly.
+//
+// "Remove" shows what goes with a source BEFORE the tap (`loadSourceRemoval
+// Preview`, reading the exact tables the removal will act on), and calls the
+// SAME existing single-source erasure that source's own panel already uses
+// (`removeSourceGlanceEntry`) — this screen adds no new erasure path.
+import { useCallback, useEffect, useRef, useState } from "react";
+import "./sources-studio.css";
+import { ReplicaApiError } from "./replicaApi";
+import {
+  loadSourcesGlance,
+  loadSourceRemovalPreview,
+  removeSourceGlanceEntry,
+  type SourceGlance,
+  type SourceRemovalPreview,
+} from "./sourcesApi";
+import { useStudioLocale } from "./localeContext";
+import type { SourcesStudioCopy } from "./copy";
+
+type SourcesStudioProps = {
+  token: string;
+  replicaId: string;
+  onAuthError: (cause: unknown) => void;
+};
+
+function stateLabel(copy: SourcesStudioCopy, source: SourceGlance): string {
+  if (source.state === "quarantined" && source.contains_third_parties) return copy.stateLabels.quarantined_third_parties;
+  const known = copy.stateLabels[source.state as keyof SourcesStudioCopy["stateLabels"]];
+  return known || source.state.replaceAll("_", " ");
+}
+
+function displayName(copy: SourcesStudioCopy, source: SourceGlance, dateFormat: Intl.DateTimeFormat): string {
+  if (source.display_name) return source.display_name;
+  const date = source.created_at ? dateFormat.format(new Date(source.created_at)) : "";
+  return copy.unnamedLabelTemplate.replace("{kind}", copy.kindLabels[source.kind]).replace("{date}", date);
+}
+
+function SourceRow({ source, copy, dateFormat, onRemove, busy }: {
+  source: SourceGlance;
+  copy: SourcesStudioCopy;
+  dateFormat: Intl.DateTimeFormat;
+  onRemove: (source: SourceGlance) => void;
+  busy: boolean;
+}) {
+  const { claims_accepted, facts_drafted, voice_seconds } = source.yielded;
+  return (
+    <article className="sources-row" data-state={source.state}>
+      <div className="sources-row-head">
+        <span className="sources-row-kind">{copy.kindLabels[source.kind]}</span>
+        <strong className="sources-row-name">{displayName(copy, source, dateFormat)}</strong>
+      </div>
+      <p className="sources-row-state">{stateLabel(copy, source)}</p>
+      {(claims_accepted > 0 || facts_drafted > 0 || voice_seconds > 0) && (
+        <ul className="sources-row-yield" aria-label={copy.title}>
+          {claims_accepted > 0 && <li>{copy.claimsAcceptedTemplate.replace("{n}", String(claims_accepted))}</li>}
+          {facts_drafted > 0 && <li>{copy.factsDraftedTemplate.replace("{n}", String(facts_drafted))}</li>}
+          {voice_seconds > 0 && <li>{copy.voiceSecondsTemplate.replace("{n}", String(voice_seconds))}</li>}
+        </ul>
+      )}
+      <button type="button" className="sources-row-remove" disabled={busy} onClick={() => onRemove(source)}>
+        {busy ? copy.removing : copy.removeButton}
+      </button>
+    </article>
+  );
+}
+
+function RemoveConfirm({ source, copy, preview, previewError, onCancel, onConfirm, busy }: {
+  source: SourceGlance;
+  copy: SourcesStudioCopy;
+  preview: SourceRemovalPreview | null;
+  previewError: string;
+  onCancel: () => void;
+  onConfirm: () => void;
+  busy: boolean;
+}) {
+  return (
+    <div className="sources-confirm-backdrop" role="presentation" onClick={onCancel}>
+      <div className="sources-confirm" role="alertdialog" aria-labelledby="sources-confirm-title" aria-describedby="sources-confirm-body" onClick={(event) => event.stopPropagation()}>
+        <h2 id="sources-confirm-title">{copy.confirmTitle}</h2>
+        <p className="sources-confirm-target">{copy.kindLabels[source.kind]}{source.display_name ? `: ${source.display_name}` : ""}</p>
+        <div id="sources-confirm-body">
+          {!preview && !previewError ? (
+            <p role="status">{copy.confirmLoadingPreview}</p>
+          ) : previewError ? (
+            <p role="alert">{previewError}</p>
+          ) : (
+            <ul>
+              {preview!.claims_only_here > 0 && <li>{copy.confirmClaimsTemplate.replace("{n}", String(preview!.claims_only_here))}</li>}
+              {preview!.voice_seconds > 0 && <li>{copy.confirmVoiceTemplate.replace("{n}", String(preview!.voice_seconds))}</li>}
+              {preview!.claims_only_here === 0 && preview!.voice_seconds === 0 && <li>{copy.confirmNothingElse}</li>}
+              {preview!.is_primary_voice && <li>{copy.confirmPrimaryVoiceWarning}</li>}
+            </ul>
+          )}
+        </div>
+        <div className="sources-confirm-actions">
+          <button type="button" onClick={onCancel} disabled={busy}>{copy.confirmCancel}</button>
+          <button type="button" className="sources-confirm-remove" onClick={onConfirm} disabled={busy || (!preview && !previewError)}>
+            {busy ? copy.removing : copy.confirmRemove}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export default function SourcesStudio(props: SourcesStudioProps) {
+  return <ScopedSourcesStudio key={`${props.replicaId}:${props.token}`} {...props} />;
+}
+
+function ScopedSourcesStudio({ token, replicaId, onAuthError }: SourcesStudioProps) {
+  const { locale, t } = useStudioLocale();
+  const copy = t.sourcesStudio;
+  const mounted = useRef(false);
+  const revision = useRef(0);
+  useEffect(() => {
+    mounted.current = true;
+    return () => { mounted.current = false; revision.current++; };
+  }, []);
+
+  const [sources, setSources] = useState<SourceGlance[] | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+  const [target, setTarget] = useState<SourceGlance | null>(null);
+  const [preview, setPreview] = useState<SourceRemovalPreview | null>(null);
+  const [previewError, setPreviewError] = useState("");
+  const [busy, setBusy] = useState("");
+
+  const load = useCallback(async () => {
+    const mine = ++revision.current;
+    setLoading(true);
+    setError("");
+    try {
+      const result = await loadSourcesGlance(token, replicaId);
+      if (!mounted.current || mine !== revision.current) return;
+      setSources(result);
+    } catch (cause) {
+      if (!mounted.current || mine !== revision.current) return;
+      if (cause instanceof ReplicaApiError && cause.status === 401) return onAuthError(cause);
+      setError(cause instanceof Error ? cause.message : copy.errorLoadFailed);
+    } finally {
+      if (mounted.current && mine === revision.current) setLoading(false);
+    }
+  }, [token, replicaId, onAuthError, copy.errorLoadFailed]);
+
+  useEffect(() => { void load(); }, [load]);
+
+  async function openConfirm(source: SourceGlance) {
+    setTarget(source);
+    setPreview(null);
+    setPreviewError("");
+    try {
+      const result = await loadSourceRemovalPreview(token, replicaId, source.source_id);
+      if (!mounted.current) return;
+      setPreview(result);
+    } catch (cause) {
+      if (!mounted.current) return;
+      if (cause instanceof ReplicaApiError && cause.status === 401) return onAuthError(cause);
+      setPreviewError(cause instanceof Error ? cause.message : copy.errorPreviewFailed);
+    }
+  }
+
+  async function confirmRemove() {
+    if (!target || busy) return;
+    setBusy(target.source_id);
+    try {
+      await removeSourceGlanceEntry(token, replicaId, target);
+      if (!mounted.current) return;
+      setTarget(null);
+      setPreview(null);
+      await load();
+    } catch (cause) {
+      if (!mounted.current) return;
+      if (cause instanceof ReplicaApiError && cause.status === 401) return onAuthError(cause);
+      setPreviewError(cause instanceof Error ? cause.message : copy.errorRemoveFailed);
+    } finally {
+      if (mounted.current) setBusy("");
+    }
+  }
+
+  const dateFormat = new Intl.DateTimeFormat(locale === "hi" ? "hi-IN" : "en-IN", { dateStyle: "medium" });
+
+  return (
+    <section id="sources-studio" className="sources-studio" aria-labelledby="sources-studio-title">
+      <p className="eyebrow">{copy.eyebrow}</p>
+      <h2 id="sources-studio-title">{copy.title}</h2>
+      <p>{copy.intro}</p>
+      {loading ? (
+        <p role="status">{copy.loading}</p>
+      ) : error ? (
+        <div className="sources-error" role="alert"><span>{error}</span><button type="button" onClick={() => void load()}>{copy.retry}</button></div>
+      ) : sources && sources.length ? (
+        <div className="sources-list">
+          {sources.map((source) => (
+            <SourceRow key={source.source_id} source={source} copy={copy} dateFormat={dateFormat}
+              onRemove={(item) => void openConfirm(item)} busy={busy === source.source_id} />
+          ))}
+        </div>
+      ) : (
+        <div className="sources-empty">
+          <strong>{copy.emptyHeadline}</strong>
+          <p>{copy.emptyNote}</p>
+        </div>
+      )}
+      {target ? (
+        <RemoveConfirm source={target} copy={copy} preview={preview} previewError={previewError}
+          onCancel={() => { setTarget(null); setPreview(null); setPreviewError(""); }}
+          onConfirm={() => void confirmRemove()} busy={busy === target.source_id} />
+      ) : null}
+    </section>
+  );
+}
