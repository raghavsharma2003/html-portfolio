+// WS-R185. SOURCES AT A GLANCE — one owner-only read that answers "what did I
+// give it, and where from?" across every panel that can create a source: the
+// recorder and Add more's voice/interview capture (`purpose='memory'`), the
+// Context Locker's files and links (`purpose='context_item'`, joined to
+// `vy_context_item` for the name the owner actually gave it — never the
+// object_path, which `privateObjectPath` never even hands back here), and a
+// Mirror Call's audio turns or a stand-alone interview recording (both read
+// as "call"). `identity_document`, `identity_challenge`, `correction` and
+// `comparison_reference` sources are deliberately excluded: none of them is
+// something the owner thinks of as "context they gave it" and none is a row
+// this screen's "Remove" flow can act on the way this file's Remove acts on
+// everything else. A YouTube channel watch (`vy_channel_watch`) is EXCLUDED
+// too, and for a different reason: it never creates a `vy_replica_source`
+// row at all — content lands as a delta on a `vy_teacher_sheet` field, not a
+// citable claim — so there is no "single-source erasure" for this screen's
+// Remove to call on it. See context/decisions.md#ws-r185-sources-at-a-glance
+// and context/rejected.md#ws-r185-channel-watch-excluded-from-sources-list.
+// A source in `state='deleting'` is excluded outright: Remove already
+// happened for it, and a list titled "what did I give it" that kept
+// showing a row the owner just removed would be exactly the
+// `plausible-return-hides-a-dead-pipeline` failure this list exists to
+// avoid — the owner tapped Remove and the screen quietly kept lying.
+function clientSourceOverviewKind(row) {
+  if (row.capture_mode === "derived" || row.purpose === "interview") return "call";
+  if (row.purpose === "context_item") return row.item_kind === "link" ? "link" : "file";
+  return row.kind === "audio" || row.kind === "video" ? "recording" : "file";
+}
+
+/** COUNT-SHAPED, NEVER A CLAIM'S TEXT. `display_name` is the owner's own file
+ *  name or link, taken from `vy_context_item.source_name`/`source_url` — the
+ *  ONLY place a source's original name is ever retained (`createPendingSource`
+ *  writes `filename_retained:false` into every `vy_replica_source.provenance`
+ *  on purpose). A recording or a call carries no such name, so it comes back
+ *  empty and the client renders the kind label plus the date instead of
+ *  guessing a name that was never given. */
+export function clientSourceOverview(row) {
+  const durationMs = row.duration_ms == null ? null : Number(row.duration_ms);
+  const isMedia = row.kind === "audio" || row.kind === "video";
+  return {
+    source_id: row.source_id,
+    kind: clientSourceOverviewKind(row),
+    item_id: row.item_id || null,
+    display_name: row.purpose === "context_item"
+      ? String(row.source_name || row.source_url || "").slice(0, 200)
+      : "",
+    state: row.state,
+    contains_third_parties: Boolean(row.contains_third_parties),
+    rejection_code: row.rejection_code || "",
+    yielded: {
+      claims_accepted: Number(row.claims_accepted) || 0,
+      facts_drafted: Number(row.claims_proposed) || 0,
+      voice_seconds: isMedia && durationMs != null ? Math.round(durationMs / 1000) : 0,
+    },
+    created_at: row.created_at,
+  };
+}
+
+/** One list, every panel. The claim counts are read live from
+ *  `vy_replica_claim` (the table the person model already reviews from) rather
+ *  than duplicated anywhere, so this screen and PersonModelStudio can never
+ *  disagree about how many claims a source produced. */
+export async function listOwnedSourcesOverview(db, ownerUserId, id) {
+  const rid = replicaId(id);
+  const rows = await db(
+    `select s.source_id, s.kind, s.capture_mode, s.purpose, s.state, s.contains_third_parties,
+            s.rejection_code, s.duration_ms, s.created_at,
+            ci.item_id, ci.kind as item_kind, ci.source_name, ci.source_url,
+            coalesce(yc.claims_accepted, 0) claims_accepted,
+            coalesce(yc.claims_proposed, 0) claims_proposed
+       from vy_replica_source s
+       left join vy_context_item ci
+         on ci.source_id = s.source_id and ci.replica_id = s.replica_id and ci.owner_user_id = s.owner_user_id
+       left join lateral (
+         select count(*) filter (where c.status = 'approved') claims_accepted,
+                count(*) filter (where c.status = 'proposed') claims_proposed
+           from vy_replica_claim c
+          where c.replica_id = s.replica_id and c.owner_user_id = s.owner_user_id
+            and s.source_id = any(c.source_ids)
+       ) yc on true
+      where s.replica_id = $1::uuid and s.owner_user_id = $2::uuid and s.state <> 'deleting'
+        and (s.purpose in ('memory', 'context_item', 'interview')
+          or (s.capture_mode = 'derived' and s.provenance->>'purpose' = 'mirror_window'))
+      order by s.created_at desc limit 200`,
+    [rid, ownerUserId],
+  );
+  return rows.map(clientSourceOverview);
+}
