+// before the tap (`api/_replica-source-erasure.js#ownedSourceRemovalPreview`),
+// and the door (`api/replica-source.js`) and client dispatch
+// (`src/studio/sourcesApi.ts`) that wire them to the screen.
+//
+// Sections 1-2 drive the REAL decision modules with a fake `db`, the house
+// shape `evals/source-storage-writer/run.mjs` and `evals/primary-voice-
+// source/run.mjs` already use (`dead-writers`: the database is absent in
+// this environment, so a test that lived only against the HTTP door would
+// be a test nothing could ever run). Sections 3-4 are static, `stripComments`-
+// gated scans of `api/replica-source.js` and `src/studio/sourcesApi.ts` —
+// proving the door and the client dispatch wire to the real functions,
+// without importing the door itself, which resolves `./_db.js` to the real,
+// secrets-only `api/_config.js` at module load time (absent in this
+// environment; `evals/rehearsal/personal.mjs`'s own `loader.mjs` redirect is
+// the harness that exercises the door end to end, and that walk gained a
+// "Sources" step in this same commit).
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { stripComments } from "../lib/source-scan.mjs";
+import {
+  clientSourceOverview,
+  listOwnedSourcesOverview,
+} from "../../api/_replica-source.js";
+import { ownedSourceRemovalPreview } from "../../api/_replica-source-erasure.js";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "../..");
+const read = (path) => readFileSync(join(ROOT, path), "utf8");
+
+const RID = "11111111-1111-4111-8111-111111111111";
+const OWNER = "22222222-2222-4222-8222-222222222222";
+const SID = "33333333-3333-4333-8333-333333333333";
+
+let checks = 0;
+function ok(name, condition, detail) {
+  assert.ok(condition, detail ? `${name} — ${detail}` : name);
+  console.log(`ok ${++checks} - ${name}`);
+}
+
+// ── 1. clientSourceOverview: the kind derivation and display_name rules ───
+
+ok("a memory-purpose audio source reads as a recording, with no name given",
+  clientSourceOverview({
+    source_id: SID, kind: "audio", capture_mode: "upload", purpose: "memory", state: "ready",
+    contains_third_parties: false, rejection_code: "", duration_ms: 30_000, created_at: "2026-09-14T00:00:00Z",
+    item_id: null, item_kind: null, source_name: null, source_url: null, claims_accepted: 0, claims_proposed: 0,
+  }).kind === "recording"
+  && clientSourceOverview({
+    source_id: SID, kind: "audio", capture_mode: "upload", purpose: "memory", state: "ready",
+    contains_third_parties: false, rejection_code: "", duration_ms: 30_000, created_at: "2026-09-14T00:00:00Z",
+    item_id: null, item_kind: null, source_name: null, source_url: null, claims_accepted: 0, claims_proposed: 0,
+  }).display_name === "");
+
+ok("a context_item file reads as file, named from vy_context_item.source_name, never the object_path",
+  clientSourceOverview({
+    source_id: SID, kind: "text", capture_mode: "upload", purpose: "context_item", state: "ready",
+    contains_third_parties: false, rejection_code: "", duration_ms: null, created_at: "2026-09-14T00:00:00Z",
+    item_id: "item-1", item_kind: "file", source_name: "notes.txt", source_url: "",
+    claims_accepted: 0, claims_proposed: 0,
+  }).display_name === "notes.txt");
+
+ok("a context_item link reads as link, named from vy_context_item.source_url",
+  clientSourceOverview({
+    source_id: SID, kind: "text", capture_mode: "upload", purpose: "context_item", state: "extracted",
+    contains_third_parties: false, rejection_code: "", duration_ms: null, created_at: "2026-09-14T00:00:00Z",
+    item_id: "item-2", item_kind: "link", source_name: "", source_url: "https://example.com/a",
+    claims_accepted: 0, claims_proposed: 0,
+  }).kind === "link");
+
+ok("derived audio (a Mirror Call turn) reads as call",
+  clientSourceOverview({
+    source_id: SID, kind: "audio", capture_mode: "derived", purpose: "memory", state: "quarantined",
+    contains_third_parties: false, rejection_code: "", duration_ms: 4_000, created_at: "2026-09-14T00:00:00Z",
+    item_id: null, item_kind: null, source_name: null, source_url: null, claims_accepted: 0, claims_proposed: 0,
+  }).kind === "call");
+
+ok("a stand-alone interview recording reads as call",
+  clientSourceOverview({
+    source_id: SID, kind: "video", capture_mode: "upload", purpose: "interview", state: "ready",
+    contains_third_parties: false, rejection_code: "", duration_ms: 120_000, created_at: "2026-09-14T00:00:00Z",
+    item_id: null, item_kind: null, source_name: null, source_url: null, claims_accepted: 0, claims_proposed: 0,
+  }).kind === "call");
+
+const yielded = clientSourceOverview({
+  source_id: SID, kind: "audio", capture_mode: "upload", purpose: "memory", state: "ready",
+  contains_third_parties: false, rejection_code: "", duration_ms: 90_500, created_at: "2026-09-14T00:00:00Z",
+  item_id: null, item_kind: null, source_name: null, source_url: null, claims_accepted: 3, claims_proposed: 2,
+}).yielded;
+ok("what it yielded is count-shaped only: claims_accepted, facts_drafted, voice_seconds",
+  yielded.claims_accepted === 3 && yielded.facts_drafted === 2 && yielded.voice_seconds === 91
+  && Object.keys(yielded).length === 3);
+
+ok("a non-media source never reports voice_seconds even with a stray duration_ms",
+  clientSourceOverview({
+    source_id: SID, kind: "text", capture_mode: "upload", purpose: "context_item", state: "ready",
+    contains_third_parties: false, rejection_code: "", duration_ms: 5_000, created_at: "2026-09-14T00:00:00Z",
+    item_id: "item-3", item_kind: "file", source_name: "a.txt", source_url: "", claims_accepted: 0, claims_proposed: 0,
+  }).yielded.voice_seconds === 0);
+
+// ── 2. listOwnedSourcesOverview / ownedSourceRemovalPreview: real SQL, fake db ──
+
+{
+  let sql = "", params = null;
+  const db = async (q, p) => { sql = q; params = p; return [{
+    source_id: SID, kind: "audio", capture_mode: "upload", purpose: "memory", state: "ready",
+    contains_third_parties: false, rejection_code: "", duration_ms: 12_000, created_at: "2026-09-14T00:00:00Z",
+    item_id: null, item_kind: null, source_name: null, source_url: null, claims_accepted: 1, claims_proposed: 0,
+  }]; };
+  const rows = await listOwnedSourcesOverview(db, OWNER, RID);
+  ok("listOwnedSourcesOverview scopes the read to the exact owner and replica",
+    JSON.stringify(params) === JSON.stringify([RID, OWNER]));
+  ok("listOwnedSourcesOverview joins vy_context_item for the owner's own name, never the object_path",
+    /left join vy_context_item/.test(sql) && !/object_path/.test(sql));
+  ok("listOwnedSourcesOverview reads claim counts live from vy_replica_claim, never a duplicated cache",
+    /vy_replica_claim c/.test(sql) && /claims_accepted/.test(sql) && /claims_proposed/.test(sql));
+  ok("listOwnedSourcesOverview excludes a source Remove already erased (state='deleting')",
+    /s\.state\s*<>\s*'deleting'/.test(sql));
+  ok("listOwnedSourcesOverview never names comparison_reference, identity_document or identity_challenge",
+    !/comparison_reference/.test(sql) && !/identity_document/.test(sql) && !/identity_challenge/.test(sql));
+  ok("the mapped row carries a real state and a count-shaped yield", rows[0].state === "ready" && rows[0].yielded.claims_accepted === 1);
+}
+
+// NEGATIVE CONTROL: a malformed replica_id is refused before any query runs.
+await assert.rejects(() => listOwnedSourcesOverview(async () => [], OWNER, "not-a-uuid"), /valid replica_id required/);
+console.log(`ok ${++checks} - NEGATIVE CONTROL — listOwnedSourcesOverview rejects a malformed replica_id`);
+
+{
+  let sql = "", params = null;
+  const db = async (q, p) => { sql = q; params = p; return [{
+    source_id: SID, kind: "audio", duration_ms: 8_000, is_primary_voice: true, claims_only_here: 2,
+  }]; };
+  const preview = await ownedSourceRemovalPreview(db, OWNER, RID, SID);
+  ok("ownedSourceRemovalPreview scopes to owner, replica AND the exact source",
+    JSON.stringify(params) === JSON.stringify([RID, OWNER, SID]));
+  ok("ownedSourceRemovalPreview counts only claims with NO OTHER citation (cardinality(source_ids)=1)",
+    /cardinality\(c\.source_ids\)\s*=\s*1/.test(sql));
+  ok("ownedSourceRemovalPreview excludes a source already in state='deleting'", /s\.state\s*<>\s*'deleting'/.test(sql));
+  ok("the preview reports what removing this source actually takes away",
+    preview.claims_only_here === 2 && preview.voice_seconds === 8 && preview.is_primary_voice === true);
+}
+
+// NEGATIVE CONTROL (source-storage-writer/primary-voice-source's own class):
+// another owner's source id, and a source already erased, both answer null —
+// the same "not found" a stranger's bearer gets from the door, never a leak.
+{
+  const empty = async () => [];
+  const anotherOwnersSource = await ownedSourceRemovalPreview(empty, OWNER, RID, SID);
+  ok("NEGATIVE CONTROL — another owner's/unknown source id answers null, never a row", anotherOwnersSource === null);
+}
+await assert.rejects(() => ownedSourceRemovalPreview(async () => [], OWNER, RID, "not-a-uuid"));
+console.log(`ok ${++checks} - NEGATIVE CONTROL — ownedSourceRemovalPreview rejects a malformed source id`);
+
+// ── 3. The door wiring — static, stripComments-gated (no `./_db.js` import) ──
+
+const door = stripComments(read("api/replica-source.js"));
+ok('api/replica-source.js wires op:"overview" to listOwnedSourcesOverview',
+  /op\s*===\s*"overview"[\s\S]{0,200}listOwnedSourcesOverview/.test(door));
+ok('api/replica-source.js wires op:"removal_preview" to ownedSourceRemovalPreview and answers 404 on null',
+  /op\s*===\s*"removal_preview"[\s\S]{0,400}ownedSourceRemovalPreview[\s\S]{0,200}404/.test(door));
+ok("api/replica-source.js imports both new functions from the REAL decision modules, not a local reimplementation",
+  /import\s*\{[^}]*listOwnedSourcesOverview[^}]*\}\s*from\s*"\.\/_replica-source\.js"/.test(door)
+  && /import\s*\{\s*ownedSourceRemovalPreview\s*\}\s*from\s*"\.\/_replica-source-erasure\.js"/.test(door));
+
+// ── 4. The client dispatch — Remove calls the EXISTING single-source erasure ──
+
+const clientApi = stripComments(read("src/studio/sourcesApi.ts"));
+ok("sourcesApi.ts routes a Context Locker item's Remove through the EXISTING removeContextItem door",
+  /if\s*\(\s*source\.item_id\s*\)\s*\{[\s\S]{0,120}removeContextItem/.test(clientApi));
+ok("sourcesApi.ts routes every other kind's Remove through the EXISTING deleteSource door, and builds no third erasure of its own",
+  /await\s+deleteSource\(/.test(clientApi) && !/op:\s*"delete"/.test(clientApi));
+ok("sourcesApi.ts imports both erasure calls from the panels that already own them, not a reimplementation",
+  /import\s*\{\s*removeContextItem\s*\}\s*from\s*"\.\/contextLockerApi"/.test(clientApi)
+  && /import\s*\{\s*deleteSource\s*\}\s*from\s*"\.\/enrollmentApi"/.test(clientApi));
+
+// ── 5. Both locales carry the SAME closed block, key for key ──────────────
+
+const en = stripComments(read("src/studio/copy.ts"));
+const hi = stripComments(read("src/studio/hiCopy.ts"));
+ok("copy.ts declares the sourcesStudio section", /sourcesStudio:\s*SourcesStudioCopy;/.test(en));
+ok("copy.ts's EN table and hiCopy.ts's HI table both carry a sourcesStudio block",
+  /const EN_SOURCES_STUDIO:\s*SourcesStudioCopy\s*=/.test(en) && /const HI_SOURCES_STUDIO:\s*SourcesStudioCopy\s*=/.test(hi));
+ok("both tables are wired into their exported StudioCopy object (never orphaned)",
+  /sourcesStudio:\s*EN_SOURCES_STUDIO,/.test(en) && /sourcesStudio:\s*HI_SOURCES_STUDIO,/.test(hi));
+
+function objectKeys(source, constName) {
+  const match = source.match(new RegExp(`const ${constName}[^=]*=\\s*\\{([\\s\\S]*?)\\n\\};`));
+  assert.ok(match, `${constName} not found`);
+  const keys = [...match[1].matchAll(/^\s*([a-zA-Z_][a-zA-Z0-9_]*):/gm)].map((m) => m[1]);
+  assert.ok(keys.length > 5, `${constName} read suspiciously few keys (${keys.length})`);
+  return keys.sort();
+}
+const enKeys = objectKeys(en, "EN_SOURCES_STUDIO");
+const hiKeys = objectKeys(hi, "HI_SOURCES_STUDIO");
+ok("the EN and HI sourcesStudio blocks declare the exact same top-level keys",
+  JSON.stringify(enKeys) === JSON.stringify(hiKeys), `en=${JSON.stringify(enKeys)} hi=${JSON.stringify(hiKeys)}`);
+
+// NEGATIVE CONTROL: the key-parity check above actually catches a real
+// mismatch, not just a coincidence of always agreeing.
+{
+  const mutated = en.replace("const EN_SOURCES_STUDIO: SourcesStudioCopy = {", "const EN_SOURCES_STUDIO: SourcesStudioCopy = {\n  ghostKeyNoHindiEquivalent: \"x\",");
+  const mutatedKeys = objectKeys(mutated, "EN_SOURCES_STUDIO");
+  ok("NEGATIVE CONTROL — a key present in EN alone is caught by the parity check",
+    JSON.stringify(mutatedKeys) !== JSON.stringify(hiKeys) && mutatedKeys.includes("ghostKeyNoHindiEquivalent"));
+}
+
+// ── 6. The Rooms vocabulary rule holds for every new string this workstream wrote ──
+// scripts/check-copy.mjs is the real gate; this is a fast, local restatement
+// over exactly the two blocks this workstream added, so a regression is
+// caught here before the full gate runs.
+const BANNED = /\b(clone|replica|model|fine-tune|fine-tuning|train|training|weights|embedding|LoRA|genome)\b/i;
+for (const [name, text] of [["EN_SOURCES_STUDIO", en.slice(en.indexOf("const EN_SOURCES_STUDIO"), en.indexOf("const EN_STUDIO_COPY"))],
+  ["HI_SOURCES_STUDIO", hi.slice(hi.indexOf("const HI_SOURCES_STUDIO"), hi.indexOf("export const HI_STUDIO_COPY"))]]) {
+  ok(`${name} names no banned Rooms-vocabulary word`, !BANNED.test(text));
+}
+
+console.log(`\n${checks} sources-studio checks passed`);
