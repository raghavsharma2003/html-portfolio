+/* TweakReply — WS-R184. Mobile-first (390px): the panel sits BELOW the
+ * reply it tweaks, in normal document flow (never an overlay stealing
+ * space from the thread above it). Desktop (768px+): beside it, in a
+ * two-column row. Tokens from design/tokens.css and studio.css's own
+ * palette (the SAME ones emotionos-studio.css already uses); the dial
+ * fields themselves are unstyled here on purpose — they render through
+ * `.emotionos-studio__dim`/`.emotionos-studio__segmented`, the EXACT
+ * classes `VibeDialFields` already carries, so tweaking this file can
+ * never accidentally diverge the two screens' dials in appearance. */
+@layer components {
+  .tweak-reply {
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-block, 24px);
+    margin-block-start: var(--space-item, 16px);
+    padding: var(--space-item, 16px);
+    border: 1px solid var(--line, rgba(28, 32, 26, 0.12));
+    border-radius: var(--radius-panel, 14px);
+    background: var(--panel-solid, #fffef9);
+    max-width: 720px;
+  }
+
+  .tweak-reply__head {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: var(--space-item, 16px);
+  }
+  .tweak-reply__head h3 {
+    margin: 0;
+    font-size: var(--text-body, 14px);
+    font-weight: 700;
+    color: var(--ink, #171915);
+  }
+  .tweak-reply__close {
+    background: none;
+    border: 1px solid var(--line, rgba(28, 32, 26, 0.12));
+    border-radius: var(--radius-pill, 999px);
+    min-height: 36px;
+    padding: 6px 14px;
+    font-size: var(--text-small, 12px);
+    color: var(--ink-soft, #52564e);
+    cursor: pointer;
+  }
+
+  .tweak-reply__dials {
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-block, 24px);
+  }
+
+  .tweak-reply__delta {
+    margin: 0;
+    font-size: var(--text-small, 12px);
+    color: var(--ink-soft, #52564e);
+  }
+  .tweak-reply__delta span { font-weight: 600; color: var(--ink, #171915); }
+
+  .tweak-reply__actions {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: var(--space-item, 16px);
+  }
+  .tweak-reply__actions button {
+    min-height: 44px;
+    padding: 10px 20px;
+    border-radius: var(--radius-pill, 999px);
+    border: 1px solid var(--forest, #17493b);
+    background: none;
+    color: var(--forest, #17493b);
+    font-weight: 600;
+    cursor: pointer;
+  }
+  .tweak-reply__actions button:first-child {
+    background: var(--forest, #17493b);
+    color: #fff;
+  }
+  .tweak-reply__actions button:disabled {
+    opacity: 0.5;
+    cursor: not-allowed;
+  }
+  .tweak-reply__actions [role="status"] {
+    color: var(--forest, #17493b);
+    font-size: var(--text-small, 12px);
+  }
+
+  .tweak-reply__error {
+    margin: 0;
+    color: var(--danger, #9d302d);
+    font-size: var(--text-small, 12px);
+  }
+
+  .tweak-reply__compare {
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-item, 16px);
+  }
+  .tweak-reply__compare-old,
+  .tweak-reply__compare-new {
+    display: flex;
+    flex-direction: column;
+    gap: var(--space-hair, 4px);
+    padding: var(--space-tight, 8px) var(--space-item, 16px);
+    border: 1px solid var(--line, rgba(28, 32, 26, 0.12));
+    border-radius: var(--radius-control, 10px);
+  }
+  .tweak-reply__compare-new {
+    border-color: var(--forest, #17493b);
+    background: var(--forest-soft, #e1eee7);
+  }
+  .tweak-reply__compare-old h4,
+  .tweak-reply__compare-new h4 {
+    margin: 0;
+    font-size: var(--text-micro, 11px);
+    text-transform: uppercase;
+    letter-spacing: 0.04em;
+    color: var(--ink-soft, #52564e);
+  }
+  .tweak-reply__compare-old p,
+  .tweak-reply__compare-new p {
+    margin: 0;
+    font-size: var(--text-body, 14px);
+    color: var(--ink, #171915);
+    white-space: pre-wrap;
+  }
+
+  @media (min-width: 768px) {
+    .tweak-reply__compare {
+      flex-direction: row;
+    }
+    .tweak-reply__compare-old,
+    .tweak-reply__compare-new {
+      flex: 1 1 0;
+    }
+  }
+}
