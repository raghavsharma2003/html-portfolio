+  // reading of their tweak).
+  const deltaWords = useMemo(() => {
+    const words: string[] = [];
+    for (const key of DIM_KEYS) {
+      if (dims[key] === baseline[key]) continue;
+      const direction = dims[key] > baseline[key] ? copy.deltaWords[key].up : copy.deltaWords[key].down;
+      words.push(direction);
+    }
+    return words;
+  }, [dims, baseline, copy]);
+
+  async function runReplay() {
+    if (replaying) return;
+    setReplaying(true);
+    setReplayError("");
+    try {
+      const result = await replayDialogueTurn(token, replicaId, turnId, dims);
+      setReplay(result);
+    } catch (error) {
+      if (error instanceof ReplicaApiError && (error.status === 401 || error.status === 403)) onAuthError(error);
+      else setReplayError(copy.errorReplayFailed);
+    } finally {
+      setReplaying(false);
+    }
+  }
+
+  async function keepThisVibe() {
+    if (keeping) return;
+    setKeeping(true);
+    setKeepError("");
+    setKeptFlash(false);
+    try {
+      await setReplicaVibe(token, replicaId, { ...dims, note: "" });
+      setBaseline(dims);
+      setKeptFlash(true);
+      window.setTimeout(() => setKeptFlash(false), 2500);
+    } catch (error) {
+      if (error instanceof ReplicaApiError && (error.status === 401 || error.status === 403)) onAuthError(error);
+      else setKeepError(copy.errorKeepFailed);
+    } finally {
+      setKeeping(false);
+    }
+  }
+
+  return (
+    <div className="tweak-reply" lang={locale} role="group" aria-label={copy.ariaLabel}>
+      <div className="tweak-reply__head">
+        <h3>{copy.heading}</h3>
+        <button type="button" className="tweak-reply__close" onClick={onClose}>{copy.closeLabel}</button>
+      </div>
+
+      {loading ? (
+        <p role="status">{copy.loading}</p>
+      ) : loadError ? (
+        <div role="alert" className="tweak-reply__error">
+          <p>{copy.loadFailed}</p>
+          <button type="button" onClick={() => setRevision((n) => n + 1)}>{copy.retry}</button>
+        </div>
+      ) : (
+        <>
+          <div className="tweak-reply__dials">
+            <VibeDialFields dims={dims} dimCopy={copy.dims} onChange={(key, value) => setDims((prev) => ({ ...prev, [key]: value }))} />
+          </div>
+
+          <p className="tweak-reply__delta" aria-live="polite">
+            <span>{copy.deltaLabel}: </span>
+            {deltaWords.length ? deltaWords.join(", ") : copy.deltaNone}
+          </p>
+
+          <div className="tweak-reply__actions">
+            <button type="button" disabled={replaying} onClick={() => void runReplay()}>
+              {replaying ? copy.replaying : copy.replay}
+            </button>
+            <button type="button" disabled={keeping} onClick={() => void keepThisVibe()}>
+              {keeping ? copy.keeping : copy.keepThisVibe}
+            </button>
+            {keptFlash && <span role="status">{copy.kept}</span>}
+          </div>
+          {replayError && <p role="alert" className="tweak-reply__error">{replayError}</p>}
+          {keepError && <p role="alert" className="tweak-reply__error">{keepError}</p>}
+
+          {replay && (
+            <div className="tweak-reply__compare">
+              <article className="tweak-reply__compare-old">
+                <h4>{copy.oldLabel}</h4>
+                <p>{oldReply}</p>
+              </article>
+              <article className="tweak-reply__compare-new">
+                <h4>{copy.newLabel}</h4>
+                <p>{replay.replayed_reply}</p>
+              </article>
+            </div>
+          )}
+        </>
+      )}
+    </div>
+  );
+}
