+// TweakReply.tsx — WS-R184, EmotionOS test-and-tweak.
+//
+// "In Meet, after any reply: 'Tweak this'": the five vibe dials open beside
+// the reply, the same turn replays through the real door with the new
+// vibe (never persisted, never remembered), old and new read side by
+// side, and 'Keep this vibe' saves through the existing vibe door." —
+// this workstream's own brief.
+//
+// The loop this exists for: read a reply, feel it is off, turn ONE dial,
+// hear the same moment again, keep the one you prefer. One screen, no
+// navigation, never touches the follower-facing Room or the voice.
+//
+// Reuses `EmotionOsStudio.tsx`'s own `VibeDialFields` component (the
+// brief's own law: "reuse its component, never a second dial") and
+// `replicaVibeApi.ts`'s existing read/set (the EmotionOS vibe door,
+// unchanged) — this screen adds exactly one new op, `replayDialogueTurn`
+// (`api/_replica-dialogue.js#replayOwnedDialogueTurn`, op "replay").
+import { useEffect, useMemo, useState } from "react";
+import { VibeDialFields, DIM_KEYS, type DimKey } from "./EmotionOsStudio";
+import { readReplicaVibe, setReplicaVibe, type ReplicaVibe, type VibeDim } from "./replicaVibeApi";
+import { replayDialogueTurn, type DialogueReplay } from "./dialogueApi";
+import { ReplicaApiError } from "./replicaApi";
+import { useStudioLocale } from "./localeContext";
+import "./tweak-reply.css";
+
+type Dims = Record<DimKey, VibeDim>;
+const NEUTRAL_DIMS: Dims = { warmth: 2, energy: 2, humour: 2, directness: 2, formality: 2 };
+
+function dimsFrom(vibe: ReplicaVibe | null): Dims {
+  if (!vibe) return { ...NEUTRAL_DIMS };
+  return { warmth: vibe.warmth, energy: vibe.energy, humour: vibe.humour, directness: vibe.directness, formality: vibe.formality };
+}
+
+export interface TweakReplyProps {
+  token: string;
+  replicaId: string;
+  /** The reply being tweaked. Only a PERSISTED turn (a real `session_id`)
+   *  can be replayed — the caller (`ExpertConversation.tsx`) mounts this
+   *  panel only for such a turn; see that file's own comment for why a
+   *  text-ready-only (apprentice) turn cannot offer this yet. */
+  turnId: string;
+  /** The reply text already on screen for this turn — read-only, shown as
+   *  "Before" once a replay comes back. Never sent back to the server:
+   *  the server already has its own copy, keyed by `turnId` alone. */
