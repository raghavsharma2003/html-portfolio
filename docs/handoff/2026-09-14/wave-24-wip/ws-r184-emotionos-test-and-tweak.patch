+  onAuthError: (cause: unknown) => void;
+  onClose: () => void;
+}
+
+export default function TweakReply({ token, replicaId, turnId, oldReply, onAuthError, onClose }: TweakReplyProps) {
+  const { locale, t } = useStudioLocale();
+  const copy = t.tweakReply;
+
+  const [loading, setLoading] = useState(true);
+  const [loadError, setLoadError] = useState(false);
+  const [baseline, setBaseline] = useState<Dims>(NEUTRAL_DIMS);
+  const [dims, setDims] = useState<Dims>(NEUTRAL_DIMS);
+  const [revision, setRevision] = useState(0);
+
+  useEffect(() => {
+    let alive = true;
+    setLoading(true);
+    setLoadError(false);
+    readReplicaVibe(token, replicaId)
+      .then((state) => {
+        if (!alive) return;
+        const next = dimsFrom(state.vibe);
+        setBaseline(next);
+        setDims(next);
+      })
+      .catch((error) => {
+        if (!alive) return;
+        if (error instanceof ReplicaApiError && (error.status === 401 || error.status === 403)) return onAuthError(error);
+        setLoadError(true);
+      })
+      .finally(() => { if (alive) setLoading(false); });
+    return () => { alive = false; };
+  }, [token, replicaId, revision, onAuthError]);
+
+  const [replaying, setReplaying] = useState(false);
+  const [replayError, setReplayError] = useState("");
+  const [replay, setReplay] = useState<DialogueReplay | null>(null);
+
+  const [keeping, setKeeping] = useState(false);
+  const [keepError, setKeepError] = useState("");
+  const [keptFlash, setKeptFlash] = useState(false);
+
+  // The delta stated in words: only the dials that actually changed from
+  // the vibe that produced the ORIGINAL reply, never a number
