+// evals/rehearsal/hi-checks.mjs — WS-R191 (wave twenty-four): the studio
+// walked on a phone in Hindi under 4G.
+//
+// Shared screen-check helpers `evals/rehearsal/personal.mjs`'s own Hindi
+// pass calls after every real screen the walk reaches, and one throttle
+// helper the same pass applies to its browser context. Every check here
+// runs against whatever is ACTUALLY rendered on the live page at that
+// moment — never a fixed fixture string list — because `personal.mjs`
+// mounts the real, signed-in personal studio app over a real HTTP fixture
+// server, not `studio-layout-fixture.html`'s own static harness. That
+// harness sets `window.__STUDIO_HI_STRINGS__` for `scripts/
+// check-layout.mjs#glyphAudit` to read; this walk has no such global (it
+// never imports `layoutFixture.tsx`), so `checkGlyphs` below extracts real
+// Devanagari strings straight off the live DOM and runs the identical
+// measurement method instead — the two probes measure the same thing by
+// the same method, restated for a live page rather than a fixed pair list,
+// with no import possible across the scripts/ <-> evals/ boundary (neither
+// file exports its internals for the other to reuse, and `scripts/
+// check-layout.mjs` is not in this workstream's named touch set).
+//
+// LAW 3 OF THIS WORKSTREAM'S BRIEF, ONE HELPER EACH:
+//   1. checkGlyphs           — no Latin fallback glyph inside a Devanagari
+//                               string (the layout gate's own probe method).
+//   2. checkTargetSizes      — every tappable target >=44x44 CSS px.
+//   3. checkNoHorizontalScroll — no horizontal scroll at 390px.
+//   4. checkNoStaleEnglish   — no English string on screen where the Hindi
+//                               table has a DIFFERENT one for the same
+//                               value (a real localization miss, never a
+//                               Tier-2 component `src/studio/copy.ts`'s own
+//                               header already names as not yet moved into
+//                               either table — those strings are absent
+//                               from both tables, so they cannot match this
+//                               check's own value-set difference and are
+//                               correctly never flagged).
+// checkKeyboardClearance (law 3's fifth clause, kept separate since it
+// needs an input/action pair rather than a screenshot) simulates the one
+// thing headless Chromium has no OS surface for: a software keyboard.
+// There is no `Emulation`-domain call that opens one, so the standard
+// test-double this file uses is the same one mobile-web test suites
+// generally reach for — shrink the viewport by a plausible keyboard height
+// while an input is focused, and assert the primary action's own bounding
+// box still fits inside what is left. `applyFast3GThrottle` restates
+// `scripts/check-performance.mjs#THROTTLE` (Fast 3G / CPU 4x, the same
+// Lighthouse-published preset that file's own header cites at length) as a
+// literal copy rather than an import — `scripts/` is outside this
+// workstream's named touch set, and `evals/` is not one of `scripts/
+// check-mirrors.mjs`'s own SCAN_DIRS, so a same-line `// mirror of` marker
+// here would document the duplication without being a gate-enforced one;
+// the citation is the discipline instead.
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import ts from "typescript";
+
+// Restated from scripts/check-performance.mjs#THROTTLE (Fast 3G / CPU 4x,
+// this repo's long-standing "bad Indian 4G day" preset) and
+// #GLYPH_PROBE_PX / #MIN_GLYPH_DIFF_PCT / #GLYPH_UNIFORM_PX in
+// scripts/check-layout.mjs — see this file's own header for why these are
+// literal copies, not imports.
+export const THROTTLE = {
+  latencyMs: 150,
+  downloadBps: (1.6 * 1024 * 1024) / 8, // 1.6 Mbps
+  uploadBps: (750 * 1024) / 8, // 750 Kbps
+  cpuRate: 4,
+};
+const GLYPH_PROBE_PX = 16;
+const MIN_GLYPH_DIFF_PCT = 10;
+const GLYPH_UNIFORM_PX = 0.25;
+const GLYPH_FONT_STACK = '"Noto Sans Devanagari"';
+// A real Android software keyboard commonly occupies roughly a third of a
+// 390x844 viewport's height; 300px is a deliberately generous (harder to
+// pass) stand-in rather than a measured figure from a real device, named
+// here rather than presented as more precise than it is.
+const KEYBOARD_HEIGHT_PX = 300;
+const MIN_TARGET_PX = 44;
+
+export async function applyFast3GThrottle(page) {
+  const cdp = await page.context().newCDPSession(page);
+  await cdp.send("Network.enable");
+  await cdp.send("Network.emulateNetworkConditions", {
+    offline: false,
+    latency: THROTTLE.latencyMs,
+    downloadThroughput: THROTTLE.downloadBps,
+    uploadThroughput: THROTTLE.uploadBps,
+  });
+  await cdp.send("Emulation.setCPUThrottlingRate", { rate: THROTTLE.cpuRate });
+  return cdp;
+}
+
+// ── checkGlyphs ─────────────────────────────────────────────────────────
+// In-page: gather every leaf element's own trimmed text that contains at
+// least three Devanagari codepoints (ऀ-ॿ, U+0900-U+097F — the same
+// MIN_DEVANAGARI_CHARS floor `scripts/check-layout.mjs#glyphAudit`'s own
+// comment explains: enough that a real tofu run still clears the width-diff
+// bar with margin, low enough to exclude numeral/placeholder strings), then
+// run the SAME two-signal test that file uses: a canvas width-diff against
+// a same-length run of tofu boxes (□, U+25A1), AND a uniformity test over
+// only BASE Devanagari letters (matras/signs excluded — they can measure
+// as zero or as their base's width and would make a real word look
+// uniform). A string is flagged only when `document.fonts.check` says the
+// font is missing OR both signals agree it looks like tofu — the identical
+// "positively confirmed uniform, never merely not-disproven" rule
+// `context/rejected.md#ws-r77-glyph-uniform-null-treated-as-not-disproven-
+// instead-of-not-confirmed` fixed for the very case (a two-base-letter,
+// one-matra word) this repo's own font already produces.
+export async function checkGlyphs(page, { ok, screenName, totals }) {
+  // `scripts/check-layout.mjs`'s own precedent (`await page.evaluate(() =>
+  // document.fonts.ready);` immediately before its own `glyphAudit` call):
+  // without this wait, `document.fonts.check()` reports false for a font
+  // that has not finished loading yet, even while the SAME font is already
+  // painting real, non-uniform glyphs on screen — the first real run of
+  // this walk's own probe flagged every single rendered Hindi string as
+  // "tofu" for exactly this reason, a bug in the probe's own timing, not a
+  // font or product regression (`context/rejected.md#ws-r191-glyph-probe-
+  // ran-before-document-fonts-ready-flagged-every-real-string`).
+  await page.evaluate(() => document.fonts.ready);
+  const result = await page.evaluate(({ px, minDiffPct, uniformPx, fontStack }) => {
+    const canvas = document.createElement("canvas");
+    const ctx = canvas.getContext("2d");
+    const MIN_DEVANAGARI_CHARS = 3;
+    const devanagariCount = (s) => (s.match(/[ऀ-ॿ]/g) || []).length;
+    const BASE_LETTER = /[ऄ-हक़-ॡॲ-ॿ]/;
+    const uniformWidths = (s, fontSpec) => {
+      ctx.font = fontSpec;
+      const widths = [...s].filter((ch) => BASE_LETTER.test(ch)).map((ch) => ctx.measureText(ch).width);
+      if (widths.length < MIN_DEVANAGARI_CHARS) return null;
+      return Math.max(...widths) - Math.min(...widths) < uniformPx;
+    };
+    const fontSpec = `${px}px ${fontStack}`;
+    ctx.font = fontSpec;
+    const ctlWidths = ["﷐", "﷑", "﷒"].map((ch) => ctx.measureText(ch).width);
+    const controlUniform = Math.max(...ctlWidths) - Math.min(...ctlWidths) < uniformPx;
+
+    const seen = new Set();
+    const flagged = [];
+    let testableN = 0;
+    for (const el of document.querySelectorAll("body *")) {
+      if (el.children.length > 0) continue;
+      const style = getComputedStyle(el);
+      if (style.visibility === "hidden" || style.display === "none" || Number(style.opacity) === 0) continue;
+      const text = (el.textContent || "").trim();
+      if (!text || seen.has(text) || devanagariCount(text) < MIN_DEVANAGARI_CHARS) continue;
+      seen.add(text);
+      testableN++;
+      const fontsCheck = document.fonts.check(fontSpec, text);
+      ctx.font = fontSpec;
+      const real = ctx.measureText(text).width;
+      const boxes = "□".repeat(text.length);
+      ctx.font = fontSpec;
+      const tofu = ctx.measureText(boxes).width;
+      const diffPct = tofu > 0 ? (Math.abs(real - tofu) / tofu) * 100 : 0;
+      const uniform = uniformWidths(text, fontSpec);
+      const isTofu = !fontsCheck || (diffPct <= minDiffPct && uniform === true);
+      if (isTofu) flagged.push({ text: text.slice(0, 60), diffPct: Math.round(diffPct * 10) / 10, uniform, fontsCheck });
+    }
+    return { controlUniform, testableN, flagged };
+  }, { px: GLYPH_PROBE_PX, minDiffPct: MIN_GLYPH_DIFF_PCT, uniformPx: GLYPH_UNIFORM_PX, fontStack: GLYPH_FONT_STACK });
+
+  ok(`hi ${screenName}: glyph probe's own control (three Unicode noncharacters measure uniform)`, result.controlUniform);
+  ok(`hi ${screenName}: no rendered Devanagari string measures as Latin-fallback tofu`, result.flagged.length === 0, JSON.stringify(result.flagged));
+  if (totals) { totals.glyphN = (totals.glyphN || 0) + result.testableN; totals.glyphFlagged = (totals.glyphFlagged || 0) + result.flagged.length; }
+  return result;
+}
+
+// ── checkTargetSizes ────────────────────────────────────────────────────
+// Every visible button/link/form control/`role=button`/focusable element on
+// the page, regardless of scroll position (a bounding-rect width/height
+// does not depend on where the element currently sits relative to the
+// viewport, only on whether it is laid out and displayed at all) — so a
+// target below the fold on this 390px walk is still checked. 43.5px
+// tolerance absorbs sub-pixel layout rounding without hiding a target that
+// is genuinely a a pixel or more short of 44.
+export async function checkTargetSizes(page, { ok, screenName }) {
+  const undersized = await page.evaluate((minPx) => {
+    // Checkbox/radio/file inputs are excluded from the raw scan and their
+    // own wrapping `<label>` (the real, standard "click anywhere in the
+    // label" tap target for a form control, `:has()` already used
+    // elsewhere in this repo's own real CSS, e.g. `auth-entry.css`'s own
+    // `.auth-brand:has(.auth-language-select)`) is checked in their place —
+    // a real run of this check without this distinction flagged a real
+    // repo's own 16x16 native checkbox and a visually-hidden 1x1 file input
+    // as "undersized targets," neither of which a person ever taps
+    // directly (context/rejected.md#ws-r191-target-size-check-measured-
+    // native-checkbox-and-file-inputs-instead-of-their-own-labels).
+    const SELECTOR = [
+      "button", "a[href]",
+      'input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]):not([type="file"])',
+      "select", "textarea", '[role="button"]', '[tabindex]:not([tabindex="-1"])',
+      'label:has(input[type="checkbox"])', 'label:has(input[type="radio"])', 'label:has(input[type="file"])',
+    ].join(", ");
+    const out = [];
+    for (const el of document.querySelectorAll(SELECTOR)) {
+      const style = getComputedStyle(el);
+      if (style.visibility === "hidden" || style.display === "none" || el.disabled) continue;
+      const rect = el.getBoundingClientRect();
+      if (rect.width === 0 && rect.height === 0) continue; // not laid out at all, not "a small target"
+      if (rect.width < minPx - 0.5 || rect.height < minPx - 0.5) {
+        out.push({
+          tag: el.tagName.toLowerCase(), cls: (el.className || "").toString().slice(0, 60),
+          text: (el.textContent || el.getAttribute("aria-label") || "").trim().slice(0, 40),
+          w: Math.round(rect.width), h: Math.round(rect.height),
+        });
+      }
+      if (out.length >= 20) break;
+    }
+    return out;
+  }, MIN_TARGET_PX);
+  ok(`hi ${screenName}: every tappable target is at least ${MIN_TARGET_PX}x${MIN_TARGET_PX} CSS px`, undersized.length === 0, JSON.stringify(undersized));
+  return undersized;
+}
+
+// ── checkNoHorizontalScroll ─────────────────────────────────────────────
+export async function checkNoHorizontalScroll(page, { ok, screenName }) {
+  const { scrollWidth, clientWidth } = await page.evaluate(() => ({
+    scrollWidth: document.documentElement.scrollWidth,
+    clientWidth: document.documentElement.clientWidth,
+  }));
+  ok(`hi ${screenName}: no horizontal scroll at 390px (scrollWidth<=clientWidth)`, scrollWidth <= clientWidth + 1, `scrollWidth=${scrollWidth} clientWidth=${clientWidth}`);
+  return { scrollWidth, clientWidth };
+}
+
+// ── buildHindiCopyIndex + checkNoStaleEnglish ──────────────────────────
+// Parses `src/studio/copy.ts` and `src/studio/hiCopy.ts` ONCE via
+// TypeScript's own AST (the technique `evals/lib/panel-copy.mjs` already
+// uses for `src/creatorStudio`'s tables, restated here for the personal
+// studio's own registry since WS-R159 — never imported, since that file's
+// own `sections` parameter is a closed list this check would have to keep
+// in sync with every screen it visits; a flat value-set comparison needs no
+// such list). Every string literal inside a `const EN_*` declaration in
+// copy.ts becomes one member of `enValues`; every string literal inside a
+// `const HI_*` declaration in hiCopy.ts becomes one member of `hiValues`.
+// `enOnly` (the set difference) is what actually gets checked against the
+// live page: a value present in the English table but ABSENT from the
+// Hindi table's own values can only be on screen, in Hindi mode, because
+// the Hindi translation for it was not shown — a real localization miss.
+// A value present in BOTH (a shared brand name, a number, a string that
+// happens to translate to itself) is correctly never flagged. A Tier-2
+// string neither table carries at all (`copy.ts`'s own header names the
+// components still Tier 2) is correctly never flagged either — it cannot
+// be in `enOnly` if it was never in `enValues` to begin with, which is
+// exactly the distinction law 3 draws ("no English string where the Hindi
+// table HAS one").
+function collectLiterals(filePath, prefix) {
+  const text = readFileSync(filePath, "utf8");
+  const source = ts.createSourceFile(filePath, text, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);
+  const values = new Set();
+  function visit(node) {
+    if (
+      ts.isVariableDeclaration(node) &&
+      ts.isIdentifier(node.name) &&
+      node.name.text.startsWith(prefix) &&
+      node.initializer
+    ) {
+      (function collect(n) {
+        if (ts.isStringLiteral(n) || ts.isNoSubstitutionTemplateLiteral(n)) {
+          const v = n.text.trim();
+          // >=4, not >=3: a real run flagged "You" (3 chars, `youLabel`/
+          // `caption.you` in copy.ts) on a screen ExpertConversation/
+          // MirrorCallStudio never mount, where it was a coincidental
+          // Tier-2 hardcoded literal wholly unrelated to either translated
+          // key — a false positive from value-set matching having no
+          // per-component scope, not a real stale-English regression
+          // (context/rejected.md#ws-r191-stale-english-check-flagged-a-
+          // coincidental-short-word-match). Four is enough headroom that
+          // "You" is excluded while every real translated phrase this
+          // table actually carries (overwhelmingly multi-word) still is.
+          if (v.length >= 4) values.add(v);
+        }
+        ts.forEachChild(n, collect);
+      })(node.initializer);
+    }
+    ts.forEachChild(node, visit);
+  }
+  visit(source);
+  return values;
+}
+
+export function buildHindiCopyIndex(root) {
+  const enValues = collectLiterals(join(root, "src/studio/copy.ts"), "EN_");
+  const hiValues = collectLiterals(join(root, "src/studio/hiCopy.ts"), "HI_");
+  const enOnly = [...enValues].filter((v) => !hiValues.has(v));
+  return { enValues, hiValues, enOnly };
+}
+
+// A language switch (`src/studio/LanguageSwitch.tsx`'s own real
+// `auth-language-select` <select>, `PersonalAuthGate.tsx`'s own duplicate of
+// the identical control at its own sign-in step, and the landing page's own
+// `[data-set-lang]` toggle buttons) is REQUIRED to show "English" as a
+// literal English word no matter which locale is active — that word names
+// the language you would switch TO, not a translation of anything. Found
+// necessary, not assumed: the first real run of this check flagged
+// "English" on every screen carrying that control, a false positive in the
+// check's own scope, never a real product bug
+// (`context/rejected.md#ws-r191-stale-english-check-flagged-its-own-
+// language-switch-control`).
+const LOCALE_INVARIANT_SELECTOR = "select, option, [data-set-lang]";
+
+export async function checkNoStaleEnglish(page, { ok, screenName, index }) {
+  const bodyText = await page.evaluate((excludeSelector) => {
+    const excluded = new Set(document.querySelectorAll(excludeSelector));
+    function isExcluded(el) {
+      for (let n = el; n; n = n.parentElement) if (excluded.has(n)) return true;
+      return false;
+    }
+    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+    let out = "";
+    let node = walker.nextNode();
+    while (node) {
+      const parent = node.parentElement;
+      if (parent && !isExcluded(parent)) {
+        const style = getComputedStyle(parent);
+        if (style.visibility !== "hidden" && style.display !== "none") out += `${node.textContent}\n`;
+      }
+      node = walker.nextNode();
+    }
+    return out;
+  }, LOCALE_INVARIANT_SELECTOR).catch(() => "");
+  const found = index.enOnly.filter((v) => bodyText.includes(v));
+  ok(`hi ${screenName}: no English string renders where the Hindi table has a different one for it`, found.length === 0, JSON.stringify(found.slice(0, 8)));
+  return found;
+}
+
+// ── checkScreen: the checks above, run together ─────────────────────────
+// `skip` (a Set of check names) exists for exactly one real, disclosed
+// reason: `site/vyakti.html`'s landing screen carries its OWN complete,
+// separate `#loc-en`/`#loc-hi` blocks (never `src/studio/copy.ts`), so a
+// value-set diff against that table cannot say anything true about the
+// landing screen, and `site/vyakti.html` sits outside this workstream's own
+// named touch set (`docs/gurukul/waves/wave-24/ws-r191...md`'s own Build
+// list), so a real target-size finding there has no file this workstream
+// may fix it in — see `context/rejected.md#ws-r191-landing-page-target-
+// size-and-stale-copy-checks-out-of-this-workstreams-touch-scope` for the
+// measured finding this deliberately does not silence, only relocate to
+// where a future workstream that DOES own `site/` can act on it.
+export async function checkScreen(page, { ok, screenName, index, totals, skip }) {
+  const skipSet = skip || new Set();
+  await checkGlyphs(page, { ok, screenName, totals });
+  if (!skipSet.has("targetSizes")) await checkTargetSizes(page, { ok, screenName });
+  await checkNoHorizontalScroll(page, { ok, screenName });
+  if (!skipSet.has("staleEnglish")) await checkNoStaleEnglish(page, { ok, screenName, index });
+}
+
+// ── checkKeyboardClearance ──────────────────────────────────────────────
+// See this file's own header for why a viewport shrink is the test-double
+// for a software keyboard. Restores the original viewport before returning
+// either way, so the walk's own subsequent steps see the real 390x844
+// viewport untouched.
+export async function checkKeyboardClearance(page, { ok, screenName, inputSelector, primaryActionSelector }) {
+  const before = page.viewportSize();
+  if (!before) return;
+  const input = page.locator(inputSelector).first();
+  if (!(await input.count())) return;
+  try {
+    await input.focus();
+    const reducedHeight = Math.max(200, before.height - KEYBOARD_HEIGHT_PX);
+    await page.setViewportSize({ width: before.width, height: reducedHeight });
+    await page.waitForTimeout(50);
+    const action = page.locator(primaryActionSelector).first();
+    // A real phone's own software keyboard does not FORBID scrolling — a
+    // page can still scroll a covered control into the visible area above
+    // it, and real browsers already auto-scroll a focused control into view
+    // for exactly this reason. "The keyboard never covers the primary
+    // action" therefore means "reachable by scrolling," not "already in
+    // view before any scroll" — the first real run of this check asserted
+    // the stricter, wrong claim and flagged both real sign-in screens, where
+    // the primary action was always reachable by the SAME scroll a real
+    // phone performs automatically (`context/rejected.md#ws-r191-keyboard-
+    // clearance-check-asserted-no-scroll-needed-instead-of-reachable`).
+    await action.scrollIntoViewIfNeeded().catch(() => {});
+    const visible = await action.isVisible().catch(() => false);
+    let withinView = false;
+    if (visible) {
+      const box = await action.boundingBox();
+      withinView = Boolean(box) && box.y >= 0 && box.y + box.height <= reducedHeight;
+    }
+    ok(`hi ${screenName}: the keyboard never covers the primary action after focus (reachable by scroll)`, visible && withinView, `visible=${visible} withinView=${withinView}`);
+  } finally {
+    await page.setViewportSize(before);
+  }
+}
