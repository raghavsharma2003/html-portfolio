FROM python:3.11.11-slim@sha256:a8e0a3090316aed0b11037aac613aef32fb1747dcc1dcb5c0f6c727a0113a07f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system --gid 10010 admission \
    && useradd --system --uid 10010 --gid admission --create-home admission
WORKDIR /srv/admission
COPY services/openvoice-converter/requirements.broker.txt ./requirements.txt
RUN python -m pip install --requirement requirements.txt
COPY services/openvoice-converter/broker.py ./broker.py
RUN chown -R admission:admission /srv/admission

USER 10010:10010
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3)"
CMD ["uvicorn", "broker:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
